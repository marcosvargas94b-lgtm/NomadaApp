@page "/admin/evaluaciones"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">EVALUACIONES</h2>
        </div>

        <!-- ================= PESTAÑAS (TABS) ================= -->
        <div class="segmented-control fade-in-up" style="margin-bottom: 25px; background: rgba(128,128,128,0.1);">
            <div class="segment @(tabActual == "Catalogo" ? "active" : "")" style="@(tabActual == "Catalogo" ? "background: #33b5e5; color: white; box-shadow: 0 4px 15px rgba(51,181,229,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabActual = "Catalogo")">CATÁLOGO</div>
            <div class="segment @(tabActual == "Atletas" ? "active" : "")" style="@(tabActual == "Atletas" ? "background: #33b5e5; color: white; box-shadow: 0 4px 15px rgba(51,181,229,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabActual = "Atletas")">ATLETAS</div>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #33b5e5;"></span></div>
        }
        else
        {
            <!-- ================= TABS CONTENT: CATÁLOGO ================= -->
            @if (tabActual == "Catalogo")
            {
                <div class="fade-in-up">
                    <div class="modern-row" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; border-left: 4px solid #33b5e5; background: var(--card-bg);">
                        <div style="display: flex; align-items: center; margin-bottom: 20px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#33b5e5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase;">CREAR EVALUACIÓN</h3>
                        </div>

                        <div class="input-group modern-input" style="margin-bottom: 15px;">
                            <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nombre de la Prueba</label>
                            <input type="text" @bind="nuevaEvNombre" placeholder="Ej. Max Push Ups, 5K Run..." class="search-input" style="font-weight: 800; background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); color: var(--text-main);" />
                        </div>

                        <div class="input-group modern-input" style="margin-bottom: 20px;">
                            <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">¿Cómo se mide?</label>
                            <select @bind="nuevaEvMedida" class="search-input" style="font-weight: 800; background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); color: var(--text-main); appearance: none;">
                                <option value="" style="color: black;">Seleccione...</option>
                                <option value="Tiempo (MM:SS)" style="color: black;">Tiempo (MM:SS)</option>
                                <option value="Repeticiones" style="color: black;">Repeticiones</option>
                                <option value="Libras (Lbs)" style="color: black;">Libras (Lbs)</option>
                                <option value="Kilos (Kgs)" style="color: black;">Kilos (Kgs)</option>
                                <option value="Distancia" style="color: black;">Distancia</option>
                                <option value="Calorías" style="color: black;">Calorías</option>
                                <option value="Metros" style="color: black;">Metros</option>
                            </select>
                        </div>

                        <button class="ink-btn glow-btn" style="background: #33b5e5; color: white; border: none; font-weight: 900; width: 100%; margin: 0; box-shadow: 0 4px 15px rgba(51,181,229,0.3);" @onclick="GuardarEvaluacionCatalogo" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner" style="border-top-color: white;"></span>
                            }
                            else
                            {

                                <span>AGREGAR AL CATÁLOGO</span>
                            }
                        </button>
                    </div>

                    <div style="display: flex; align-items: center; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                        <div style="width: 5px; height: 22px; background: #33b5e5; border-radius: 5px; margin-right: 12px;"></div>
                        <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Pruebas Guardadas</h3>
                    </div>

                    @if (catalogo.Any())
                    {
                        <div class="user-list">
                            @foreach (var ev in catalogo)
                            {
                                <div class="modern-row" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; margin-bottom: 12px; background: var(--card-bg); border: 1px solid rgba(128,128,128,0.15);">
                                    <div style="flex: 1; overflow: hidden;">
                                        <h4 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin: 0 0 5px 0;">@ev.Nombre</h4>
                                        <span style="background: rgba(51,181,229,0.1); color: #33b5e5; padding: 3px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(51,181,229,0.2);">@ev.TipoMedida</span>
                                    </div>
                                    <button class="icon-btn" style="background: rgba(255,68,68,0.05); border-color: rgba(255,68,68,0.3); color: #ff4444; padding: 10px; flex-shrink: 0;" @onclick="() => EliminarEvaluacionCatalogo(ev.Id)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.6;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin: 0;">Aún no has creado pruebas en el catálogo.</p>
                        </div>
                    }
                </div>
            }

            <!-- ================= TABS CONTENT: ATLETAS ================= -->
            @if (tabActual == "Atletas")
            {
                <div class="fade-in-up">
                    <div class="search-wrapper" style="margin-bottom: 25px;">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar atleta por nombre..." class="search-input" style="background: var(--card-bg); font-weight: 700; border-color: rgba(128,128,128,0.2);" />
                    </div>

                    @if (AtletasFiltrados.Any())
                    {
                        <div class="user-list">
                            @foreach (var atleta in AtletasFiltrados)
                            {
                                <div class="modern-row" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; margin-bottom: 12px; background: var(--card-bg); cursor: pointer; transition: transform 0.2s;" @onclick="() => AbrirModalAtleta(atleta)">
                                    <div class="user-avatar" style="width: 45px; height: 45px; font-size: 1.1rem; margin-right: 15px; background: linear-gradient(135deg, var(--text-muted), var(--text-main)); color: var(--card-bg); font-weight: 900;">
                                        @if (!string.IsNullOrEmpty(atleta.FotoPerfil))
                                        {
                                            <img src="@atleta.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {

                                            <span>@ObtenerIniciales(atleta.Nombre, atleta.ApellidoPaterno)</span>
                                        }
                                    </div>
                                    <div class="user-info" style="flex: 1; overflow: hidden;">
                                        <span class="user-name" style="font-size: 1.05rem; font-weight: 800; color: var(--text-main);">@atleta.Nombre @atleta.ApellidoPaterno</span>
                                        <span class="user-email" style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">Toca para ver sus marcas</span>
                                    </div>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 0;">
                            <p style="color: var(--text-muted); font-size: 1rem; font-weight: 700;">No se encontraron atletas.</p>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- ================= MODAL: MARCAS DEL ATLETA ================= -->
@if (mostrarModalAtleta && atletaActivo != null)
{
    <div class="modal-overlay glass-overlay" style="z-index: 2000;">
        <div class="fade-in-up login-card modal-content premium-modal" style="width: 100%; max-width: 600px; height: 90vh; border-radius: 25px 25px 0 0; padding: 0; display: flex; flex-direction: column; background: var(--card-bg);">

            <!-- HEADER DEL MODAL -->
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px dashed rgba(128,128,128,0.2); background: rgba(128,128,128,0.05); border-radius: 25px 25px 0 0;">
                <div style="flex: 1; overflow: hidden; padding-right: 15px;">
                    <h3 style="color: var(--text-main); font-size: 1.2rem; font-weight: 900; margin: 0 0 5px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@atletaActivo.Nombre @atletaActivo.ApellidoPaterno</h3>
                    <span style="color: #00C851; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">HISTORIAL DE MARCAS (PRs)</span>
                </div>
                <button style="background: rgba(128,128,128,0.1); border: none; color: var(--text-muted); padding: 8px; border-radius: 50%; cursor: pointer;" @onclick="CerrarModal">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- CONTENIDO SCROLLEABLE -->
            <div style="flex: 1; overflow-y: auto; padding: 20px;">

                @if (isModalLoading)
                {
                    <div style="display: flex; justify-content: center; padding: 40px;"><span class="spinner" style="border-top-color: #00C851;"></span></div>
                }
                else
                {
                    if (agregandoMarca)
                    {
                        <!-- FORMULARIO PARA AGREGAR MARCA -->
                        <div class="fade-in-up" style="background: rgba(128,128,128,0.05); padding: 20px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.1); margin-bottom: 20px;">
                            <h4 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin-top: 0; margin-bottom: 20px; text-transform: uppercase;">Registrar Nuevo Logro</h4>

                            <div class="input-group modern-input" style="margin-bottom: 15px;">
                                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Evaluación del Catálogo</label>
                                <select @bind="nuevaMarca.EvaluacionCatalogoId" class="search-input" style="font-weight: 800; background: var(--card-bg); border-color: rgba(128,128,128,0.2); color: var(--text-main); appearance: none;">
                                    <option value="0" style="color: black;">Seleccione...</option>
                                    @foreach (var ev in catalogo)
                                    {
                                        <option value="@ev.Id" style="color: black;">@ev.Nombre (@ev.TipoMedida)</option>
                                    }
                                </select>
                            </div>

                            @if (nuevaMarca.EvaluacionCatalogoId > 0)
                            {
                                <div class="input-group modern-input" style="margin-bottom: 15px;">
                                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Resultado Alcanzado</label>
                                    <input type="text" @bind="nuevaMarca.Resultado" placeholder="@PlaceholderDinamico" class="search-input" style="font-weight: 900; font-size: 1.1rem; background: var(--card-bg); border-color: #00C851; color: var(--text-main);" />
                                </div>

                                <div class="input-group modern-input" style="margin-bottom: 25px;">
                                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Fecha del Logro</label>
                                    <input type="date" @bind="nuevaMarca.FechaRegistro" class="search-input" style="font-weight: 800; background: var(--card-bg); border-color: rgba(128,128,128,0.2); color: var(--text-main);" />
                                </div>
                            }

                            <div style="display: flex; gap: 10px;">
                                <button class="ink-btn-outline" style="flex: 1; border-color: var(--text-muted); color: var(--text-main);" @onclick="() => agregandoMarca = false" disabled="@isProcessing">CANCELAR</button>
                                <button class="ink-btn glow-btn" style="flex: 1; background: #00C851; color: white; border: none;" @onclick="GuardarMarca" disabled="@(nuevaMarca.EvaluacionCatalogoId == 0 || isProcessing)">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner" style="border-top-color: white;"></span>
                                    }
                                    else
                                    {

                                        <span>GUARDAR</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="ink-btn-outline" style="border-style: dashed; border-color: #00C851; color: #00C851; width: 100%; margin-bottom: 25px; font-weight: 900;" @onclick="() => agregandoMarca = true">
                            + REGISTRAR NUEVA MARCA
                        </button>

                        @if (marcasAtletaAgrupadas.Any())
                        {
                            @foreach (var grupo in marcasAtletaAgrupadas)
                            {
                                var marcas = grupo.Value.OrderByDescending(m => m.FechaRegistro).ToList();
                                var mejorMarca = marcas.First();

                                <div class="modern-row" style="flex-direction: column; padding: 0; margin-bottom: 25px; background: var(--card-bg); border-left: 4px solid #33b5e5; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">

                                    <!-- ENCABEZADO DE LA PRUEBA (Ancho Completo) -->
                                    <div style="background: rgba(51, 181, 229, 0.05); padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed rgba(128,128,128,0.2); width: 100%;">
                                        <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase;">@grupo.Key</h3>
                                        <div style="background: #33b5e5; color: white; padding: 5px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 900; margin-left: 15px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(51,181,229,0.3);">
                                            @marcas.Count Registros
                                        </div>
                                    </div>

                                    <div style="padding: 10px 20px 20px 20px; width: 100%;">
                                        @foreach (var m in marcas)
                                        {
                                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(128,128,128,0.1); width: 100%;">

                                                <div style="display: flex; flex-direction: column; gap: 6px; flex: 1;">
                                                    <div style="display: flex; align-items: baseline; gap: 8px;">
                                                        <span class="font-digital" style="color: @(m.Id == mejorMarca.Id ? "#00C851" : "var(--text-main)"); font-size: 1.3rem; font-weight: 900; text-shadow: @(m.Id == mejorMarca.Id ? "0 0 10px rgba(0,200,81,0.2)" : "none"); line-height: 1;">
                                                            @m.Resultado
                                                        </span>
                                                        <span style="font-size: 0.8rem; color: var(--text-muted); font-family: 'Montserrat', sans-serif; font-weight: 800;">@m.TipoMedida</span>
                                                    </div>
                                                    <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700;">@m.FechaRegistro.ToString("dd MMM yyyy")</span>
                                                </div>

                                                <div style="display: flex; align-items: center; justify-content: flex-end; padding-left: 15px; flex-shrink: 0; gap: 10px;">
                                                    @if (m.RegistradoPorCoach)
                                                    {
                                                        <span style="background: rgba(51, 181, 229, 0.1); color: #33b5e5; padding: 5px 10px; border-radius: 6px; font-size: 0.65rem; font-weight: 900; border: 1px solid rgba(51, 181, 229, 0.3); display: flex; align-items: center; gap: 5px;">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> COACH
                                                        </span>
                                                    }

                                                    <button class="icon-btn" style="color: #ff4444; border-color: rgba(255,68,68,0.2); background: rgba(255,68,68,0.05); padding: 10px; border-radius: 50%;" @onclick="() => EliminarMarca(m.Id)">
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="text-align: center; padding: 40px 20px;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 8 12 12 14 14"></polyline></svg>
                                <p style="color: var(--text-muted); font-size: 0.9rem; font-weight: 700; margin: 0;">Este atleta aún no tiene marcas registradas.</p>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .font-digital {
        font-family: 'Orbitron', monospace;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }

    .tab-btn {
        flex: 1;
        padding: 12px 10px;
        background: rgba(128,128,128,0.05);
        border: 1px solid rgba(128,128,128,0.1);
        color: var(--text-muted);
        font-weight: 900;
        font-size: 0.85rem;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        letter-spacing: 1px;
    }

        .tab-btn.active {
            background: #33b5e5;
            color: white;
            border-color: #33b5e5;
            box-shadow: 0 4px 15px rgba(51,181,229,0.3);
        }
</style>

@code {
    private string gymCode = "NOMADA";
    private Guid currentCoachId;
    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool isModalLoading = false;

    private string tabActual = "Catalogo";

    // CATÁLOGO
    private List<EvaluacionCatalogoDto> catalogo = new();
    private string nuevaEvNombre = "";
    private string nuevaEvMedida = "";

    // ATLETAS
    private string textoBusqueda = "";
    private List<UsuarioAdminDto> atletas = new();
    private IEnumerable<UsuarioAdminDto> AtletasFiltrados => atletas
        .Where(a => string.IsNullOrWhiteSpace(textoBusqueda) ||
                    (a.Nombre + " " + a.ApellidoPaterno).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    // MODAL DEL ATLETA
    private bool mostrarModalAtleta = false;
    private UsuarioAdminDto? atletaActivo;

    // Diccionario para agrupar el historial del atleta activo
    private Dictionary<string, List<EvaluacionAtletaDto>> marcasAtletaAgrupadas = new();

    private bool agregandoMarca = false;
    private RegistrarMarcaAtletaRequest nuevaMarca = new();

    private string PlaceholderDinamico
    {
        get
        {
            var ev = catalogo.FirstOrDefault(c => c.Id == nuevaMarca.EvaluacionCatalogoId);
            if (ev == null) return "Resultado...";
            if (ev.TipoMedida.Contains("Tiempo")) return "Ej. 19:00, 5:30...";
            if (ev.TipoMedida.Contains("Repeticiones")) return "Ej. 50, 100...";
            if (ev.TipoMedida.Contains("Lbs")) return "Ej. 135 Lbs...";
            if (ev.TipoMedida.Contains("Kgs")) return "Ej. 100 Kgs...";
            if (ev.TipoMedida.Contains("Distancia")) return "Ej. 5000 Mts...";
            if (ev.TipoMedida.Contains("Calorías")) return "Ej. 50 Cals...";
            return "Ingresa el resultado...";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);
        Guid.TryParse(userIdStr, out currentCoachId);

        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        isPageLoading = true;
        try
        {
            catalogo = await Http.GetFromJsonAsync<List<EvaluacionCatalogoDto>>($"api/evaluaciones/{gymCode}/catalogo") ?? new();
            atletas = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    // ================================= CATÁLOGO =================================
    private async Task GuardarEvaluacionCatalogo()
    {
        if (string.IsNullOrWhiteSpace(nuevaEvNombre) || string.IsNullOrWhiteSpace(nuevaEvMedida)) return;

        isProcessing = true;
        try
        {
            var req = new CrearEvaluacionCatalogoRequest
            {
                GymCode = gymCode,
                Nombre = nuevaEvNombre,
                TipoMedida = nuevaEvMedida
            };

            var res = await Http.PostAsJsonAsync("api/evaluaciones/catalogo", req);
            if (res.IsSuccessStatusCode)
            {
                nuevaEvNombre = "";
                nuevaEvMedida = "";
                catalogo = await Http.GetFromJsonAsync<List<EvaluacionCatalogoDto>>($"api/evaluaciones/{gymCode}/catalogo") ?? new();
            }
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task EliminarEvaluacionCatalogo(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/evaluaciones/catalogo/{id}");
            if (res.IsSuccessStatusCode)
            {
                catalogo = await Http.GetFromJsonAsync<List<EvaluacionCatalogoDto>>($"api/evaluaciones/{gymCode}/catalogo") ?? new();
            }
        }
        catch { }
    }

    // ================================= ATLETAS Y MARCAS =================================
    private async Task AbrirModalAtleta(UsuarioAdminDto atleta)
    {
        atletaActivo = atleta;
        mostrarModalAtleta = true;
        agregandoMarca = false;
        isModalLoading = true;

        nuevaMarca = new RegistrarMarcaAtletaRequest
        {
            GymCode = gymCode,
            AtletaId = atleta.Id,
            FechaRegistro = DateTime.Today,
            EsCoach = true, // Al estar en AdminEvaluaciones, quien registra es un Coach
            RegistradoPorId = currentCoachId
        };

        await CargarMarcasAtleta();
    }

    private async Task CargarMarcasAtleta()
    {
        try
        {
            // CORRECCIÓN: Usar el endpoint de /historial
            var marcas = await Http.GetFromJsonAsync<List<EvaluacionAtletaDto>>($"api/evaluaciones/{gymCode}/atleta/{atletaActivo!.Id}/historial") ?? new();
            marcasAtletaAgrupadas = marcas.GroupBy(m => m.NombreEvaluacion).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch { }
        finally { isModalLoading = false; }
    }

    private void CerrarModal()
    {
        mostrarModalAtleta = false;
        atletaActivo = null;
    }

    private async Task GuardarMarca()
    {
        if (nuevaMarca.EvaluacionCatalogoId == 0 || string.IsNullOrWhiteSpace(nuevaMarca.Resultado)) return;

        isProcessing = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/evaluaciones/marca", nuevaMarca);
            if (res.IsSuccessStatusCode && atletaActivo != null)
            {
                agregandoMarca = false;
                await CargarMarcasAtleta();
            }
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task EliminarMarca(int id)
    {
        try
        {
            // Enviamos el ID del coach actual para validar permisos en el backend
            var res = await Http.DeleteAsync($"api/evaluaciones/marca/{id}/{currentCoachId}");
            if (res.IsSuccessStatusCode && atletaActivo != null)
            {
                await CargarMarcasAtleta();
            }
        }
        catch { }
    }

    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini;
    }


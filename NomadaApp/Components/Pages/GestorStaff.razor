@page "/admin/staff"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager
<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- TOP BAR PREMIUM -->
        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 20px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">STAFF Y ROLES</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px; border-top-color: var(--text-main);"></span>
            </div>
        }
        else
        {
            <div class="fade-in-up">
                <!-- Buscador en tiempo real tipo píldora -->
                <div class="search-wrapper" style="margin-bottom: 25px;">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar usuario o coach..." class="search-input" style="background: var(--card-bg); border-color: rgba(128,128,128,0.2); font-weight: 700;" />
                </div>

                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 22px; background: var(--text-main); border-radius: 5px; margin-right: 12px;"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; text-transform: uppercase; font-weight: 900; letter-spacing: 1.5px; margin: 0;">LISTA DE INTEGRANTES</h3>
                </div>

                <div class="user-list">
                    @if (UsuariosFiltrados.Any())
                    {
                        @foreach (var usuario in UsuariosFiltrados)
                        {
                            <div class="modern-row" style="flex-wrap: wrap; padding: 15px 20px; margin-bottom: 15px; border-left: 3px solid @(usuario.RolId == 2 ? "#00C851" : "transparent"); background: var(--card-bg);">
                                <div class="user-avatar" style="width: 45px; height: 45px; font-size: 1.1rem; margin-right: 15px; background: @(usuario.RolId == 2 ? "linear-gradient(135deg, #00C851, #007E33)" : "rgba(128,128,128,0.2)"); color: @(usuario.RolId == 2 ? "white" : "var(--text-muted)");">
                                    @(string.IsNullOrWhiteSpace(usuario.Nombre) ? "N" : usuario.Nombre.Substring(0, 1).ToUpper())@(string.IsNullOrWhiteSpace(usuario.ApellidoPaterno) ? "" : usuario.ApellidoPaterno.Substring(0, 1).ToUpper())
                                </div>

                                <div class="user-info">
                                    <span class="user-name" style="font-size: 1.05rem; font-weight: 800;">@usuario.Nombre @usuario.ApellidoPaterno</span>
                                    <span class="user-email" style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">@usuario.Correo</span>
                                </div>

                                <!-- Toggle Switch para Coach (Estilizado Premium) -->
                                <div style="display: flex; align-items: center; gap: 12px; margin-left: auto;">
                                    <span style="font-size: 0.8rem; font-weight: 900; letter-spacing: 1px; color: @(usuario.RolId == 2 ? "#00C851" : "var(--text-muted)")">COACH</span>
                                    <label class="switch">
                                        <input type="checkbox" checked="@(usuario.RolId == 2)" @onchange="@((ChangeEventArgs e) => ToggleRolCoach(usuario, (bool)e.Value))">
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <!-- Botón de Permisos (Solo aparece si es Coach) -->
                                @if (usuario.RolId == 2)
                                {
                                    <div style="width: 100%; margin-top: 15px; border-top: 1px dashed rgba(128,128,128,0.2); padding-top: 15px; display: flex; justify-content: flex-end;">
                                        <button class="ink-btn-outline" style="margin: 0; padding: 10px 20px; font-size: 0.8rem; width: auto; display: flex; align-items: center; gap: 8px; border-color: #00C851; color: #00C851;" @onclick="() => AbrirModalPermisos(usuario)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                            GESTIONAR PERMISOS
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 0; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.6;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <p style="color: var(--text-muted); font-size: 1rem; margin-top: 10px; font-weight: 700;">No se encontraron resultados.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL DE PERMISOS -->
@if (showModalPermisos && usuarioSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #00C851; font-size: 1.2rem; text-shadow: 0 0 10px rgba(0,200,81,0.2);">PERMISOS: @usuarioSeleccionado.Nombre.ToUpper()</h3>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px;">
                @foreach (var permiso in catalogoPermisos)
                {
                    bool tienePermiso = usuarioSeleccionado.PermisosIds.Contains(permiso.Id);

                    <label style="display: flex; align-items: center; gap: 12px; color: var(--text-main); font-weight: 800; font-size: 0.95rem; cursor: pointer; padding: 12px 15px; background: @(tienePermiso ? "rgba(0, 200, 81, 0.05)" : "rgba(128,128,128,0.05)"); border-radius: 12px; border: 1px solid @(tienePermiso ? "#00C851" : "rgba(128,128,128,0.2)"); transition: all 0.2s;">
                        <input type="checkbox" checked="@tienePermiso" @onchange="@((ChangeEventArgs e) => TogglePermiso(permiso.Id, (bool)e.Value))" style="width: 20px; height: 20px; accent-color: #00C851;" />
                        @permiso.Nombre
                    </label>
                }
            </div>

            <div class="modal-actions" style="margin-top: 20px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" disabled="@isSaving" @onclick="CerrarModal">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #00C851; color: white; border: none;" disabled="@isSaving" @onclick="GuardarPermisos">
                    @if (isSaving)
                    {
                        <span class="spinner" style="border-top-color: white;"></span>
                    }
                    else
                    {
                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Switch estilo iOS Premium adaptado a Nómada */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(128,128,128,0.2);
        transition: .3s;
        border: 1px solid rgba(128,128,128,0.1);
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 2px;
            bottom: 2px;
            background-color: var(--text-muted);
            transition: .3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

    input:checked + .slider {
        background-color: rgba(0,200,81,0.2);
        border-color: rgba(0,200,81,0.5);
    }

        input:checked + .slider:before {
            transform: translateX(22px);
            background-color: #00C851;
            box-shadow: 0 0 8px rgba(0,200,81,0.6);
        }

    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>

@code {
    private string gymCode = "NOMADA";

    private bool isPageLoading = true;
    private bool isSaving = false;
    private List<UsuarioAdminDto> usuarios = new();
    private List<PermisoDto> catalogoPermisos = new();

    private string textoBusqueda = "";

    // Propiedad computada para filtrar en tiempo real
    private IEnumerable<UsuarioAdminDto> UsuariosFiltrados => usuarios
        .Where(u => string.IsNullOrWhiteSpace(textoBusqueda) ||
                    (u.Nombre + " " + u.ApellidoPaterno).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    private bool showModalPermisos = false;
    private UsuarioAdminDto usuarioSeleccionado = null;

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");

        try
        {
            usuarios = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado") ?? new();
            catalogoPermisos = await Http.GetFromJsonAsync<List<PermisoDto>>("api/admin/permisos-catalogo") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    private async Task ToggleRolCoach(UsuarioAdminDto user, bool esCoach)
    {
        user.RolId = esCoach ? 2 : 3;
        if (!esCoach) user.PermisosIds.Clear();

        await GuardarCambiosRolYPermisos(user);
    }

    private void AbrirModalPermisos(UsuarioAdminDto user)
    {
        usuarioSeleccionado = user;
        showModalPermisos = true;
    }

    private void TogglePermiso(int permisoId, bool isChecked)
    {
        if (isChecked && !usuarioSeleccionado.PermisosIds.Contains(permisoId))
            usuarioSeleccionado.PermisosIds.Add(permisoId);
        else if (!isChecked)
            usuarioSeleccionado.PermisosIds.Remove(permisoId);
    }

    private async Task GuardarPermisos()
    {
        isSaving = true;
        await GuardarCambiosRolYPermisos(usuarioSeleccionado);
        isSaving = false;
        CerrarModal();
    }

    private void CerrarModal() => showModalPermisos = false;

    private async Task GuardarCambiosRolYPermisos(UsuarioAdminDto user)
    {
        var request = new AsignarRolPermisoRequest
        {
            UsuarioId = user.Id,
            RolId = user.RolId ?? 3,
            PermisosIds = user.PermisosIds
        };
        await Http.PutAsJsonAsync("api/admin/staff/roles", request);
    }
}
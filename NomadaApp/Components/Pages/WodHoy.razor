@page "/wod-hoy"
@using Nomada.Shared.Models
@using System.Net.Http.Json
@using Microsoft.Maui.Storage
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">CLASE DE HOY</h2>
        </div>

        <!-- ================= SELECTOR DE DÍA ================= -->
        <div class="modern-row fade-in-up" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; margin-bottom: 30px; background: var(--card-bg); border-color: rgba(128,128,128,0.2);">
            <button class="icon-btn" style="background: rgba(128,128,128,0.05); border: 1px solid rgba(128,128,128,0.2); color: var(--text-main); padding: 8px;" @onclick="() => CambiarDia(-1)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>

            <div style="text-align: center;">
                <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; display: block; letter-spacing: 1px;">@fechaSeleccionada.ToString("dddd")</span>
                <span style="color: var(--text-main); font-size: 1.2rem; font-weight: 900;">@fechaSeleccionada.ToString("dd MMM yyyy")</span>
            </div>

            <button class="icon-btn" style="background: rgba(128,128,128,0.05); border: 1px solid rgba(128,128,128,0.2); color: var(--text-main); padding: 8px;" @onclick="() => CambiarDia(1)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #33b5e5;"></span></div>
        }
        else if (!wodsDelDia.Any())
        {
            <div class="fade-in-up" style="text-align: center; padding: 50px 20px; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin: 0;">Aún no se ha publicado el WOD para este día.</p>
            </div>
        }
        else
        {
            @foreach (var wod in wodsDelDia)
            {
                <div class="modern-row fade-in-up" style="flex-direction: column; align-items: stretch; text-align: left; padding: 0; margin-bottom: 25px; overflow: hidden; border: 1px solid rgba(128,128,128,0.2); width: 100%; background: var(--card-bg); animation-delay: 0.1s;">

                    <!-- ENCABEZADO Y MARCA DE AGUA DEL COACH -->
                    <div style="background: rgba(51,181,229,0.05); padding: 20px; border-bottom: 1px solid rgba(128,128,128,0.1); border-left: 4px solid #33b5e5; width: 100%;">
                        <h3 style="color: var(--text-main); font-size: 1.4rem; font-weight: 900; margin: 0 0 5px 0;">@wod.Titulo</h3>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">By Coach @wod.NombreCoach</span>
                        </div>
                    </div>

                    <!-- CUERPO DEL WOD (SECCIONES) -->
                    <div style="padding: 20px; width: 100%;">
                        @foreach (var sec in wod.Secciones)
                        {
                            <div style="margin-bottom: 20px;">
                                @if (!string.IsNullOrEmpty(sec.Subtitulo))
                                {
                                    <h4 style="color: #33b5e5; font-size: 1rem; font-weight: 900; margin: 0 0 10px 0; text-transform: uppercase; border-left: 3px solid #33b5e5; padding-left: 8px;">@sec.Subtitulo</h4>
                                }
                                <div style="color: var(--text-main); font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; font-weight: 600; background: rgba(128,128,128,0.03); padding: 15px; border-radius: 8px; border: 1px solid rgba(128,128,128,0.05);">@sec.Contenido</div>
                            </div>
                        }
                    </div>

                    <!-- VIDEOS COLAPSABLES -->
                    @if (wod.Ejercicios.Any())
                    {
                        <div style="background-color: rgba(128,128,128,0.03); border-top: 1px dashed rgba(128,128,128,0.2); padding: 20px; width: 100%;">
                            <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 900; display: block; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px;">Movimientos de la Clase</span>

                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                @foreach (var ej in wod.Ejercicios)
                                {
                                    string keyVideo = $"{wod.Id}-{ej.Id}";
                                    bool estaExpandido = videosExpandidos.Contains(keyVideo);

                                    <div style="background: var(--card-bg); border-radius: 12px; border: 1px solid @(estaExpandido ? "#33b5e5" : "rgba(128,128,128,0.2)"); overflow: hidden; transition: all 0.3s ease; box-shadow: @(estaExpandido ? "0 4px 15px rgba(51,181,229,0.15)" : "none");">

                                        <!-- Barra clickeable (Acordeón) -->
                                        <div @onclick="() => ToggleVideo(keyVideo)" style="padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: @(estaExpandido ? "rgba(51, 181, 229, 0.05)" : "transparent");">
                                            <div style="display: flex; align-items: center; gap: 12px;">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="@(estaExpandido ? "#33b5e5" : "var(--text-muted)")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                                                <span style="color: var(--text-main); font-size: 0.95rem; font-weight: 800;">@ej.Nombre</span>
                                            </div>

                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(estaExpandido ? "180deg" : "0deg")); transition: transform 0.3s ease;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </div>

                                        <!-- Reproductor de Video -->
                                        @if (estaExpandido)
                                        {
                                            <div style="background-color: #000; border-top: 1px solid rgba(51, 181, 229, 0.2);">
                                                <video controls preload="metadata" style="width: 100%; max-height: 250px; display: block;" playsinline autoplay>
                                                    <source src="@ej.UrlVideo" type="video/mp4">
                                                    Tu navegador no soporta la reproducción de video.
                                                </video>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";

    private bool isPageLoading = true;
    private DateTime fechaSeleccionada = DateTime.Today;
    private List<WodGeneralDto> wodsDelDia = new();

    private HashSet<string> videosExpandidos = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarWods();
    }

    private async Task CambiarDia(int dias)
    {
        fechaSeleccionada = fechaSeleccionada.AddDays(dias);
        videosExpandidos.Clear();
        await CargarWods();
    }

    private async Task CargarWods()
    {
        isPageLoading = true;
        try
        {
            string fStr = fechaSeleccionada.ToString("yyyy-MM-dd");
            wodsDelDia = await Http.GetFromJsonAsync<List<WodGeneralDto>>($"api/wod/{gymCode}/dia/{fStr}") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    private void ToggleVideo(string key)
    {
        if (videosExpandidos.Contains(key))
        {
            videosExpandidos.Remove(key);
        }
        else
        {
            videosExpandidos.Clear();
            videosExpandidos.Add(key);
        }
    }
}
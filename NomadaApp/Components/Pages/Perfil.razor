@page "/perfil"
@using Nomada.Shared.Entities
@using Microsoft.Maui.Storage
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@using Nomada.Shared.Models
@inject HttpClient Http

<div class="app-container">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- TOP BAR -->
        <div style="display: flex; align-items: center; margin-bottom: 25px;">
            <h2 class="greeting-title" style="margin: 0; font-size: 1.6rem; text-shadow: 0 0 15px rgba(255,255,255,0.2);">MI PERFIL</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else
        {
            <!-- FOTO CIRCULAR DE PERFIL -->
            <div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 30px;">
                <label style="cursor: pointer; position: relative;">
                    <InputFile OnChange="@(e => PrevisualizarImagen(e, "perfil"))" accept="image/*" style="display: none;" />
                    
                    <div style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid #33b5e5; overflow: hidden; background-color: var(--card-bg); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(51, 181, 229, 0.3);">
                        @if (!string.IsNullOrEmpty(previewFotoPerfil))
                        {
                            <img src="@previewFotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <span style="font-size: 2.5rem; color: var(--text-muted);">📸</span>
                        }
                    </div>
                    
                    <div style="position: absolute; bottom: 0; right: 0; background: #33b5e5; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 3px solid #111;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                    </div>
                </label>
                <span style="color: var(--text-muted); font-size: 0.8rem; margin-top: 10px; font-weight: 700;">Toca para cambiar foto</span>
            </div>

            <!-- DATOS PERSONALES -->
            <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 20px;">
                <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0 0 15px 0; border-bottom: 1px dashed rgba(128,128,128,0.3); padding-bottom: 10px;">INFORMACIÓN PERSONAL</h3>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label>Nombre(s)</label>
                    <input type="text" @bind="usuario.Nombre" class="ink-input" />
                </div>
                <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                    <div class="input-group modern-input" style="flex: 1;">
                        <label>Apellido Paterno</label>
                        <input type="text" @bind="usuario.ApellidoPaterno" class="ink-input" />
                    </div>
                    <div class="input-group modern-input" style="flex: 1;">
                        <label>Apellido Materno</label>
                        <input type="text" @bind="usuario.ApellidoMaterno" class="ink-input" />
                    </div>
                </div>
                <div class="input-group modern-input">
                    <label>Fecha de Nacimiento</label>
                    <input type="date" @bind="usuario.FechaNacimiento" class="ink-input" />
                </div>
            </div>

            <!-- FÍSICO (MAPA DE CALOR) -->
            <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 20px; border-left: 4px solid #00C851;">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px;">
                    <h3 style="color: #00C851; font-size: 1.1rem; font-weight: 900; margin: 0;">ESTADÍSTICAS FÍSICAS</h3>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
                <span style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 15px; display: block; line-height: 1.4;">
                    * Datos opcionales, pero sumamente importantes para poder calcular con exactitud tu <b>Mapa de Calor Personal</b> por el impacto de tus entrenamientos.
                </span>

                <div style="display: flex; gap: 10px;">
                    <div class="input-group modern-input" style="flex: 1;">
                        <label>Peso (KG)</label>
                        <input type="number" step="0.1" @bind="usuario.Peso" class="ink-input" placeholder="Ej: 75.5" />
                    </div>
                    <div class="input-group modern-input" style="flex: 1;">
                        <label>Estatura (Metros)</label>
                        <input type="number" step="0.01" @bind="usuario.Estatura" class="ink-input" placeholder="Ej: 1.75" />
                    </div>
                </div>
            </div>

            <!-- PREFERENCIAS -->
            <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 20px;">
                <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0 0 15px 0; border-bottom: 1px dashed rgba(128,128,128,0.3); padding-bottom: 10px;">PREFERENCIAS (Opcional)</h3>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label>Frase que te define o motiva</label>
                    <input type="text" @bind="usuario.FrasePersonal" class="ink-input" placeholder="Ej: No pain, no gain" />
                </div>
                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label>Ejercicio Favorito (Ese que dominas)</label>
                    <input type="text" @bind="usuario.EjercicioFavorito" class="ink-input" placeholder="Ej: Snatch" />
                </div>
                <div class="input-group modern-input">
                    <label>Ejercicio Menos Favorito (Tu talón de Aquiles)</label>
                    <input type="text" @bind="usuario.EjercicioMenosFavorito" class="ink-input" placeholder="Ej: Burpees" />
                </div>
            </div>

            <!-- FOTOS DESTACADAS -->
            <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 20px;">
                <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0 0 5px 0;">GALERÍA DESTACADA</h3>
                <span style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 15px; display: block;">Sube tus 3 imagenes favoritas para compartir con los demás.</span>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                    <!-- Foto 1 -->
                    <label style="cursor: pointer;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d1"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: var(--card-bg); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(previewD1)) { <img src="@previewD1" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <span style="color: var(--text-muted); font-size: 1.5rem;">+</span> }
                        </div>
                    </label>

                    <!-- Foto 2 -->
                    <label style="cursor: pointer;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d2"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: var(--card-bg); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(previewD2)) { <img src="@previewD2" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <span style="color: var(--text-muted); font-size: 1.5rem;">+</span> }
                        </div>
                    </label>

                    <!-- Foto 3 -->
                    <label style="cursor: pointer;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d3"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: var(--card-bg); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(previewD3)) { <img src="@previewD3" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <span style="color: var(--text-muted); font-size: 1.5rem;">+</span> }
                        </div>
                    </label>
                </div>
            </div>

            <!-- SEGURIDAD (CONTRASEÑA) -->
            <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 30px; border-left: 4px solid #ffbb33;">
                <h3 style="color: #ffbb33; font-size: 1.1rem; font-weight: 900; margin: 0 0 15px 0;">SEGURIDAD</h3>
                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label>Contraseña Actual (Si deseas cambiarla)</label>
                    <input type="password" @bind="passwordActual" class="ink-input" />
                </div>
                <div class="input-group modern-input">
                    <label>Nueva Contraseña</label>
                    <input type="password" @bind="nuevaPassword" class="ink-input" />
                </div>
            </div>

            <!-- BOTÓN GUARDAR -->
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <span style="color: #ff4444; font-size: 0.85rem; font-weight: 800; display: block; text-align: center; margin-bottom: 15px;">@mensajeError</span>
            }

            <button class="ink-btn glow-btn" style="width: 100%; background: linear-gradient(135deg, #33b5e5, #00C851); font-size: 1.1rem; padding: 15px;" @onclick="GuardarPerfil" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner"></span> <span> ACTUALIZANDO...</span>
                }
                else
                {
                    <span>GUARDAR CAMBIOS</span>
                }
            </button>
        }
    </div>

    <!-- Menú de Navegación Inferior (Con Perfil activo) -->
    <nav class="bottom-nav">
        <a href="/inicio" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><span class="nav-text">Inicio</span></a>
        <a href="/acciones" class="nav-item"><img src="images/logo-nomada.png" alt="Nómada" class="nav-logo" /><span class="nav-text">Box</span></a>
        <a href="/comunidad" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="nav-text">Comunidad</span></a>
        <a href="/perfil" class="nav-item active"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="nav-text">Perfil</span></a>
    </nav>
</div>

@code {
    private string gymCode = "NOMADA";
    private Guid currentUserId;

    private bool isPageLoading = true;
    private bool isProcessing = false;
    private string mensajeError = "";

    // Objeto principal
    private Usuario usuario = new();

    // Controles de contraseña
    private string passwordActual = "";
    private string nuevaPassword = "";

    // Previews y Archivos Físicos
    private string previewFotoPerfil = "";
    private string previewD1 = "";
    private string previewD2 = "";
    private string previewD3 = "";

    private IBrowserFile? fileFotoPerfil;
    private IBrowserFile? fileD1;
    private IBrowserFile? fileD2;
    private IBrowserFile? fileD3;

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);

        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            await CargarPerfil();
        }
    }

    private async Task CargarPerfil()
    {
        try
        {
            usuario = await Http.GetFromJsonAsync<Usuario>($"api/perfil/{gymCode}/{currentUserId}") ?? new Usuario();
            
            // Llenamos los previews iniciales con lo que venga de la BD
            if (!string.IsNullOrEmpty(usuario.FotoPerfil)) previewFotoPerfil = usuario.FotoPerfil;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada1)) previewD1 = usuario.FotoDestacada1;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada2)) previewD2 = usuario.FotoDestacada2;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada3)) previewD3 = usuario.FotoDestacada3;
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    // Genera un preview local rápido para que el usuario vea la foto antes de subirla
    private async Task PrevisualizarImagen(InputFileChangeEventArgs e, string tipo)
    {
        var file = e.File;
        if (file == null) return;

        // Redimensionamos localmente para el preview (máximo 800px para no saturar memoria del cel)
        var format = "image/jpeg";
        var resizedImageFile = await file.RequestImageFileAsync(format, 800, 800);
        var buffer = new byte[resizedImageFile.Size];
        await resizedImageFile.OpenReadStream().ReadAsync(buffer);
        var base64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";

        if (tipo == "perfil") { previewFotoPerfil = base64; fileFotoPerfil = file; }
        else if (tipo == "d1") { previewD1 = base64; fileD1 = file; }
        else if (tipo == "d2") { previewD2 = base64; fileD2 = file; }
        else if (tipo == "d3") { previewD3 = base64; fileD3 = file; }
    }

    private async Task GuardarPerfil()
    {
        isProcessing = true;
        mensajeError = "";

        try
        {
            using var content = new MultipartFormDataContent();
            
            // Agregamos todos los textos
            content.Add(new StringContent(currentUserId.ToString()), "Id");
            content.Add(new StringContent(usuario.Nombre ?? ""), "Nombre");
            content.Add(new StringContent(usuario.ApellidoPaterno ?? ""), "ApellidoPaterno");
            content.Add(new StringContent(usuario.ApellidoMaterno ?? ""), "ApellidoMaterno");
            
            content.Add(new StringContent(usuario.FechaNacimiento.ToString("yyyy-MM-dd")), "FechaNacimiento");
                
            content.Add(new StringContent(usuario.FrasePersonal ?? ""), "FrasePersonal");
            content.Add(new StringContent(usuario.EjercicioFavorito ?? ""), "EjercicioFavorito");
            content.Add(new StringContent(usuario.EjercicioMenosFavorito ?? ""), "EjercicioMenosFavorito");
            
            if (usuario.Peso.HasValue) content.Add(new StringContent(usuario.Peso.Value.ToString()), "Peso");
            if (usuario.Estatura.HasValue) content.Add(new StringContent(usuario.Estatura.Value.ToString()), "Estatura");
            
            content.Add(new StringContent(passwordActual ?? ""), "PasswordActual");
            content.Add(new StringContent(nuevaPassword ?? ""), "NuevaPassword");

            // Agregamos las imágenes físicas solo si el usuario seleccionó una nueva
            long maxAllowedSize = 20 * 1024 * 1024; // 20 MB por foto

            if (fileFotoPerfil != null)
                content.Add(new StreamContent(fileFotoPerfil.OpenReadStream(maxAllowedSize)), "FotoPerfil", fileFotoPerfil.Name);
            if (fileD1 != null)
                content.Add(new StreamContent(fileD1.OpenReadStream(maxAllowedSize)), "FotoDestacada1", fileD1.Name);
            if (fileD2 != null)
                content.Add(new StreamContent(fileD2.OpenReadStream(maxAllowedSize)), "FotoDestacada2", fileD2.Name);
            if (fileD3 != null)
                content.Add(new StreamContent(fileD3.OpenReadStream(maxAllowedSize)), "FotoDestacada3", fileD3.Name);

            // Inyectamos GymCode en la ruta (Candado maestro)
            var response = await Http.PutAsync($"api/perfil/{gymCode}/actualizar", content);

            if (response.IsSuccessStatusCode)
            {
                // Limpiamos los campos de password
                passwordActual = "";
                nuevaPassword = "";
                fileFotoPerfil = null; fileD1 = null; fileD2 = null; fileD3 = null;
                
                // Mensaje visual de éxito temporal (opcional)
                mensajeError = "¡Perfil actualizado con éxito! ✅";
                await Task.Delay(3000);
                mensajeError = "";
            }
            else
            {
                mensajeError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al conectar con el servidor.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }
}
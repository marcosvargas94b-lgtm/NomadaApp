@page "/perfil"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= TOP BAR PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 20px; position: relative;">
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">MI PERFIL</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: var(--text-main);"></span></div>
        }
        else
        {
            <!-- FOTO CIRCULAR DE PERFIL -->
            <div class="fade-in-up" style="display: flex; flex-direction: column; align-items: center; margin-bottom: 35px;">
                <label style="cursor: pointer; position: relative;">
                    <InputFile OnChange="@(e => PrevisualizarImagen(e, "perfil"))" accept="image/*" style="display: none;" />
                    
                    <div style="width: 130px; height: 130px; border-radius: 50%; border: 4px solid var(--text-main); overflow: hidden; background-color: var(--card-bg); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 25px rgba(128, 128, 128, 0.2);">
                        @if (!string.IsNullOrEmpty(previewFotoPerfil))
                        {
                            <img src="@previewFotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        }
                    </div>
                    
                    <div style="position: absolute; bottom: 0; right: 0; background: var(--text-main); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 4px solid var(--card-bg); box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--card-bg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                    </div>
                </label>
                <span style="color: var(--text-muted); font-size: 0.8rem; margin-top: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Cambiar Foto</span>
            </div>

            <!-- DATOS PERSONALES -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; animation-delay: 0.1s; background: var(--card-bg);">
                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 20px; background: var(--text-main); border-radius: 5px; margin-right: 12px;"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">INFO PERSONAL</h3>
                </div>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nombre(s)</label>
                    <input type="text" @bind="usuario.Nombre" class="search-input" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div class="input-group modern-input" style="flex: 1;">
                        <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Ap. Paterno</label>
                        <input type="text" @bind="usuario.ApellidoPaterno" class="search-input" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                    </div>
                    <div class="input-group modern-input" style="flex: 1;">
                        <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Ap. Materno</label>
                        <input type="text" @bind="usuario.ApellidoMaterno" class="search-input" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                    </div>
                </div>
                <div class="input-group modern-input">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nacimiento</label>
                    <input type="date" @bind="usuario.FechaNacimiento" class="search-input" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
            </div>

            <!-- FÍSICO (MAPA DE CALOR) -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; border-left: 4px solid #00C851; animation-delay: 0.2s; background: var(--card-bg);">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                    <h3 style="color: #00C851; font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">METRÍCAS FÍSICAS</h3>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
                <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 600; margin-bottom: 20px; display: block; line-height: 1.4;">
                    * Datos opcionales, pero vitales para que la IA calcule con exactitud tu <b>Mapa de Calor de Recuperación</b>.
                </span>

                <div style="display: flex; gap: 15px;">
                    <div class="input-group modern-input" style="flex: 1;">
                        <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Peso (KG)</label>
                        <input type="number" step="0.1" @bind="usuario.Peso" class="search-input" placeholder="Ej: 75.5" style="font-weight: 900; font-size: 1.1rem; text-align: center; color: var(--text-main); border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05);" />
                    </div>
                    <div class="input-group modern-input" style="flex: 1;">
                        <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Estatura (M)</label>
                        <input type="number" step="0.01" @bind="usuario.Estatura" class="search-input" placeholder="Ej: 1.75" style="font-weight: 900; font-size: 1.1rem; text-align: center; color: var(--text-main); border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05);" />
                    </div>
                </div>
            </div>

            <!-- PREFERENCIAS -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; animation-delay: 0.3s; background: var(--card-bg);">
                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 20px; background: var(--text-main); border-radius: 5px; margin-right: 12px;"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">PREFERENCIAS</h3>
                </div>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Frase de Vida</label>
                    <input type="text" @bind="usuario.FrasePersonal" class="search-input" placeholder="Ej: No pain, no gain" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Ejercicio Favorito</label>
                    <input type="text" @bind="usuario.EjercicioFavorito" class="search-input" placeholder="Ej: Snatch" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
                <div class="input-group modern-input">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Tu Debilidad</label>
                    <input type="text" @bind="usuario.EjercicioMenosFavorito" class="search-input" placeholder="Ej: Burpees" style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
            </div>

            <!-- FOTOS DESTACADAS -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; animation-delay: 0.4s; background: var(--card-bg);">
                <div style="display: flex; align-items: center; margin-bottom: 5px;">
                    <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">GALERÍA DESTACADA</h3>
                </div>
                <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 600; margin-bottom: 20px; display: block;">Sube tus 3 mejores momentos en el Box.</span>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
                    <label style="cursor: pointer; transition: transform 0.2s;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d1"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: rgba(128,128,128,0.05); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border 0.3s;">
                            @if (!string.IsNullOrEmpty(previewD1)) { <img src="@previewD1" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> }
                        </div>
                    </label>

                    <label style="cursor: pointer; transition: transform 0.2s;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d2"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: rgba(128,128,128,0.05); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border 0.3s;">
                            @if (!string.IsNullOrEmpty(previewD2)) { <img src="@previewD2" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> }
                        </div>
                    </label>

                    <label style="cursor: pointer; transition: transform 0.2s;">
                        <InputFile OnChange="@(e => PrevisualizarImagen(e, "d3"))" accept="image/*" style="display: none;" />
                        <div style="aspect-ratio: 4/5; background: rgba(128,128,128,0.05); border: 2px dashed rgba(128,128,128,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border 0.3s;">
                            @if (!string.IsNullOrEmpty(previewD3)) { <img src="@previewD3" style="width: 100%; height: 100%; object-fit: cover;" /> }
                            else { <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> }
                        </div>
                    </label>
                </div>
            </div>

            <!-- ================= SEGURIDAD (CONTRASEÑA COLAPSABLE) ================= -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 0; margin-bottom: 35px; border-left: 4px solid var(--text-main); background: var(--card-bg); overflow: hidden; animation-delay: 0.5s;">
                
                <div @onclick="TogglePasswordSection" style="padding: 20px 25px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: @(mostrarCambiarPassword ? "rgba(128,128,128,0.05)" : "transparent"); border-bottom: @(mostrarCambiarPassword ? "1px solid rgba(128,128,128,0.2)" : "none");">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-main)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: 1px;">SEGURIDAD</h3>
                    </div>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(@(mostrarCambiarPassword ? "180deg" : "0deg")); transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>

                @if (mostrarCambiarPassword)
                {
                    <div class="fade-in-up" style="padding: 25px;">
                        <div class="input-group modern-input" style="margin-bottom: 20px;">
                            <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Contraseña Actual</label>
                            <input type="password" @bind="passwordActual" class="search-input" placeholder="Confirma tu identidad..." style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                        </div>
                        <div class="input-group modern-input" style="margin-bottom: 25px;">
                            <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nueva Contraseña</label>
                            <input type="password" @bind="nuevaPassword" @bind:event="oninput" class="search-input" placeholder="Crea una contraseña segura..." style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                            
                            <!-- Reglas de validación visuales -->
                            <div style="background: rgba(128,128,128,0.05); border-radius: 8px; padding: 12px; margin-top: 15px; border: 1px dashed rgba(128,128,128,0.2);">
                                <ul style="list-style: none; padding: 0; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin: 0; line-height: 1.6;">
                                    <li style="color: @(TieneLongitud ? "#00C851" : "var(--text-muted)")">
                                        @(TieneLongitud ? "✓" : "○") Mínimo 8 caracteres
                                    </li>
                                    <li style="color: @(TieneMayuscula ? "#00C851" : "var(--text-muted)")">
                                        @(TieneMayuscula ? "✓" : "○") Al menos una letra mayúscula
                                    </li>
                                    <li style="color: @(TieneNumero ? "#00C851" : "var(--text-muted)")">
                                        @(TieneNumero ? "✓" : "○") Al menos un número
                                    </li>
                                    <li style="color: @(TieneEspecial ? "#00C851" : "var(--text-muted)")">
                                        @(TieneEspecial ? "✓" : "○") Al menos un carácter especial (!#$%)
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="input-group modern-input">
                            <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Confirmar Contraseña</label>
                            <input type="password" @bind="confirmarPassword" @bind:event="oninput" class="search-input" placeholder="Repite para confirmar..." style="font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                            
                            @if (!string.IsNullOrEmpty(confirmarPassword))
                            {
                                <span class="fade-in-up" style="font-size: 0.75rem; color: @(Coinciden ? "#00C851" : "#ff4444"); margin-top: 8px; display: flex; align-items: center; gap: 5px; font-weight: 800;">
                                    @if(Coinciden) { <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> }
                                    else { <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> }
                                    @(Coinciden ? "Las contraseñas coinciden" : "Las contraseñas no coinciden")
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- ================= ALERTAS DE ERROR O ÉXITO ================= -->
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="fade-in-up" style="background: rgba(255,68,68,0.1); border: 1px solid rgba(255,68,68,0.3); padding: 15px; border-radius: 12px; margin-bottom: 20px; text-align: center; display: flex; justify-content: center; align-items: center; gap: 10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span style="color: #ff4444; font-size: 0.85rem; font-weight: 800;">@mensajeError</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <div class="fade-in-up" style="background: rgba(0,200,81,0.1); border: 1px solid rgba(0,200,81,0.3); padding: 15px; border-radius: 12px; margin-bottom: 20px; text-align: center; display: flex; justify-content: center; align-items: center; gap: 10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span style="color: #00C851; font-size: 0.85rem; font-weight: 800;">@mensajeExito</span>
                </div>
            }

            <!-- BOTÓN GUARDAR -->
            <div class="fade-in-up" style="animation-delay: 0.6s;">
                <button class="ink-btn glow-btn" style="width: 100%; background: var(--text-main); color: var(--card-bg); border: none; font-size: 1.1rem; font-weight: 900; padding: 18px;" @onclick="GuardarPerfil" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner" style="border-top-color: var(--card-bg);"></span> <span> GUARDANDO...</span>
                    }
                    else
                    {
                        <span>GUARDAR CAMBIOS</span>
                    }
                </button>
            </div>
        }
    </div>

    <!-- Menú de Navegación Inferior -->
    <nav class="bottom-nav">
        <a href="/inicio" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><span class="nav-text">Inicio</span></a>
        <a href="/acciones" class="nav-item"><img src="images/logo-nomada.png" alt="Nómada" class="nav-logo" /><span class="nav-text">Box</span></a>
        <a href="/comunidad" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="nav-text">Comunidad</span></a>
        <a href="/perfil" class="nav-item active"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="nav-text">Perfil</span></a>
    </nav>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');
    .font-modern { font-family: 'Montserrat', sans-serif; }
    .fade-in-up { animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both; }
    @@keyframes fadeInUp { 0% { opacity: 0; transform: translateY(20px); } 100% { opacity: 1; transform: translateY(0); } }

    .adaptive-shadow { text-shadow: 2px 2px 10px rgba(0,0,0,0.15); }
    @@media (prefers-color-scheme: dark) { .adaptive-shadow { text-shadow: 2px 2px 15px rgba(255,255,255,0.2); } }
</style>

@code {
    private string gymCode = "NOMADA";
    private Guid currentUserId;

    private bool isPageLoading = true;
    private bool isProcessing = false;
    private string mensajeError = "";
    private string mensajeExito = "";

    // Objeto principal
    private Usuario usuario = new();

    // Controles de contraseña
    private bool mostrarCambiarPassword = false;
    private string passwordActual = "";
    private string nuevaPassword = "";
    private string confirmarPassword = "";

    // Reglas Dinámicas de Contraseña
    private bool TieneLongitud => nuevaPassword.Length >= 8;
    private bool TieneMayuscula => nuevaPassword.Any(char.IsUpper);
    private bool TieneNumero => nuevaPassword.Any(char.IsDigit);
    private bool TieneEspecial => nuevaPassword.Any(ch => !char.IsLetterOrDigit(ch));
    private bool Coinciden => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword == confirmarPassword;
    private bool PasswordValida => TieneLongitud && TieneMayuscula && TieneNumero && TieneEspecial && Coinciden;

    // Previews
    private string previewFotoPerfil = "";
    private string previewD1 = "";
    private string previewD2 = "";
    private string previewD3 = "";

    private IBrowserFile? fileFotoPerfil;
    private IBrowserFile? fileD1;
    private IBrowserFile? fileD2;
    private IBrowserFile? fileD3;

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);

        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            await CargarPerfil();
        }
    }

    private async Task CargarPerfil()
    {
        try
        {
            usuario = await Http.GetFromJsonAsync<Usuario>($"api/perfil/{gymCode}/{currentUserId}") ?? new Usuario();
            
            if (!string.IsNullOrEmpty(usuario.FotoPerfil)) previewFotoPerfil = usuario.FotoPerfil;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada1)) previewD1 = usuario.FotoDestacada1;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada2)) previewD2 = usuario.FotoDestacada2;
            if (!string.IsNullOrEmpty(usuario.FotoDestacada3)) previewD3 = usuario.FotoDestacada3;
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    private void TogglePasswordSection()
    {
        mostrarCambiarPassword = !mostrarCambiarPassword;
        if (!mostrarCambiarPassword)
        {
            passwordActual = "";
            nuevaPassword = "";
            confirmarPassword = "";
            mensajeError = "";
        }
    }

    private async Task PrevisualizarImagen(InputFileChangeEventArgs e, string tipo)
    {
        var file = e.File;
        if (file == null) return;

        var format = "image/jpeg";
        var resizedImageFile = await file.RequestImageFileAsync(format, 800, 800);
        var buffer = new byte[resizedImageFile.Size];
        await resizedImageFile.OpenReadStream().ReadAsync(buffer);
        var base64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";

        if (tipo == "perfil") { previewFotoPerfil = base64; fileFotoPerfil = file; }
        else if (tipo == "d1") { previewD1 = base64; fileD1 = file; }
        else if (tipo == "d2") { previewD2 = base64; fileD2 = file; }
        else if (tipo == "d3") { previewD3 = base64; fileD3 = file; }
    }

    private async Task GuardarPerfil()
    {
        mensajeError = "";
        mensajeExito = "";

        if (mostrarCambiarPassword && (!string.IsNullOrEmpty(passwordActual) || !string.IsNullOrEmpty(nuevaPassword)))
        {
            if (string.IsNullOrEmpty(passwordActual)) { mensajeError = "Ingresa tu contraseña actual para autorizar el cambio."; return; }
            if (!PasswordValida) { mensajeError = "La nueva contraseña no cumple con todos los requisitos de seguridad."; return; }
        }

        isProcessing = true;

        try
        {
            using var content = new MultipartFormDataContent();
            
            content.Add(new StringContent(currentUserId.ToString()), "Id");
            content.Add(new StringContent(usuario.Nombre ?? ""), "Nombre");
            content.Add(new StringContent(usuario.ApellidoPaterno ?? ""), "ApellidoPaterno");
            content.Add(new StringContent(usuario.ApellidoMaterno ?? ""), "ApellidoMaterno");
            
            content.Add(new StringContent(usuario.FechaNacimiento.ToString("yyyy-MM-dd")), "FechaNacimiento");
                
            content.Add(new StringContent(usuario.FrasePersonal ?? ""), "FrasePersonal");
            content.Add(new StringContent(usuario.EjercicioFavorito ?? ""), "EjercicioFavorito");
            content.Add(new StringContent(usuario.EjercicioMenosFavorito ?? ""), "EjercicioMenosFavorito");
            
            if (usuario.Peso.HasValue) content.Add(new StringContent(usuario.Peso.Value.ToString()), "Peso");
            if (usuario.Estatura.HasValue) content.Add(new StringContent(usuario.Estatura.Value.ToString()), "Estatura");
            
            if (mostrarCambiarPassword && PasswordValida)
            {
                content.Add(new StringContent(passwordActual), "PasswordActual");
                content.Add(new StringContent(nuevaPassword), "NuevaPassword");
            }

            long maxAllowedSize = 20 * 1024 * 1024;

            if (fileFotoPerfil != null) content.Add(new StreamContent(fileFotoPerfil.OpenReadStream(maxAllowedSize)), "FotoPerfil", fileFotoPerfil.Name);
            if (fileD1 != null) content.Add(new StreamContent(fileD1.OpenReadStream(maxAllowedSize)), "FotoDestacada1", fileD1.Name);
            if (fileD2 != null) content.Add(new StreamContent(fileD2.OpenReadStream(maxAllowedSize)), "FotoDestacada2", fileD2.Name);
            if (fileD3 != null) content.Add(new StreamContent(fileD3.OpenReadStream(maxAllowedSize)), "FotoDestacada3", fileD3.Name);

            var response = await Http.PutAsync($"api/perfil/{gymCode}/actualizar", content);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Perfil actualizado con éxito!";
                
                passwordActual = ""; nuevaPassword = ""; confirmarPassword = "";
                mostrarCambiarPassword = false;
                
                fileFotoPerfil = null; fileD1 = null; fileD2 = null; fileD3 = null;
                
                StateHasChanged();
                await Task.Delay(4000);
                mensajeExito = "";
                StateHasChanged();
            }
            else
            {
                mensajeError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al conectar con el servidor.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }
}
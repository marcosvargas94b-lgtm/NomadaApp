@code {
    private string gymCode = "NOMADA";
    private Guid currentUserId;
    private bool esCoach = false;
    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool isModalLoading = false;

    private string tabActual = "MisMarcas";
    private bool mostrarMisPRs = false;

    // CATÁLOGO DE EVALUACIONES
    private List<EvaluacionCatalogoDto> catalogo = new();

    // MIS MARCAS
    private Dictionary<string, List<EvaluacionAtletaDto>> misMarcasAgrupadas = new();
    private bool mostrarModalAgregar = false;
    private RegistrarMarcaAtletaRequest requestMarca = new();

    // ESTADO PARA COLLAPSABLES (ACORDEONES)
    private HashSet<string> misPrsExpandidos = new();
    private HashSet<string> companeroPrsExpandidos = new();

    // COMUNIDAD
    private bool isCargandoTribu = false;
    private string textoBusquedaAtleta = "";
    private List<UsuarioAdminDto> atletasTribu = new();
    private IEnumerable<UsuarioAdminDto> AtletasTribuFiltrados => atletasTribu
        .Where(a => string.IsNullOrWhiteSpace(textoBusquedaAtleta) || (a.Nombre + " " + a.ApellidoPaterno).Contains(textoBusquedaAtleta, StringComparison.OrdinalIgnoreCase));

    // MODAL VER COMPAÑERO
    private bool mostrarModalCompanero = false;
    private UsuarioAdminDto? atletaSeleccionado;
    private Dictionary<string, List<EvaluacionAtletaDto>> marcasCompaneroAgrupadas = new();

    private string PlaceholderDinamico
    {
        get
        {
            var ev = catalogo.FirstOrDefault(c => c.Id == requestMarca.EvaluacionCatalogoId);
            if (ev == null) return "Resultado...";
            if (ev.TipoMedida.Contains("Tiempo")) return "Ej. 19:00, 5:30...";
            if (ev.TipoMedida.Contains("Repeticiones")) return "Ej. 50, 100...";
            if (ev.TipoMedida.Contains("Lbs")) return "Ej. 135 Lbs...";
            if (ev.TipoMedida.Contains("Kgs")) return "Ej. 100 Kgs...";
            if (ev.TipoMedida.Contains("Distancia")) return "Ej. 5000 Mts...";
            if (ev.TipoMedida.Contains("Calorías")) return "Ej. 50 Cals...";
            return "Ingresa el resultado...";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);

        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            int rolId = Preferences.Get("rolId", 3);
            esCoach = (rolId == 1 || rolId == 2);
            await CargarDatosIniciales();
        }
    }

    private async Task CargarDatosIniciales()
    {
        isPageLoading = true;
        try
        {
            catalogo = await Http.GetFromJsonAsync<List<EvaluacionCatalogoDto>>($"api/evaluaciones/{gymCode}/catalogo") ?? new();
            mostrarMisPRs = await Http.GetFromJsonAsync<bool>($"api/evaluaciones/{gymCode}/privacidad/{currentUserId}");
            await CargarMisMarcas();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    // ================================= MÓDULO: MIS MARCAS =================================
    private async Task CargarMisMarcas()
    {
        try
        {
            var misMarcas = await Http.GetFromJsonAsync<List<EvaluacionAtletaDto>>($"api/evaluaciones/{gymCode}/atleta/{currentUserId}/historial") ?? new();
            misMarcasAgrupadas = misMarcas.GroupBy(m => m.NombreEvaluacion).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch { }
    }

    private void ToggleMiPr(string key)
    {
        if (misPrsExpandidos.Contains(key)) misPrsExpandidos.Remove(key);
        else misPrsExpandidos.Add(key);
    }

    private async Task TogglePrivacidad(bool mostrar)
    {
        mostrarMisPRs = mostrar;
        try
        {
            await Http.PutAsJsonAsync($"api/evaluaciones/{gymCode}/privacidad/{currentUserId}", mostrar);
        }
        catch { }
    }

    private void AbrirModalAgregarPR()
    {
        requestMarca = new RegistrarMarcaAtletaRequest
        {
            GymCode = gymCode,
            AtletaId = currentUserId,
            FechaRegistro = DateTime.Today,
            EsCoach = false,
            RegistradoPorId = currentUserId
        };
        mostrarModalAgregar = true;
    }

    private async Task GuardarMiMarca()
    {
        isProcessing = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/evaluaciones/marca", requestMarca);
            if (res.IsSuccessStatusCode)
            {
                mostrarModalAgregar = false;
                await CargarMisMarcas();

                // Expandimos el grupo que acaba de actualizar
                var evEditada = catalogo.FirstOrDefault(c => c.Id == requestMarca.EvaluacionCatalogoId);
                if (evEditada != null && !misPrsExpandidos.Contains(evEditada.Nombre))
                {
                    misPrsExpandidos.Add(evEditada.Nombre);
                }
            }
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task EliminarMiMarca(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/evaluaciones/marca/{id}/{currentUserId}");
            if (res.IsSuccessStatusCode)
            {
                await CargarMisMarcas();
            }
            else
            {
                Console.WriteLine("No se puede borrar una marca registrada por el Coach.");
            }
        }
        catch { }
    }

    // ================================= MÓDULO: COMUNIDAD =================================
    private async Task CargarTribu()
    {
        tabActual = "Tribu";
        if (mostrarMisPRs || esCoach)
        {
            isCargandoTribu = true;
            try
            {
                atletasTribu = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/evaluaciones/{gymCode}/comunidad-prs/{currentUserId}") ?? new();
            }
            catch { }
            finally { isCargandoTribu = false; }
        }
    }

    private async Task VerPRsCompanero(UsuarioAdminDto atleta)
    {
        atletaSeleccionado = atleta;
        companeroPrsExpandidos.Clear(); // Inicia siempre colapsado
        mostrarModalCompanero = true;
        isModalLoading = true;
        try
        {
            var marcasComp = await Http.GetFromJsonAsync<List<EvaluacionAtletaDto>>($"api/evaluaciones/{gymCode}/atleta/{atleta.Id}/historial") ?? new();
            marcasCompaneroAgrupadas = marcasComp.GroupBy(m => m.NombreEvaluacion).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch { }
        finally { isModalLoading = false; }
    }

    private void ToggleCompaneroPr(string key)
    {
        if (companeroPrsExpandidos.Contains(key)) companeroPrsExpandidos.Remove(key);
        else companeroPrsExpandidos.Add(key);
    }

    // Helper
    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini;
    }

    // CLASES LOCALES DTO
    public class EvaluacionCatalogoDto { public int Id { get; set; } public string Nombre { get; set; } = ""; public string TipoMedida { get; set; } = ""; }
    public class EvaluacionAtletaDto { public int Id { get; set; } public int EvaluacionCatalogoId { get; set; } public string NombreEvaluacion { get; set; } = ""; public string TipoMedida { get; set; } = ""; public string Resultado { get; set; } = ""; public DateTime FechaRegistro { get; set; } public bool RegistradoPorCoach { get; set; } }
    public class RegistrarMarcaAtletaRequest { public string GymCode { get; set; } = ""; public Guid AtletaId { get; set; } public int EvaluacionCatalogoId { get; set; } public string Resultado { get; set; } = ""; public DateTime FechaRegistro { get; set; } public bool EsCoach { get; set; } public Guid RegistradoPorId { get; set; } }
}
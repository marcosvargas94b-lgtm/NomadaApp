<!-- Estilos para la Pizarra -->
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap');

    .chalk-font {
        font-family: 'Caveat', cursive;
    }

    .chalkboard {
        background-color: #2c3e2f; /* Verde oscuro clásico de pizarrón */
        background-image: radial-gradient(circle at center, rgba(255,255,255,0.05) 0%, transparent 100%), linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 100% 100%, 20px 20px, 20px 20px;
        border: 12px solid #5d4037; /* Marco de madera */
        border-radius: 8px;
        padding: 20px;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.8), /* Sombra interna para dar profundidad */
        0 10px 20px rgba(0,0,0,0.5); /* Sombra externa */
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private bool isPageLoading = true;
    private bool mostrarMenu = false;

    private bool esSuperAdmin = false;
    private List<string> misPermisos = new();
    private FraseDto? fraseDelDia;

    // AVISOS
    private List<AvisoBoxDto> avisosPizarron = new();
    private int indiceAvisoActual = 0;

    // Variables Código de Clase
    private string codigoIngresado = "";
    private bool isJoiningCode = false;
    private string mensajeCodigo = "";
    private bool codigoExitoso = false;

    private class RespuestaCodigo { public string mensaje { get; set; } = ""; }

    // Variables Mapa Calor
    private bool isMapaLoading = true;
    private string sexoUsuario = "M";
    private EstadoRecuperacionDto? dataRecuperacion;

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        int rolId = Preferences.Get("rolId", 3);
        esSuperAdmin = (rolId == 1);
        var userId = Preferences.Get("userId", string.Empty);

        try
        {
            if (!string.IsNullOrEmpty(userId))
            {
                misPermisos = await Http.GetFromJsonAsync<List<string>>($"api/admin/mis-permisos/{userId}") ?? new();

                // Disparamos la carga del Mapa de Calor en paralelo
                _ = CargarMapaCalor(userId);
            }

            var taskFrase = Http.GetFromJsonAsync<FraseDto>($"api/box/{gymCode}/frase-aleatoria");
            var taskAvisos = Http.GetFromJsonAsync<List<AvisoBoxDto>>($"api/avisos/{gymCode}/pizarron");

            await Task.WhenAll(taskFrase, taskAvisos);

            fraseDelDia = taskFrase.Result;
            avisosPizarron = taskAvisos.Result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task CargarMapaCalor(string userId)
    {
        try
        {
            // Una sola llamada rápida y segura
            dataRecuperacion = await Http.GetFromJsonAsync<EstadoRecuperacionDto>($"api/recuperacion/{gymCode}/{userId}");

            if (dataRecuperacion != null)
            {
                sexoUsuario = dataRecuperacion.Sexo;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando mapa: " + ex.Message);
        }
        finally
        {
            isMapaLoading = false;
            StateHasChanged();
        }
    }

    private async Task IngresarConCodigo()
    {
        if (string.IsNullOrWhiteSpace(codigoIngresado)) return;
        isJoiningCode = true;
        mensajeCodigo = "";

        try
        {
            var request = new { usuarioId = Guid.Parse(Preferences.Get("userId", "")), codigo = codigoIngresado.Trim().ToUpper() };
            var res = await Http.PostAsJsonAsync($"api/lobby/{gymCode}/unirse-codigo", request);

            if (res.IsSuccessStatusCode)
            {
                var respuesta = await res.Content.ReadFromJsonAsync<RespuestaCodigo>();

                codigoExitoso = true;
                mensajeCodigo = respuesta?.mensaje ?? "¡Estás dentro de la clase!";
                codigoIngresado = "";

                StateHasChanged(); // Forzamos que se pinte el recuadro verde
                await Task.Delay(5000); // Lo dejamos 5 segundos para que lo lea bien
                mensajeCodigo = "";
                StateHasChanged();
            }
            else
            {
                codigoExitoso = false;
                mensajeCodigo = await res.Content.ReadAsStringAsync();

                StateHasChanged();
                await Task.Delay(4000);
                mensajeCodigo = "";
                StateHasChanged();
            }
        }
        catch
        {
            codigoExitoso = false;
            mensajeCodigo = "Error de conexión. Intenta de nuevo.";
        }
        finally
        {
            isJoiningCode = false;
        }
    }

    private void ToggleMenu()
    {
        mostrarMenu = !mostrarMenu;
    }

    // Funciones del Carrusel de Avisos
    private void AvisoAnterior()
    {
        if (indiceAvisoActual > 0)
            indiceAvisoActual--;
        else
            indiceAvisoActual = avisosPizarron.Count - 1; // Carrusel circular
    }

    private void AvisoSiguiente()
    {
        if (indiceAvisoActual < avisosPizarron.Count - 1)
            indiceAvisoActual++;
        else
            indiceAvisoActual = 0; // Carrusel circular
    }
}
@page "/acciones"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject NavigationManager NavManager
@inject HttpClient Http

<div class="app-container">
    @if (isPageLoading)
    {
        <div style="height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <span class="spinner" style="width: 60px; height: 60px; border-width: 5px; border-top-color: var(--text-main);"></span>
            <p style="margin-top: 20px; color: var(--text-muted); font-weight: 800; letter-spacing: 2px;">CARGANDO EL BOX...</p>
        </div>
    }
    else
    {
        <div class="feed-content">

            <!-- ================= TOP BAR ================= -->
            <div class="top-bar" style="display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 25px;">
                <h1 class="greeting-title" style="margin: 0; font-size: 1.6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @gymCode
                </h1>

                <div class="admin-menu-container" style="position: relative; flex-shrink: 0;">
                    <button type="button" class="hamburger-btn" @onclick="ToggleMenu" @onclick:stopPropagation="true">
                        <span class="hamburger-icon">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="10" y1="18" x2="21" y2="18"></line></svg>
                        </span>
                    </button>

                    @if (mostrarMenu)
                    {
                        <div class="admin-dropdown glass-dropdown" style="top: 45px; right: 0; position: absolute; z-index: 2000; min-width: 220px;">

                            @if (esSuperAdmin)
                            {
                                <a href="/admin/finanzas" class="dropdown-item">
                                    <span class="dd-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
                                    </span>
                                    Historial de Ingresos
                                </a>
                            }
                            @if (esSuperAdmin || misPermisos.Contains("Gestionar Horarios"))
                            {
                                <a href="/admin/horarios" class="dropdown-item">
                                    <span class="dd-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    </span>
                                    Gestión de Horarios
                                </a>
                            }
                            @if (esSuperAdmin || misPermisos.Contains("Armar WOD"))
                            {
                                <a href="/admin/armar-clase" class="dropdown-item">
                                    <span class="dd-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                    </span>
                                    Armar Clase (WOD)
                                </a>
                            }
                            <!-- En Acciones.razor, dentro del menú admin-dropdown -->
                            @if (esSuperAdmin || misPermisos.Contains("Gestionar Evaluaciones"))
                            {
                                <a href="/admin/evaluaciones" class="dropdown-item">
                                    <span class="dd-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                    </span>
                                    Evaluaciones (PRs)
                                </a>
                            }

                            <!-- NUEVO PERMISO PARA CREAR AVISOS -->
                            @if (esSuperAdmin || misPermisos.Contains("Crear Avisos"))
                            {
                                <a href="/admin/avisos" class="dropdown-item">
                                    <span class="dd-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15h10M2 9h14M2 21h20M2 3h20"></path></svg>
                                    </span>
                                    Pizarrón de Avisos
                                </a>
                            }

                            <div class="divider" style="width: 80%; margin: 5px auto; background-color: rgba(128,128,128,0.2);"></div>

                            <a href="/mis-pagos" class="dropdown-item">
                                <span class="dd-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                </span>
                                Mi Historial de Pagos
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- ================= BANNER LOBBY (COACHES) ================= -->
            @if (esSuperAdmin || misPermisos.Contains("Armar WOD"))
            {
                <a href="/admin/lobby" class="modern-row fade-in-up" style="display: flex; align-items: center; justify-content: space-between; padding: 20px; text-decoration: none; background: linear-gradient(135deg, #ff4444, #cc0000); border-color: #ff4444; margin-bottom: 25px; box-shadow: 0 5px 15px rgba(255, 68, 68, 0.3);">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <div style="background: rgba(255,255,255,0.2); border-radius: 50%; padding: 10px;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                        <div>
                            <h3 style="color: #fff; font-size: 1.1rem; font-weight: 900; margin: 0 0 3px 0;">¡INICIA TU CLASE!</h3>
                            <span style="color: rgba(255,255,255,0.8); font-size: 0.8rem; font-weight: 700;">Abre el Lobby y pasa lista</span>
                        </div>
                    </div>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            }

            <!-- ================= INGRESAR CÓDIGO (ATLETAS) ================= -->
            <div class="modern-row fade-in-up" style="display: flex; align-items: center; justify-content: space-between; padding: 15px; margin-bottom: 15px; border-left: 4px solid #33b5e5;">
                <input type="text" @bind="codigoIngresado" placeholder="Código de clase (Ej. A2B4C)" class="search-input" style="flex: 1; margin: 0 10px 0 0; padding: 10px 15px; font-weight: 800; font-size: 0.9rem; text-transform: uppercase;" />
                <button class="ink-btn glow-btn" style="margin: 0; width: auto; padding: 10px 20px; font-size: 0.85rem; background: #33b5e5; color: white;" @onclick="IngresarConCodigo" disabled="@isJoiningCode">
                    @if (isJoiningCode)
                    {
                        <span class="spinner" style="width: 14px; height: 14px; border-width: 2px;"></span>
                    }
                    else
                    {
                        <span>ENTRAR</span>
                    }
                </button>
            </div>

            <!-- ALERTA DE CÓDIGO (Éxito o Error) -->
            @if (!string.IsNullOrEmpty(mensajeCodigo))
            {
                <div class="fade-in-up" style="background: @(codigoExitoso ? "rgba(0, 200, 81, 0.1)" : "rgba(255, 68, 68, 0.1)"); border: 1px solid @(codigoExitoso ? "rgba(0, 200, 81, 0.3)" : "rgba(255, 68, 68, 0.3)"); padding: 12px 15px; border-radius: 8px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px;">
                    @if (codigoExitoso)
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    }
                    <span style="color: @(codigoExitoso ? "#00C851" : "#ff4444"); font-size: 0.85rem; font-weight: 800; line-height: 1.4;">@mensajeCodigo</span>
                </div>
            }

            <!-- ================= BANNER: FRASE DEL DÍA ================= -->
            @if (fraseDelDia != null)
            {
                <div class="modern-row phrase-banner" style="flex-direction: column; align-items: center; justify-content: center; padding: 35px 20px; text-align: center; margin-bottom: 25px;">
                    <svg width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
                    <h3 class="fade-in-up" style="color: var(--text-main); font-size: 1.1rem; font-weight: 800; line-height: 1.5; margin-bottom: 15px; letter-spacing: 0.5px;">
                        "@fraseDelDia.Texto"
                    </h3>
                    <span class="fade-in-up" style="color: var(--text-muted); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; animation-delay: 0.2s;">
                        - @(string.IsNullOrWhiteSpace(fraseDelDia.Autor) ? "Nómada" : fraseDelDia.Autor) -
                    </span>
                </div>
            }

            <!-- ================= EL PIZARRÓN DE AVISOS (CHALKBOARD) ================= -->
            @if (avisosPizarron.Any())
            {
                var avisoActual = avisosPizarron[indiceAvisoActual];

                <div class="chalkboard fade-in-up" style="margin-bottom: 25px; position: relative;">
                    <!-- Cabecera del Pizarrón -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 2px dashed rgba(255,255,255,0.3); padding-bottom: 10px;">
                        <span class="chalk-font" style="font-size: 1.4rem; color: #ffeb3b; transform: rotate(-2deg); display: inline-block;">@avisoActual.Titulo</span>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8; transform: rotate(15deg);"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    </div>

                    <!-- Mensaje del Aviso -->
                    <div class="chalk-font" style="color: #ffffff; font-size: 1.1rem; line-height: 1.5; white-space: pre-wrap; min-height: 80px; margin-bottom: 15px;">
                        @avisoActual.Mensaje
                    </div>

                    <!-- Pie del Pizarrón y Controles -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                        <div style="display: flex; flex-direction: column;">
                            <span class="chalk-font" style="color: #ffaaaa; font-size: 0.9rem;">- Coach @avisoActual.NombreCoach</span>
                        </div>

                        <!-- Flechas de navegación (solo si hay más de 1 aviso) -->
                        @if (avisosPizarron.Count > 1)
                        {
                            <div style="display: flex; gap: 15px; align-items: center;">
                                <button style="background: none; border: none; color: #fff; cursor: pointer; opacity: 0.8;" @onclick="AvisoAnterior">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                </button>
                                <span class="chalk-font" style="color: #fff; font-size: 1.2rem;">@(indiceAvisoActual + 1)/@avisosPizarron.Count</span>
                                <button style="background: none; border: none; color: #fff; cursor: pointer; opacity: 0.8;" @onclick="AvisoSiguiente">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ================= TARJETAS DEL BOX ================= -->
            <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 15px;">

                <!-- TARJETA: MAPA DE CALOR -->
                <a href="/perfil/recuperacion" class="modern-row" style="flex-direction: column; align-items: center; justify-content: center; padding: 20px 15px; margin: 0; text-decoration: none; border-color: @(dataRecuperacion?.RequiereRPEHoy == true ? "#ffbb33" : "rgba(128,128,128,0.2)"); background: @(dataRecuperacion?.RequiereRPEHoy == true ? "rgba(255,187,51,0.05)" : "var(--card-bg)"); position: relative; overflow: hidden;">

                    @if (isMapaLoading)
                    {
                        <span class="spinner" style="width: 30px; height: 30px; border-width: 3px; margin: 30px 0;"></span>
                    }
                    else if (dataRecuperacion != null)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 10px; z-index: 10;">
                            <h3 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin: 0;">ESTADO FISIOLÓGICO</h3>
                            <span class="font-digital" style="color: @(dataRecuperacion.DisponibilidadGlobal > 80 ? "#00C851" : dataRecuperacion.DisponibilidadGlobal > 50 ? "#ffbb33" : "#ff4444"); font-weight: 900; font-size: 1.2rem;">
                                @dataRecuperacion.DisponibilidadGlobal%
                            </span>
                        </div>

                        <!-- EL COMPONENTE SVG -->
                        <div style="width: 100%; max-width: 250px; margin: 0 auto; z-index: 10;">
                            <MapaCalor Sexo="@sexoUsuario" Datos="@dataRecuperacion.Musculos" Parpadear="@dataRecuperacion.RequiereRPEHoy" />
                        </div>

                        @if (dataRecuperacion.RequiereRPEHoy)
                        {
                            <span class="fade-in-up" style="color: #ffbb33; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-top: 15px; letter-spacing: 1px; z-index: 10; display: flex; align-items: center; gap: 5px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                TOQUE PARA CALIFICAR SU ESFUERZO DE HOY
                            </span>
                        }
                        else
                        {
                            <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-top: 15px; z-index: 10;">
                                Toca para ver el análisis detallado
                            </span>
                        }
                    }
                </a>

                <!-- TARJETA: ENTRENAMIENTO PERSONALIZADO -->
                <a href="/perfil/mis-rutinas" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; text-decoration: none; border-color: #9b59b6; background: linear-gradient(145deg, rgba(155, 89, 182, 0.05), transparent); position: relative; overflow: hidden;">
                    <!-- Etiqueta PRO -->
                    <div style="position: absolute; top: 10px; right: 10px; background: #9b59b6; color: white; font-size: 0.6rem; font-weight: 900; padding: 3px 8px; border-radius: 4px; letter-spacing: 1px;">PRO</div>

                    <div style="background-color: rgba(155, 89, 182, 0.1); border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9b59b6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin-bottom: 5px; text-transform: uppercase;">Programación Personal</h3>
                    <span style="color: var(--text-muted); font-size: 0.8rem;">Accede a tu rutina específica</span>
                </a>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <!-- TARJETA: AGENDAR CLASE -->
                    <a href="/agendar" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; text-decoration: none; border-color: #33b5e5; background: linear-gradient(145deg, rgba(51, 181, 229, 0.05), transparent);">
                        <div style="background-color: rgba(51, 181, 229, 0.1); border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#33b5e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
                        </div>
                        <h3 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin-bottom: 5px;">AGENDAR CLASE</h3>
                        <span style="color: var(--text-muted); font-size: 0.75rem;">Reserva tu lugar</span>
                    </a>

                    <!-- TARJETA: CLASE DE HOY -->
                    <a href="/wod-hoy" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; text-decoration: none; border-color: #00C851; background: linear-gradient(145deg, rgba(0, 200, 81, 0.05), transparent);">
                        <div style="background-color: rgba(0, 200, 81, 0.1); border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12M6 20h12M4 9h16M4 15h16M6 4v16M18 4v16M9 9v6M15 9v6"></path></svg>
                        </div>
                        <h3 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin-bottom: 5px;">CLASE DE HOY</h3>
                        <span style="color: var(--text-muted); font-size: 0.75rem;">Consulta el WOD</span>
                    </a>
                </div>

                <!-- TARJETA: ENTRENAMIENTO PROVISIONAL / VIAJES -->
                <a href="/perfil/rutina-provisional" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; text-decoration: none; border-color: #00bcd4; background: linear-gradient(145deg, rgba(0, 188, 212, 0.05), transparent); position: relative; overflow: hidden;">
                    <div style="position: absolute; top: 10px; right: 10px; background: #00bcd4; color: black; font-size: 0.6rem; font-weight: 900; padding: 3px 8px; border-radius: 4px; letter-spacing: 1px;">COACH IA</div>

                    <div style="background-color: rgba(0, 188, 212, 0.1); border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00bcd4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </div>
                    <h3 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin-bottom: 5px; text-transform: uppercase;">¿No puedes asistir hoy?</h3>
                    <span style="color: var(--text-muted); font-size: 0.8rem;">Crea tu rutina provisional para casa o viaje</span>
                </a>

                <!-- TARJETA: MIS PAGOS -->
                <a href="/mis-pagos" class="modern-row" style="display: flex; align-items: center; padding: 20px; margin: 0; text-decoration: none; cursor: pointer; border-color: rgba(128,128,128,0.2);">
                    <div style="background-color: rgba(128,128,128,0.1); border-radius: 50%; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--text-main)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <div style="flex: 1;">
                        <h3 style="color: var(--text-main); font-size: 1rem; font-weight: 800; margin: 0 0 4px 0;">Mis Pagos y Recibos</h3>
                        <span style="color: var(--text-muted); font-size: 0.8rem;">Consulta tu historial de suscripciones.</span>
                    </div>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>

            </div>
        </div>
    }

    <!-- Menú de Navegación Inferior -->
    <nav class="bottom-nav">
        <a href="/inicio" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><span class="nav-text">Inicio</span></a>

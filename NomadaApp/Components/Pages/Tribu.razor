@page "/admin/tribu"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">TRIBU NÓMADA</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px; border-top-color: var(--text-main); margin: 0 0 20px 0;"></span>
                <p style="color: var(--text-muted); font-weight: 800; letter-spacing: 2px;">SINTONIZANDO...</p>
            </div>
        }
        else
        {
            <div class="admin-section fade-in-up">
                <!-- Buscador tipo píldora -->
                <div class="search-wrapper" style="margin-bottom: 20px;">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar atleta..." class="search-input" style="background: var(--card-bg); border-color: rgba(128,128,128,0.2); font-weight: 700;" />
                </div>

                <!-- Pestañas de Filtro -->
                <div class="segmented-control" style="margin-bottom: 25px; background: rgba(128,128,128,0.1);">
                    <div class="segment @(filtroActual == "Todos" ? "active" : "")" style="@(filtroActual == "Todos" ? "background: var(--text-main); color: var(--card-bg); box-shadow: 0 4px 15px rgba(0,0,0,0.2); border: none;" : "color: var(--text-muted);")" @onclick="@(() => filtroActual = "Todos")">TODOS</div>
                    <div class="segment @(filtroActual == "PorVencer" ? "active" : "")" style="@(filtroActual == "PorVencer" ? "background: #ffbb33; color: black; box-shadow: 0 4px 15px rgba(255,187,51,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => filtroActual = "PorVencer")">ALERTA</div>
                    <div class="segment @(filtroActual == "Vencidos" ? "active" : "")" style="@(filtroActual == "Vencidos" ? "background: #ff4444; color: white; box-shadow: 0 4px 15px rgba(255,68,68,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => filtroActual = "Vencidos")">VENCIDOS</div>
                </div>

                <div class="user-list">
                    @if (AtletasFiltrados.Any())
                    {
                        @foreach (var atleta in AtletasFiltrados)
                        {
                            <!-- Cada usuario es ahora una "Tarjeta Flotante" -->
                            <div class="user-row modern-row" style="padding: 15px; margin-bottom: 15px; border: 1px solid rgba(128,128,128,0.2); background: var(--card-bg); @(menuAbiertoId == atleta.Id ? "z-index: 50; box-shadow: 0 10px 30px rgba(0,0,0,0.15);" : "z-index: 1;")">

                                <div class="user-avatar" style="width: 45px; height: 45px; border-radius: 50%; font-size: 1.1rem; background: linear-gradient(135deg, var(--text-muted), var(--text-main)); color: var(--card-bg); display: flex; align-items: center; justify-content: center; font-weight: 900; margin-right: 15px;">
                                    @ObtenerIniciales(atleta.Nombre, atleta.ApellidoPaterno)
                                </div>

                                <div class="user-info" style="flex: 1; overflow: hidden;">
                                    <span class="user-name" style="font-size: 1rem; font-weight: 800; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-bottom: 4px;">@atleta.Nombre @atleta.ApellidoPaterno</span>

                                    @if (string.IsNullOrEmpty(atleta.TipoSuscripcion))
                                    {
                                        <span style="background: rgba(51, 181, 229, 0.1); color: #33b5e5; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(51, 181, 229, 0.3);">NUEVO - SIN REGISTRO</span>
                                    }
                                    else if (atleta.TipoSuscripcion == "PaqueteClases")
                                    {
                                        @if (atleta.ClasesRestantes <= 0)
                                        {
                                            <span style="background: rgba(255, 68, 68, 0.1); color: #ff4444; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(255, 68, 68, 0.3);">0 Clases - VENCIDO</span>
                                        }
                                        else if (atleta.ClasesRestantes <= 2)
                                        {
                                            <span style="background: rgba(255, 187, 51, 0.1); color: #ffbb33; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(255, 187, 51, 0.3);">@atleta.ClasesRestantes Clases restantes</span>
                                        }
                                        else
                                        {
                                            <span style="background: rgba(0, 200, 81, 0.1); color: #00C851; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(0, 200, 81, 0.3);">@atleta.ClasesRestantes Clases restantes</span>
                                        }
                                    }
                                    else
                                    {
                                        @if (atleta.DiasRestantes <= 0)
                                        {
                                            <span style="background: rgba(255, 68, 68, 0.1); color: #ff4444; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(255, 68, 68, 0.3);">Corte Vencido</span>
                                        }
                                        else if (atleta.DiasRestantes <= 5)
                                        {
                                            <span style="background: rgba(255, 187, 51, 0.1); color: #ffbb33; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(255, 187, 51, 0.3);">Quedan @atleta.DiasRestantes días</span>
                                        }
                                        else
                                        {
                                            <span style="background: rgba(0, 200, 81, 0.1); color: #00C851; padding: 4px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(0, 200, 81, 0.3);">Quedan @atleta.DiasRestantes días</span>
                                        }
                                    }
                                </div>

                                <button type="button" class="icon-btn" style="color: var(--text-muted); border-color: rgba(128,128,128,0.2); background: rgba(128,128,128,0.05); padding: 8px;" @onclick="() => ToggleMenu(atleta.Id)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1.5"></circle><circle cx="12" cy="5" r="1.5"></circle><circle cx="12" cy="19" r="1.5"></circle></svg>
                                </button>

                                @if (menuAbiertoId == atleta.Id)
                                {
                                    <div class="admin-dropdown glass-dropdown" style="background: var(--card-bg); border: 1px solid rgba(128,128,128,0.2); box-shadow: 0 10px 40px rgba(0,0,0,0.5);">
                                        @if (esSuperAdmin || misPermisos.Contains("Cobrar"))
                                        {
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalSuscripcion(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon" style="color: #33b5e5;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></span> Mensual / Semanal
                                            </button>
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalClases(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon" style="color: #ffbb33;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg></span> Pago por Clase(s)
                                            </button>
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalEspecial(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon" style="color: #ff4444;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span> Clase Especial
                                            </button>
                                        }

                                        @if (esSuperAdmin || misPermisos.Contains("Agregar Personalizados"))
                                        {
                                            <div style="border-top: 1px dashed rgba(128,128,128,0.2); margin: 5px 0;"></div>
                                            <button type="button" class="dropdown-item" @onclick='() => NavManager.NavigateTo($"/admin/personalizado/{atleta.Id}")' @onclick:stopPropagation="true">
                                                <span class="dd-icon" style="color: #9b59b6;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></span> Programación Pro
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 0; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.6;"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                            <p style="color: var(--text-muted); font-size: 1rem; margin-top: 10px; font-weight: 700;">No hay atletas con esos filtros.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: MENSUALIDAD Y SEMANAL -->
<!-- ========================================== -->
@if (showModalSuscripcion && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #33b5e5; font-size: 1.2rem; text-shadow: 0 0 10px rgba(51,181,229,0.3); margin-bottom: 25px;">COBRO: @atletaSeleccionado.Nombre.ToUpper()</h3>

            <div class="segmented-control" style="margin-bottom: 25px; background: rgba(128,128,128,0.1);">
                <div class="segment @(tabSuscripcion == "Mensual" ? "active" : "")" style="@(tabSuscripcion == "Mensual" ? "background: #33b5e5; color: white; box-shadow: 0 4px 15px rgba(51,181,229,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabSuscripcion = "Mensual")">MENSUAL</div>
                <div class="segment @(tabSuscripcion == "Semanal" ? "active" : "")" style="@(tabSuscripcion == "Semanal" ? "background: #33b5e5; color: white; box-shadow: 0 4px 15px rgba(51,181,229,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabSuscripcion = "Semanal")">SEMANAL</div>
            </div>

            @if (tabSuscripcion == "Mensual")
            {
                <div class="input-group modern-input" style="margin-bottom: 20px;">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Fecha de Pago</label>
                    <input type="date" @bind="fechaPago" class="search-input" style="font-weight: 800; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                    <small style="color: #00C851; font-weight: 700; margin-top: 8px; display: block;">Se sumará 1 mes a su fecha de corte.</small>
                </div>
            }
            else
            {
                <div class="input-group modern-input" style="margin-bottom: 20px;">
                    <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Número de Semanas</label>
                    <input type="number" min="1" @bind="numeroSemanas" class="search-input" placeholder="Ej: 2" style="font-weight: 800; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                </div>
            }

            <div class="input-group modern-input">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="search-input" placeholder="0.00" style="font-weight: 900; font-size: 1.5rem; color: #00C851; border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05);" />
            </div>

            <div class="modal-actions" style="margin-top: 25px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #33b5e5; color: white; border: none;" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner" style="border-top-color: white;"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL 2: PAQUETE DE CLASES -->
<!-- ========================================== -->
@if (showModalClases && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #ffbb33; font-size: 1.2rem; text-shadow: 0 0 10px rgba(255,187,51,0.3); margin-bottom: 25px;">PAGO: @atletaSeleccionado.Nombre.ToUpper()</h3>

            <div class="input-group modern-input" style="margin-bottom: 20px;">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Número de Clases</label>
                <input type="number" min="1" @bind="numeroClases" class="search-input" style="font-weight: 800; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                <small style="color: #ffbb33; font-weight: 700; margin-top: 8px; display: block;">Para Drop-in (visita), déjalo en 1.</small>
            </div>

            <div class="input-group modern-input">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="search-input" placeholder="0.00" style="font-weight: 900; font-size: 1.5rem; color: #00C851; border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05);" />
            </div>

            <div class="modal-actions" style="margin-top: 25px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #ffbb33; color: black; border: none;" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner" style="border-top-color: black;"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL 3: CLASE ESPECIAL -->
<!-- ========================================== -->
@if (showModalEspecial && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #ff4444; font-size: 1.2rem; text-shadow: 0 0 10px rgba(255,68,68,0.3); margin-bottom: 5px;">CLASE ESPECIAL</h3>
            <p class="modal-subtitle" style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 25px; font-weight: 600;">No afecta sus fechas de corte ni asistencias normales.</p>

            <div class="input-group modern-input" style="margin-bottom: 20px;">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Descripción del Evento</label>
                <input type="text" @bind="descripcionEspecial" class="search-input" placeholder="Ej: Clase OCR..." style="font-weight: 800; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
            </div>

            <div class="input-group modern-input">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="search-input" placeholder="0.00" style="font-weight: 900; font-size: 1.5rem; color: #00C851; border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05);" />
            </div>

            <div class="modal-actions" style="margin-top: 25px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #ff4444; color: white; border: none;" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner" style="border-top-color: white;"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private bool isPageLoading = true;
    private bool isSavingPayment = false;
    private List<UsuarioAdminDto> atletas = new();

    private string textoBusqueda = "";
    private string filtroActual = "Todos";

    private IEnumerable<UsuarioAdminDto> AtletasFiltrados => atletas
        .Where(a => string.IsNullOrWhiteSpace(textoBusqueda) ||
                    (a.Nombre + " " + a.ApellidoPaterno).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
        .Where(a =>
            filtroActual == "Todos" ||
            (filtroActual == "PorVencer" &&
                ((a.DiasRestantes.HasValue && a.DiasRestantes > 0 && a.DiasRestantes <= 5) ||
                 (a.ClasesRestantes.HasValue && a.ClasesRestantes > 0 && a.ClasesRestantes <= 2))) ||
            (filtroActual == "Vencidos" &&
                ((a.DiasRestantes.HasValue && a.DiasRestantes <= 0) ||
                 (a.ClasesRestantes.HasValue && a.ClasesRestantes <= 0)))
        );

    private Guid? menuAbiertoId = null;
    private bool showModalSuscripcion = false;
    private bool showModalClases = false;
    private bool showModalEspecial = false;
    private UsuarioAdminDto atletaSeleccionado = null;

    private string tabSuscripcion = "Mensual";
    private DateTime fechaPago = DateTime.Today;
    private int numeroSemanas = 1;
    private int numeroClases = 1;
    private decimal cobroTotal = 0;
    private string descripcionEspecial = "";

    private bool esSuperAdmin = false;
    private List<string> misPermisos = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarListas();

        int rolId = Preferences.Get("rolId", 3);
        esSuperAdmin = (rolId == 1);

        var userId = Preferences.Get("userId", string.Empty);
        if (!string.IsNullOrEmpty(userId))
        {
            misPermisos = await Http.GetFromJsonAsync<List<string>>($"api/admin/mis-permisos/{userId}") ?? new();
        }
    }

    private async Task CargarListas()
    {
        isPageLoading = true;
        try
        {
            atletas = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
        finally
        {
            isPageLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleMenu(Guid id)
    {
        if (menuAbiertoId == id) menuAbiertoId = null;
        else menuAbiertoId = id;
    }

    private void AbrirModalSuscripcion(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        tabSuscripcion = "Mensual";
        fechaPago = DateTime.Today;
        cobroTotal = 0;
        showModalSuscripcion = true;
    }

    private void AbrirModalClases(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        numeroClases = 1;
        cobroTotal = 0;
        showModalClases = true;
    }

    private void AbrirModalEspecial(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        descripcionEspecial = "";
        cobroTotal = 0;
        showModalEspecial = true;
    }

    private void CerrarModales()
    {
        showModalSuscripcion = false;
        showModalClases = false;
        showModalEspecial = false;
        atletaSeleccionado = null;
    }

    private async Task GuardarPago()
    {
        isSavingPayment = true;

        try
        {
            var coachIdStr = Preferences.Get("userId", string.Empty);
            Guid.TryParse(coachIdStr, out Guid coachId);

            string tipoCobro = "";
            if (showModalSuscripcion) tipoCobro = tabSuscripcion;
            else if (showModalClases) tipoCobro = "PaqueteClases";
            else if (showModalEspecial) tipoCobro = "Especial";

            var request = new RegistrarCobroRequest
            {
                GymCode = gymCode,
                AtletaId = atletaSeleccionado.Id,
                CoachId = coachId,
                TipoCobro = tipoCobro,
                Monto = cobroTotal,
                FechaPagoMensual = fechaPago,
                NumeroSemanas = numeroSemanas,
                NumeroClases = numeroClases,
                Descripcion = descripcionEspecial
            };

            var response = await Http.PostAsJsonAsync("api/admin/cobrar", request);

            if (response.IsSuccessStatusCode)
            {
                CerrarModales();
                await CargarListas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error de red: " + ex.Message);
        }
        finally
        {
            isSavingPayment = false;
        }
    }

    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini;
    }
}
@page "/admin/tribu"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container">
    <div class="feed-content" style="padding-top: 10px;">

        <!-- ENCABEZADO -->
        <div style="display: flex; align-items: center; margin-bottom: 25px;">
            <a href="/inicio" style="color: var(--text-main); margin-right: 15px; display: flex; align-items: center; transition: opacity 0.2s;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </a>
            <h2 class="greeting-title" style="margin: 0; font-size: 1.6rem; text-shadow: 0 0 15px rgba(255,255,255,0.2);">TRIBU NÓMADA</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px; border-top-color: var(--text-main); margin: 0 0 20px 0;"></span>
                <p style="color: var(--text-muted); font-weight: 800; letter-spacing: 2px;">SINTONIZANDO...</p>
            </div>
        }
        else
        {
            <div class="admin-section">
                <!-- Buscador tipo píldora -->
                <div class="search-wrapper">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar atleta..." class="search-input" />
                </div>

                <!-- Pestañas de Filtro (Estilo Segmented Control) -->
                <div class="segmented-control">
                    <div class="segment @(filtroActual == "Todos" ? "active" : "")" @onclick="@(() => filtroActual = "Todos")">TODOS</div>
                    <div class="segment @(filtroActual == "PorVencer" ? "active" : "")" @onclick="@(() => filtroActual = "PorVencer")">ALERTA</div>
                    <div class="segment @(filtroActual == "Vencidos" ? "active" : "")" @onclick="@(() => filtroActual = "Vencidos")">VENCIDOS</div>
                </div>

                <div class="user-list">
                    @if (AtletasFiltrados.Any())
                    {
                        @foreach (var atleta in AtletasFiltrados)
                        {
                            <!-- Cada usuario es ahora una "Tarjeta Flotante" (modern-row) -->
                            <!-- Modificamos la tarjeta para darle un z-index altísimo si su menú está abierto -->
                            <div class="user-row modern-row" style="@(menuAbiertoId == atleta.Id ? "z-index: 50;" : "z-index: 1;")">

                                <div class="user-avatar">@ObtenerIniciales(atleta.Nombre, atleta.ApellidoPaterno)</div>
                                <div class="user-info">
                                    <span class="user-name">@atleta.Nombre @atleta.ApellidoPaterno</span>

                                    @if (string.IsNullOrEmpty(atleta.TipoSuscripcion))
                                    {
                                        <span class="status-badge badge-new">NUEVO - SIN REGISTRO</span>
                                    }
                                    else if (atleta.TipoSuscripcion == "PaqueteClases")
                                    {
                                        @if (atleta.ClasesRestantes <= 0)
                                        {
                                            <span class="status-badge badge-danger">0 Clases - VENCIDO</span>
                                        }
                                        else if (atleta.ClasesRestantes <= 2)
                                        {

                                            <span class="status-badge badge-warn">@atleta.ClasesRestantes Clases restantes</span>
                                        }
                                        else
                                        {

                                            <span class="status-badge badge-ok">@atleta.ClasesRestantes Clases restantes</span>
                                        }
                                    }
                                    else
                                    {
                                        @if (atleta.DiasRestantes <= 0)
                                        {
                                            <span class="status-badge badge-danger">Corte Vencido</span>
                                        }
                                        else if (atleta.DiasRestantes <= 5)
                                        {

                                            <span class="status-badge badge-warn">Quedan @atleta.DiasRestantes días</span>
                                        }
                                        else
                                        {

                                            <span class="status-badge badge-ok">Quedan @atleta.DiasRestantes días</span>
                                        }
                                    }
                                </div>

                                <button type="button" class="action-btn menu-btn" @onclick="() => ToggleMenu(atleta.Id)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1.5"></circle><circle cx="12" cy="5" r="1.5"></circle><circle cx="12" cy="19" r="1.5"></circle></svg>
                                </button>

                                @if (menuAbiertoId == atleta.Id)
                                {
                                    <div class="admin-dropdown glass-dropdown">
                                        @if (esSuperAdmin || misPermisos.Contains("Cobrar"))
                                        {
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalSuscripcion(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon">📅</span> Mensual / Semanal
                                            </button>
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalClases(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon">🎟️</span> Pago por Clase(s)
                                            </button>
                                            <button type="button" class="dropdown-item" @onclick="() => AbrirModalEspecial(atleta)" @onclick:stopPropagation="true">
                                                <span class="dd-icon">🔥</span> Clase Especial
                                            </button>
                                        }

                                        @if (esSuperAdmin || misPermisos.Contains("Agregar Personalizados"))
                                        {
                                            <button type="button" class="dropdown-item" @onclick='() => NavManager.NavigateTo($"/admin/personalizado/{atleta.Id}")' @onclick:stopPropagation="true">
                                                <span class="dd-icon">📝</span> Rutina Personalizada
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 0;">
                            <span style="font-size: 3rem; opacity: 0.5;">🚷</span>
                            <p style="color: var(--text-muted); font-size: 1rem; margin-top: 15px; font-weight: 700;">No hay atletas con esos filtros.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: MENSUALIDAD Y SEMANAL -->
<!-- ========================================== -->
@if (showModalSuscripcion && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title">COBRO A @atletaSeleccionado.Nombre.ToUpper()</h3>

            <div class="segmented-control" style="margin-bottom: 25px;">
                <div class="segment @(tabSuscripcion == "Mensual" ? "active" : "")" @onclick="@(() => tabSuscripcion = "Mensual")">MENSUAL</div>
                <div class="segment @(tabSuscripcion == "Semanal" ? "active" : "")" @onclick="@(() => tabSuscripcion = "Semanal")">SEMANAL</div>
            </div>

            @if (tabSuscripcion == "Mensual")
            {
                <div class="input-group modern-input">
                    <label>Fecha de Pago</label>
                    <input type="date" @bind="fechaPago" class="ink-input" />
                    <small>Se sumará 1 mes a su fecha de corte.</small>
                </div>
            }
            else
            {
                <div class="input-group modern-input">
                    <label>Número de Semanas</label>
                    <input type="number" min="1" @bind="numeroSemanas" class="ink-input" placeholder="Ej: 2" />
                </div>
            }

            <div class="input-group modern-input">
                <label>Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="ink-input accent-input" placeholder="0.00" />
            </div>

            <div class="modal-actions">
                <button class="ink-btn-outline" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL 2: PAQUETE DE CLASES -->
<!-- ========================================== -->
@if (showModalClases && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title">PAGO POR CLASES - @atletaSeleccionado.Nombre.ToUpper()</h3>

            <div class="input-group modern-input">
                <label>Número de Clases</label>
                <input type="number" min="1" @bind="numeroClases" class="ink-input" />
                <small>Para Drop-in (visita), déjalo en 1.</small>
            </div>

            <div class="input-group modern-input">
                <label>Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="ink-input accent-input" placeholder="0.00" />
            </div>

            <div class="modal-actions">
                <button class="ink-btn-outline" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL 3: CLASE ESPECIAL -->
<!-- ========================================== -->
@if (showModalEspecial && atletaSeleccionado != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #ffbb33;">CLASE ESPECIAL</h3>
            <p class="modal-subtitle">No afecta sus fechas de corte ni asistencias normales.</p>

            <div class="input-group modern-input">
                <label>Descripción del Evento</label>
                <input type="text" @bind="descripcionEspecial" class="ink-input" placeholder="Ej: Clase OCR..." />
            </div>

            <div class="input-group modern-input">
                <label>Cobro Total ($)</label>
                <input type="number" min="0" step="0.01" @bind="cobroTotal" class="ink-input accent-input" placeholder="0.00" />
            </div>

            <div class="modal-actions">
                <button class="ink-btn-outline" disabled="@isSavingPayment" @onclick="CerrarModales">CANCELAR</button>
                <button class="ink-btn glow-btn" disabled="@isSavingPayment" @onclick="GuardarPago">
                    @if (isSavingPayment)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {

                        <span>GUARDAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string gymCode = "NOMADA"; // <--- VARIABLE PARA LA SUCURSAL

    private bool isPageLoading = true;
    private bool isSavingPayment = false; // <-- LOADER DEL BOTÓN
    private List<UsuarioAdminDto> atletas = new();

    private string textoBusqueda = "";
    private string filtroActual = "Todos";

    private IEnumerable<UsuarioAdminDto> AtletasFiltrados => atletas
        .Where(a => string.IsNullOrWhiteSpace(textoBusqueda) ||
                    (a.Nombre + " " + a.ApellidoPaterno).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
        .Where(a =>
            filtroActual == "Todos" ||
            (filtroActual == "PorVencer" &&
                ((a.DiasRestantes.HasValue && a.DiasRestantes > 0 && a.DiasRestantes <= 5) ||
                 (a.ClasesRestantes.HasValue && a.ClasesRestantes > 0 && a.ClasesRestantes <= 2))) ||
            (filtroActual == "Vencidos" &&
                ((a.DiasRestantes.HasValue && a.DiasRestantes <= 0) ||
                 (a.ClasesRestantes.HasValue && a.ClasesRestantes <= 0)))
        );

    private Guid? menuAbiertoId = null;
    private bool showModalSuscripcion = false;
    private bool showModalClases = false;
    private bool showModalEspecial = false;
    private UsuarioAdminDto atletaSeleccionado = null;

    private string tabSuscripcion = "Mensual";
    private DateTime fechaPago = DateTime.Today;
    private int numeroSemanas = 1;
    private int numeroClases = 1;
    private decimal cobroTotal = 0;
    private string descripcionEspecial = "";

    private bool esSuperAdmin = false;
    private List<string> misPermisos = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA"); // <--- CARGAMOS LA SUCURSAL

        await CargarListas();

        int rolId = Preferences.Get("rolId", 3);
        esSuperAdmin = (rolId == 1);

        var userId = Preferences.Get("userId", string.Empty);
        if (!string.IsNullOrEmpty(userId))
        {
            misPermisos = await Http.GetFromJsonAsync<List<string>>($"api/admin/mis-permisos/{userId}") ?? new();
        }
    }

    private async Task CargarListas()
    {
        isPageLoading = true;
        try
        {
            // INYECTAMOS EL GYM CODE EN LA CONSULTA
            atletas = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
        finally
        {
            isPageLoading = false;
            StateHasChanged(); // Forzamos a repintar la UI
        }
    }

    private void ToggleMenu(Guid id)
    {
        if (menuAbiertoId == id) menuAbiertoId = null;
        else menuAbiertoId = id;
    }

    private void AbrirModalSuscripcion(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        tabSuscripcion = "Mensual";
        fechaPago = DateTime.Today;
        cobroTotal = 0;
        showModalSuscripcion = true;
    }

    private void AbrirModalClases(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        numeroClases = 1;
        cobroTotal = 0;
        showModalClases = true;
    }

    private void AbrirModalEspecial(UsuarioAdminDto atleta)
    {
        menuAbiertoId = null;
        atletaSeleccionado = atleta;
        descripcionEspecial = "";
        cobroTotal = 0;
        showModalEspecial = true;
    }

    private void CerrarModales()
    {
        showModalSuscripcion = false;
        showModalClases = false;
        showModalEspecial = false;
        atletaSeleccionado = null;
    }

    private async Task GuardarPago()
    {
        isSavingPayment = true;

        try
        {
            // Identificamos quién es el coach que está cobrando
            var coachIdStr = Preferences.Get("userId", string.Empty);
            Guid.TryParse(coachIdStr, out Guid coachId);

            // Determinamos el tipo de cobro según el modal abierto
            string tipoCobro = "";
            if (showModalSuscripcion) tipoCobro = tabSuscripcion; // "Mensual" o "Semanal"
            else if (showModalClases) tipoCobro = "PaqueteClases";
            else if (showModalEspecial) tipoCobro = "Especial";

            var request = new RegistrarCobroRequest
            {
                GymCode = gymCode, // <--- ENVIAMOS EL GYM CODE PARA SEPARAR EL INGRESO
                AtletaId = atletaSeleccionado.Id,
                CoachId = coachId,
                TipoCobro = tipoCobro,
                Monto = cobroTotal,
                FechaPagoMensual = fechaPago,
                NumeroSemanas = numeroSemanas,
                NumeroClases = numeroClases,
                Descripcion = descripcionEspecial
            };

            var response = await Http.PostAsJsonAsync("api/admin/cobrar", request);

            if (response.IsSuccessStatusCode)
            {
                CerrarModales();
                // 🪄 Refrescamos la lista para que el backend recalcule las fechas y colores
                await CargarListas();
            }
            else
            {
                // Aquí podrías mostrar una alerta de error (Opcional)
                Console.WriteLine("Error al guardar el pago");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error de red: " + ex.Message);
        }
        finally
        {
            isSavingPayment = false;
        }
    }

    // Helper para extraer la primera letra del nombre y apellido
    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini; // "N" de Nómada por defecto
    }
}
@page "/perfil/rutina-provisional"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">COACH IA</h2>
        </div>

        <!-- BANNER DE ADVERTENCIA PROVISIONAL -->
        <div class="fade-in-up" style="background: rgba(0, 188, 212, 0.05); border-left: 4px solid #00bcd4; padding: 15px 20px; margin: 0 15px 25px 15px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,188,212,0.1);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00bcd4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span style="color: #00bcd4; font-weight: 900; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Entrenamiento Temporal</span>
            </div>
            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0; line-height: 1.5; font-weight: 600;">
                Este plan es exclusivo para viajes o días sin asistencia al box. No genera historial acumulativo y caducará 48 hrs después de finalizar tu último día.
            </p>
        </div>

        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 45vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px; border-top-color: #00bcd4;"></span>
                <p style="margin-top: 20px; color: var(--text-muted); font-weight: 800; letter-spacing: 1px;">@(isGenerating ? "COACH IA PROGRAMANDO..." : "CARGANDO...")</p>
            </div>
        }
        else if (planActivo == null)
        {
            <!-- ================= CUESTIONARIO GENERADOR ================= -->
            <div class="fade-in-up" style="padding: 0 15px; animation-delay: 0.1s;">
                <div class="modern-row" style="flex-direction: column; padding: 25px 20px; background: var(--card-bg); border-color: rgba(0, 188, 212, 0.3);">

                    <div style="display: flex; align-items: center; margin-bottom: 25px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                        <div style="width: 5px; height: 22px; background: #00bcd4; border-radius: 5px; margin-right: 12px; box-shadow: 0 0 10px rgba(0, 188, 212, 0.5);"></div>
                        <h3 style="color: var(--text-main); font-size: 1.1rem; text-transform: uppercase; font-weight: 900; letter-spacing: 1.5px; margin: 0;">CONFIGURA TU PLAN</h3>
                    </div>

                    <!-- DÍAS (1 A 5) -->
                    <div style="margin-bottom: 30px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; display: block; margin-bottom: 12px;">¿Cuántos días entrenarás? (1 a 5)</label>
                        <div style="display: flex; gap: 10px;">
                            @for (int d = 1; d <= 5; d++)
                            {
                                int num = d;
                                <button type="button" class="@(request.Dias == num ? "ink-btn" : "ink-btn-outline")" style="flex: 1; padding: 12px 0; margin: 0; font-weight: 900; border-radius: 12px; @(request.Dias == num ? "background: #00bcd4; color: black; border-color: #00bcd4; box-shadow: 0 4px 15px rgba(0,188,212,0.4);" : "color: var(--text-main); border-color: rgba(128,128,128,0.3);")" @onclick="() => request.Dias = num">
                                    @num D
                                </button>
                            }
                        </div>
                    </div>

                    <!-- ENTORNO / EQUIPO -->
                    <div style="margin-bottom: 30px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; display: block; margin-bottom: 12px;">Equipamiento disponible</label>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div class="modern-row" style="padding: 15px; margin: 0; cursor: pointer; transition: all 0.2s; border: 1px solid @(request.Entorno == "CasaAutocargas" ? "#00bcd4" : "rgba(128,128,128,0.2)"); background: @(request.Entorno == "CasaAutocargas" ? "rgba(0, 188, 212, 0.05)" : "rgba(128,128,128,0.02)"); border-radius: 12px;" @onclick='() => request.Entorno = "CasaAutocargas"'>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="background: @(request.Entorno == "CasaAutocargas" ? "rgba(0,188,212,0.15)" : "rgba(128,128,128,0.1)"); padding: 8px; border-radius: 8px; color: @(request.Entorno == "CasaAutocargas" ? "#00bcd4" : "var(--text-muted)");">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                    </div>
                                    <span style="color: var(--text-main); font-weight: 800; font-size: 0.9rem;">Casa (Peso Corporal Puro)</span>
                                </div>
                            </div>

                            <div class="modern-row" style="padding: 15px; margin: 0; cursor: pointer; transition: all 0.2s; border: 1px solid @(request.Entorno == "CasaMancuernas" ? "#00bcd4" : "rgba(128,128,128,0.2)"); background: @(request.Entorno == "CasaMancuernas" ? "rgba(0, 188, 212, 0.05)" : "rgba(128,128,128,0.02)"); border-radius: 12px;" @onclick='() => request.Entorno = "CasaMancuernas"'>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="background: @(request.Entorno == "CasaMancuernas" ? "rgba(0,188,212,0.15)" : "rgba(128,128,128,0.1)"); padding: 8px; border-radius: 8px; color: @(request.Entorno == "CasaMancuernas" ? "#00bcd4" : "var(--text-muted)");">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.44 11.44a3 3 0 0 1 4.12 0l7 7a3 3 0 1 1-4.24 4.24l-7-7a3 3 0 0 1 0-4.24z"></path><line x1="14.41" y1="18.59" x2="18.59" y2="14.41"></line><path d="M2.12 9.12a3 3 0 0 1 0-4.24l2-2a3 3 0 1 1 4.24 4.24l-2 2a3 3 0 0 1-4.24 0z"></path></svg>
                                    </div>
                                    <span style="color: var(--text-main); font-weight: 800; font-size: 0.9rem;">Casa con Mancuernas</span>
                                </div>
                            </div>

                            <div class="modern-row" style="padding: 15px; margin: 0; cursor: pointer; transition: all 0.2s; border: 1px solid @(request.Entorno == "Gimnasio" ? "#00bcd4" : "rgba(128,128,128,0.2)"); background: @(request.Entorno == "Gimnasio" ? "rgba(0, 188, 212, 0.05)" : "rgba(128,128,128,0.02)"); border-radius: 12px;" @onclick='() => request.Entorno = "Gimnasio"'>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="background: @(request.Entorno == "Gimnasio" ? "rgba(0,188,212,0.15)" : "rgba(128,128,128,0.1)"); padding: 8px; border-radius: 8px; color: @(request.Entorno == "Gimnasio" ? "#00bcd4" : "var(--text-muted)");">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="15" y2="22"></line><line x1="9" y1="18" x2="15" y2="18"></line><line x1="9" y1="14" x2="15" y2="14"></line><line x1="9" y1="10" x2="15" y2="10"></line><line x1="9" y1="6" x2="15" y2="6"></line></svg>
                                    </div>
                                    <span style="color: var(--text-main); font-weight: 800; font-size: 0.9rem;">Gimnasio Tradicional / Hotel</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- DIFICULTAD -->
                    <div style="margin-bottom: 30px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; display: block; margin-bottom: 12px;">Nivel de Exigencia</label>
                        <div class="segmented-control" style="margin: 0; background: rgba(128,128,128,0.05); padding: 5px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.1);">
                            <div class="segment @(request.Dificultad == "Principiante" ? "active" : "")" style="@(request.Dificultad == "Principiante" ? "background: #00bcd4; color: black; box-shadow: 0 2px 10px rgba(0,188,212,0.3); font-weight: 900;" : "color: var(--text-muted); font-weight: 700;")" @onclick='() => request.Dificultad = "Principiante"'>SUAVE</div>
                            <div class="segment @(request.Dificultad == "Intermedio" ? "active" : "")" style="@(request.Dificultad == "Intermedio" ? "background: #00bcd4; color: black; box-shadow: 0 2px 10px rgba(0,188,212,0.3); font-weight: 900;" : "color: var(--text-muted); font-weight: 700;")" @onclick='() => request.Dificultad = "Intermedio"'>MEDIO</div>
                            <div class="segment @(request.Dificultad == "Avanzado" ? "active" : "")" style="@(request.Dificultad == "Avanzado" ? "background: #00bcd4; color: black; box-shadow: 0 2px 10px rgba(0,188,212,0.3); font-weight: 900;" : "color: var(--text-muted); font-weight: 700;")" @onclick='() => request.Dificultad = "Avanzado"'>INTENSO</div>
                        </div>
                    </div>

                    <!-- NOTAS EXTRAS -->
                    <div style="margin-bottom: 35px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; display: block; margin-bottom: 12px;">¿Alguna molestia o preferencia?</label>
                        <input type="text" @bind="request.Notas" placeholder="Ej. Dolor lumbar, enfocar en hombros..." class="search-input" style="font-size: 0.95rem; font-weight: 700; background: rgba(128,128,128,0.05); color: var(--text-main); border-color: rgba(128,128,128,0.2);" />
                    </div>

                    <button class="ink-btn glow-btn" @onclick="GenerarPlanIA" disabled="@isGenerating" style="width: 100%; background: linear-gradient(135deg, #00bcd4, #008ba3); color: white; font-weight: 900; font-size: 1.1rem; padding: 18px; border: none; box-shadow: 0 5px 20px rgba(0,188,212,0.4);">
                        @if (isGenerating)
                        {
                            <span class="spinner" style="border-top-color: white;"></span>
                        }
                        else
                        {
                            <span>GENERAR ENTRENAMIENTO IA</span>
                        }
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- ================= VISTA DEL PLAN ACTIVO ================= -->
            <div class="fade-in-up" style="padding: 0 15px; animation-delay: 0.1s;">
                <!-- SELECTOR DE DÍAS -->
                <div style="display: flex; gap: 10px; margin-bottom: 25px; overflow-x: auto; padding-bottom: 5px;">
                    @foreach (var dia in planActivo.Dias)
                    {
                        int dNum = dia.DiaNumero;
                        <button class="ink-btn-outline" style="flex: 1; min-width: 70px; padding: 12px 0; margin: 0; font-weight: 900; font-size: 0.85rem; border-radius: 12px; border-width: 2px; border-color: @(diaSeleccionadoNumero == dNum ? "#00bcd4" : (dia.Completado ? "#00C851" : "rgba(128,128,128,0.2)")); background: @(diaSeleccionadoNumero == dNum ? "rgba(0, 188, 212, 0.15)" : (dia.Completado ? "rgba(0, 200, 81, 0.1)" : "var(--card-bg)")); color: @(diaSeleccionadoNumero == dNum ? "#00bcd4" : (dia.Completado ? "#00C851" : "var(--text-main)")); box-shadow: @(diaSeleccionadoNumero == dNum ? "0 4px 10px rgba(0,188,212,0.15)" : "none");" @onclick="() => diaSeleccionadoNumero = dNum">
                            DÍA @dNum
                            @if (dia.Completado)
                            {
                                <span style="margin-left: 4px;">✓</span>
                            }
                        </button>
                    }
                </div>

                @if (DiaActual != null)
                {
                    <div class="modern-row" style="flex-direction: column; align-items: stretch; padding: 25px 20px; margin-bottom: 25px; border-color: @(DiaActual.Completado ? "rgba(0,200,81,0.4)" : "rgba(0,188,212,0.4)"); background: var(--card-bg); box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                            <h3 style="color: var(--text-main); font-weight: 900; font-size: 1.3rem; margin: 0; letter-spacing: 1px;">@DiaActual.TituloDia</h3>
                            @if (DiaActual.Completado)
                            {
                                <span style="background: rgba(0,200,81,0.1); color: #00C851; padding: 6px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 900; border: 1px solid rgba(0,200,81,0.3); display: flex; align-items: center; gap: 5px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    REALIZADO
                                </span>
                            }
                        </div>

                        <!-- BLOQUES DE TRABAJO -->
                        @foreach (var sec in DiaActual.Secciones)
                        {
                            <div style="margin-bottom: 25px;">
                                <h5 style="color: #00bcd4; font-size: 0.95rem; font-weight: 900; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 1px; border-left: 3px solid #00bcd4; padding-left: 10px;">@sec.Subtitulo</h5>
                                <div style="background: rgba(128,128,128,0.05); padding: 15px 20px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.1);">
                                    <pre style="color: var(--text-main); font-family: 'Montserrat', sans-serif; font-size: 0.95rem; line-height: 1.6; margin: 0; font-weight: 600; white-space: pre-wrap;">@sec.Contenido</pre>
                                </div>
                            </div>
                        }

                        <!-- NOTAS Y TERMINAR ENTRENAMIENTO -->
                        <div style="margin-top: 35px; padding-top: 25px; border-top: 1px dashed rgba(128,128,128,0.2);">
                            @if (DiaActual.Completado)
                            {
                                <div style="background: rgba(0, 200, 81, 0.05); border: 1px dashed rgba(0,200,81,0.3); padding: 20px; border-radius: 12px; text-align: center;">
                                    <p style="color: #00C851; font-size: 0.9rem; font-weight: 800; margin: 0;">
                                        Impacto registrado en tu Mapa de Calor de Recuperación. ¡Excelente trabajo!
                                    </p>
                                </div>
                            }
                            else
                            {
                                <label style="color: var(--text-muted); font-size: 0.85rem; font-weight: 800; display: block; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;">
                                    NOTAS DEL ATLETA:
                                </label>
                                <p style="color: var(--text-muted); font-size: 0.75rem; margin-top: -5px; margin-bottom: 15px;">Esto ayuda a nuestra IA a calcular el impacto fisiológico con mayor precisión.</p>

                                <textarea @bind="notasDia" placeholder="Ej. Hice 2 rondas extra, se me complicaron las flexiones..." class="search-input" rows="3" style="font-size: 0.95rem; margin-bottom: 20px; resize: none; background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); font-weight: 600; color: var(--text-main);"></textarea>

                                <button class="ink-btn glow-btn" @onclick="FinalizarDia" disabled="@isSubmitting" style="width: 100%; background: linear-gradient(135deg, #00bcd4, #008ba3); color: white; font-weight: 900; margin: 0; padding: 18px; font-size: 1.1rem; border: none; box-shadow: 0 5px 20px rgba(0,188,212,0.4);">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner" style="border-top-color: white;"></span>
                                    }
                                    else
                                    {
                                        <span>ENTRENAMIENTO COMPLETADO</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- BOTÓN DE ELIMINAR / REGENERAR -->
                <button class="ink-btn-outline" @onclick="EliminarPlanActual" style="border-color: rgba(255,68,68,0.5); color: #ff4444; width: 100%; margin-bottom: 40px; border-style: dashed; padding: 15px; background: rgba(255,68,68,0.05); font-weight: 800;">
                    <span style="display: flex; align-items: center; justify-content: center; gap: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        ELIMINAR ESTA RUTINA Y CREAR OTRA
                    </span>
                </button>
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private Guid currentUserId;
    private bool isLoading = true;
    private bool isGenerating = false;
    private bool isSubmitting = false;

    private GenerarRutinaProvisionalRequest request = new();
    private RutinaProvisionalCompletaDto? planActivo;
    private int diaSeleccionadoNumero = 1;
    private string notasDia = "";

    private RutinaProvisionalDiaDto? DiaActual => planActivo?.Dias.FirstOrDefault(d => d.DiaNumero == diaSeleccionadoNumero);

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);

        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            request.GymCode = gymCode;
            request.UsuarioId = currentUserId;
            await CargarPlanActivo();
        }
    }

    private async Task CargarPlanActivo()
    {
        isLoading = true;
        try
        {
            planActivo = await Http.GetFromJsonAsync<RutinaProvisionalCompletaDto>($"api/provisionales/{gymCode}/{currentUserId}");
            if (planActivo != null && planActivo.Dias.Any())
            {
                var primerPendiente = planActivo.Dias.FirstOrDefault(d => !d.Completado);
                diaSeleccionadoNumero = primerPendiente?.DiaNumero ?? 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando plan: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerarPlanIA()
    {
        isGenerating = true;
        isLoading = true;

        try
        {
            var res = await Http.PostAsJsonAsync("api/provisionales/generar", request);
            if (res.IsSuccessStatusCode)
            {
                await CargarPlanActivo();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al generar: " + ex.Message);
        }
        finally
        {
            isGenerating = false;
            isLoading = false;
        }
    }

    private async Task FinalizarDia()
    {
        if (DiaActual == null) return;
        isSubmitting = true;

        try
        {
            var req = new CompletarDiaProvisionalRequest { NotasAtleta = notasDia };
            var res = await Http.PostAsJsonAsync($"api/provisionales/completar-dia/{DiaActual.Id}", req);

            if (res.IsSuccessStatusCode)
            {
                DiaActual.Completado = true;
                notasDia = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al finalizar día: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task EliminarPlanActual()
    {
        if (planActivo == null) return;
        isLoading = true;

        try
        {
            var res = await Http.DeleteAsync($"api/provisionales/{planActivo.Id}");
            if (res.IsSuccessStatusCode)
            {
                planActivo = null;
                diaSeleccionadoNumero = 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al eliminar plan: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
@page "/admin/finanzas"
@using Nomada.Shared.Models
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http

<div class="app-container">
    <div class="feed-content" style="padding-top: 10px;">
        
        <!-- TOP BAR -->
        <div style="display: flex; align-items: center; margin-bottom: 20px;">
            <a href="/acciones" style="color: var(--text-main); margin-right: 15px; display: flex; align-items: center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
            <h2 class="greeting-title" style="margin: 0; font-size: 1.4rem;">FINANZAS</h2>
        </div>

        <!-- PESTAÑAS (TABS) -->
        <div class="segmented-control" style="margin-bottom: 20px;">
            <div class="segment @(tabActual == "Tickets" ? "active" : "")" @onclick="@(() => CambiarTab("Tickets"))">TICKETS</div>
            <div class="segment @(tabActual == "Graficas" ? "active" : "")" @onclick="@(() => CambiarTab("Graficas"))">GRÁFICAS</div>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else
        {
            <!-- ================= PESTAÑA 1: TICKETS ================= -->
            @if (tabActual == "Tickets")
            {
                <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 20px;">
                    <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; margin-bottom: 10px;">FILTRAR TICKETS</span>
                    <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                        <select class="search-input" style="flex: 1; padding: 10px; border-radius: 8px;" @bind="mesTickets">
                            <option value="0">Todo el Año</option>
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>

                        <select class="search-input" style="flex: 1; padding: 10px; border-radius: 8px;" @bind="anioTickets">
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                        </select>
                        
                        <button class="ink-btn glow-btn" style="margin: 0; padding: 0 15px; width: auto; border-radius: 8px;" @onclick="CargarTickets">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </button>
                    </div>

                    <div style="background: rgba(0, 200, 81, 0.1); padding: 15px; border-radius: 12px; border: 1px solid rgba(0, 200, 81, 0.2);">
                        <span style="color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; font-weight: 800; display: block; margin-bottom: 5px;">Total Recaudado (Selección)</span>
                        <h3 style="color: #00C851; font-size: 1.5rem; font-weight: 900; margin: 0; word-break: break-all;">$@CalcularTotalTickets().ToString("N2")</h3>
                    </div>
                </div>

                <div class="search-wrapper" style="margin-bottom: 20px;">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" @bind="textoBusqueda" @bind:event="oninput" placeholder="Buscar atleta por nombre..." class="search-input" />
                </div>

                @if (TicketsFiltrados.Any())
                {
                    <div class="user-list">
                        @foreach (var ticket in TicketsFiltrados)
                        {
                            <div class="modern-row" style="flex-direction: column; align-items: flex-start; padding: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%; margin-bottom: 10px; gap: 15px;">
                                    <span style="font-weight: 900; color: var(--text-main); font-size: 1rem; flex: 1; word-wrap: break-word; line-height: 1.2;">@ticket.Atleta</span>
                                    <span style="color: #00C851; font-weight: 900; font-size: 1.1rem; flex-shrink: 0;">+$@ticket.Monto.ToString("N2")</span>
                                </div>
                                
                                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <div style="display: flex; flex-direction: column; gap: 3px; flex: 1; padding-right: 10px;">
                                        <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">
                                            @FormatearTipoCobro(ticket.TipoCobro)
                                        </span>
                                        @if (!string.IsNullOrEmpty(ticket.Descripcion))
                                        {
                                            <span style="color: var(--text-muted); font-size: 0.75rem;">@ticket.Descripcion</span>
                                        }
                                    </div>
                                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0;">
                                        <span style="color: var(--text-muted); font-size: 0.75rem;">@ticket.FechaCobro.ToLocalTime().ToString("dd MMM yy, HH:mm")</span>
                                        <span style="color: #33b5e5; font-size: 0.7rem; font-weight: 800;">Coach: @ticket.Coach</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 40px 0;">
                        <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700;">No se encontraron pagos.</p>
                    </div>
                }
            }

            <!-- ================= PESTAÑA 2: GRÁFICAS INTERACTIVAS ================= -->
            @if (tabActual == "Graficas" && resumenAnual != null)
            {
                <!-- SELECTOR GLOBAL DE AÑO -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding: 0 5px;">
                    <span style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; letter-spacing: 1px;">AÑO FISCAL</span>
                    <select class="search-input" style="padding: 8px 20px; border-radius: 8px; width: auto; font-size: 0.95rem; font-weight: 800; background-color: var(--card-bg); border: 2px solid #33b5e5;" @bind="anioGrafica" @bind:after="CargarGraficasTotales">
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                        <option value="2027">2027</option>
                    </select>
                </div>

                <!-- Info Flotante interactiva -->
                @if (detalleSeleccionado != null)
                {
                    <div class="modern-row fade-in-up" style="background: linear-gradient(135deg, #111, #333); border-color: #33b5e5; flex-direction: column; align-items: center; padding: 15px; margin-bottom: 20px;">
                        <span style="color: #33b5e5; font-size: 0.8rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1px;">@detalleSeleccionado.Titulo</span>
                        <h2 style="color: white; margin: 5px 0 0 0; font-size: 1.8rem;">$@detalleSeleccionado.Monto.ToString("N2")</h2>
                        <span style="color: #aaa; font-size: 0.75rem; margin-top: 5px;">@detalleSeleccionado.Subtitulo</span>
                    </div>
                }
                else
                {
                    <div class="modern-row" style="justify-content: center; padding: 15px; margin-bottom: 20px; border-style: dashed;">
                        <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 700;">Toca un punto o barra para ver detalles.</span>
                    </div>
                }

                <!-- Gráfica 1: Puntos (Comportamiento Anual) -->
                <div class="modern-row" style="flex-direction: column; padding: 20px 10px; margin-bottom: 20px;">
                    <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; margin-bottom: 20px; padding-left: 10px; text-transform: uppercase;">REPORTE ANUAL</span>
                    
                    <div style="width: 100%; height: 160px; position: relative;">
                        <svg width="100%" height="100%" viewBox="0 0 120 100" preserveAspectRatio="none">
                            <polyline points="@ObtenerPuntosSVG()" fill="none" stroke="#33b5e5" stroke-width="1.5" stroke-linejoin="round"/>
                            @for (int i = 0; i < 12; i++)
                            {
                                int index = i; 
                                decimal montoMes = resumenAnual.IngresosPorMes[index];
                                decimal maxMonto = resumenAnual.IngresosPorMes.Max() == 0 ? 1 : resumenAnual.IngresosPorMes.Max();
                                
                                double cx = 5 + (index * 10);
                                double cy = 90 - (double)((montoMes / maxMonto) * 80);

                                <circle cx="@cx" cy="@cy" r="3" fill="@(mesSeleccionadoGraph == (index+1) ? "#00C851" : "#111")" stroke="@(mesSeleccionadoGraph == (index+1) ? "#00C851" : "#33b5e5")" stroke-width="1.5" 
                                        style="cursor: pointer; pointer-events: all;" 
                                        @onclick="() => MostrarDetalleMes(index, montoMes)" />
                            }
                        </svg>
                    </div>
                    <div style="display: flex; justify-content: space-between; width: 100%; padding: 0 5%; color: var(--text-muted); font-size: 0.6rem; font-weight: 700; margin-top: 5px;">
                        <span>E</span><span>F</span><span>M</span><span>A</span><span>M</span><span>J</span><span>J</span><span>A</span><span>S</span><span>O</span><span>N</span><span>D</span>
                    </div>
                    
                    <div style="text-align: center; margin-top: 25px; border-top: 1px solid rgba(128,128,128,0.2); padding-top: 15px;">
                        <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 800;">INGRESOS TOTALES DEL AÑO</span>
                        <h4 style="color: var(--text-main); margin: 5px 0 0 0; font-size: 1.4rem;">$@resumenAnual.TotalAnio.ToString("N2")</h4>
                    </div>
                </div>

                <!-- Gráfica 2: Barras (Ingreso Semanal) -->
                <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 25px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                        <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">INGRESOS SEMANALES  </span>
                        
                        <!-- El selector de mes ahora está más espaciado y limpio -->
                        <select class="search-input" style="padding: 5px 10px; margin-left:5px; border-radius: 6px; width: auto; font-size: 0.8rem; background-color: transparent;" @bind="mesGrafica" @bind:after="CargarGraficaSemanal">
                            <option value="1">Ene</option><option value="2">Feb</option><option value="3">Mar</option>
                            <option value="4">Abr</option><option value="5">May</option><option value="6">Jun</option>
                            <option value="7">Jul</option><option value="8">Ago</option><option value="9">Sep</option>
                            <option value="10">Oct</option><option value="11">Nov</option><option value="12">Dic</option>
                        </select>
                    </div>
                    
                    <!-- Contenedor estricto para las barras -->
                    <div style="display: flex; align-items: flex-end; justify-content: space-around; width: 100%; height: 140px; border-bottom: 2px solid rgba(128,128,128,0.2); padding-bottom: 5px;">
                        @{
                            var semanas = ObtenerIngresosSemanales();
                            decimal maxSemana = semanas.Max() == 0 ? 1 : semanas.Max();

                            for (int i = 0; i < semanas.Count; i++)
                            {
                                int index = i;
                                decimal montoSemana = semanas[index];
                                int porcentaje = (int)Math.Round((montoSemana / maxSemana) * 100);

                                <!-- Barra individual con ancho fijo para evitar empalmes -->
                                <div style="display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; width: 40px; cursor: pointer;" 
                                     @onclick="() => MostrarDetalleSemana(index, montoSemana)">
                                    <div style="width: 25px; height: @(porcentaje)%; min-height: 5px; background: linear-gradient(0deg, #00C851, #007E33); border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); opacity: @(semanaSeleccionadaGraph == index ? "1" : "0.6"); transition: height 0.4s ease-out, opacity 0.2s;"></div>
                                </div>
                            }
                        }
                    </div>
                    
                    <!-- Etiquetas debajo de las barras -->
                    <div style="display: flex; justify-content: space-around; width: 100%; margin-top: 10px; color: var(--text-muted); font-size: 0.75rem; font-weight: 800;">
                        @for (int i = 0; i < ObtenerIngresosSemanales().Count; i++)
                        {
                            <span style="width: 40px; text-align: center;">S@(i+1)</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isPageLoading = true;
    private string tabActual = "Tickets";
    
    // Controles Tickets
    private string textoBusqueda = "";
    private int mesTickets = DateTime.Now.Month;
    private int anioTickets = DateTime.Now.Year;
    private List<IngresoDto> historialTickets = new();

    // Controles Gráficas
    private int anioGrafica = DateTime.Now.Year;
    private int mesGrafica = DateTime.Now.Month;
    private ResumenFinanzasDto? resumenAnual;
    private List<IngresoDto> historialMesGrafica = new();

    // Filtro en tiempo real para tickets
    private IEnumerable<IngresoDto> TicketsFiltrados => historialTickets
        .Where(t => string.IsNullOrWhiteSpace(textoBusqueda) || t.Atleta.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    // Interactividad
    private class DetalleView { public string Titulo { get; set; } = ""; public decimal Monto { get; set; } public string Subtitulo { get; set; } = ""; }
    private DetalleView? detalleSeleccionado = null;
    private int mesSeleccionadoGraph = -1;
    private int semanaSeleccionadaGraph = -1;

    protected override async Task OnInitializedAsync()
    {
        await CargarTickets();
        await CargarGraficasTotales();
    }

    private async Task CambiarTab(string tab)
    {
        tabActual = tab;
        detalleSeleccionado = null;
        mesSeleccionadoGraph = -1;
        semanaSeleccionadaGraph = -1;
    }

    // ================= LÓGICA TICKETS =================
    private async Task CargarTickets()
    {
        isPageLoading = true;
        try
        {
            historialTickets = await Http.GetFromJsonAsync<List<IngresoDto>>($"api/finanzas/historial?mes={mesTickets}&anio={anioTickets}") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    private decimal CalcularTotalTickets() => historialTickets.Sum(h => h.Monto);

    private string FormatearTipoCobro(string tipo)
    {
        return tipo switch
        {
            "Mensual" => "Mensualidad",
            "Semanal" => "Semana",
            "PaqueteClases" => "Clase(s) / Drop-in",
            "Especial" => "Clase Especial",
            _ => tipo
        };
    }

    // ================= LÓGICA GRÁFICAS =================
    private async Task CargarGraficasTotales()
    {
        try
        {
            resumenAnual = await Http.GetFromJsonAsync<ResumenFinanzasDto>($"api/finanzas/resumen/{anioGrafica}");
            await CargarGraficaSemanal();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task CargarGraficaSemanal()
    {
        try { historialMesGrafica = await Http.GetFromJsonAsync<List<IngresoDto>>($"api/finanzas/historial?mes={mesGrafica}&anio={anioGrafica}") ?? new(); }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private string ObtenerPuntosSVG()
    {
        if (resumenAnual == null) return "";
        var puntos = new List<string>();
        decimal maxMonto = resumenAnual.IngresosPorMes.Max() == 0 ? 1 : resumenAnual.IngresosPorMes.Max();

        for (int i = 0; i < 12; i++)
        {
            double cx = 5 + (i * 10);
            double cy = 90 - (double)((resumenAnual.IngresosPorMes[i] / maxMonto) * 80);
            puntos.Add($"{cx.ToString(CultureInfo.InvariantCulture)},{cy.ToString(CultureInfo.InvariantCulture)}");
        }
        return string.Join(" ", puntos);
    }

    private List<decimal> ObtenerIngresosSemanales()
    {
        var semanas = new List<decimal> { 0, 0, 0, 0, 0 };
        foreach (var ticket in historialMesGrafica)
        {
            int dia = ticket.FechaCobro.ToLocalTime().Day;
            int numSemana = (dia - 1) / 7;
            if (numSemana > 4) numSemana = 4;
            
            semanas[numSemana] += ticket.Monto;
        }
        if (semanas[4] == 0) semanas.RemoveAt(4);
        return semanas;
    }

    private void MostrarDetalleMes(int index, decimal monto)
    {
        semanaSeleccionadaGraph = -1;
        mesSeleccionadoGraph = index + 1;
        detalleSeleccionado = new DetalleView
        {
            Titulo = ObtenerNombreMes(mesSeleccionadoGraph),
            Monto = monto,
            Subtitulo = $"Total recaudado en el año {anioGrafica}"
        };
    }

    private void MostrarDetalleSemana(int index, decimal monto)
    {
        mesSeleccionadoGraph = -1;
        semanaSeleccionadaGraph = index;
        int diaInicio = (index * 7) + 1;
        int diaFin = index == 4 ? DateTime.DaysInMonth(anioGrafica, mesGrafica) : (index * 7) + 7;
        
        detalleSeleccionado = new DetalleView
        {
            Titulo = $"Semana {index + 1}",
            Monto = monto,
            Subtitulo = $"Del {diaInicio} al {diaFin} de {ObtenerNombreMes(mesGrafica)}"
        };
    }

    private string ObtenerNombreMes(int mes)
    {
        string[] meses = { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
        if (mes >= 1 && mes <= 12) return meses[mes - 1];
        return "";
    }
}
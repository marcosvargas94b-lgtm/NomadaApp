        catch { }
        
        NavManager.NavigateTo("/resumen-clase"); 
    }

    public class AtletaBusquedaDto
    {
        public Guid Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
        public string Iniciales { get; set; } = string.Empty;
        public string? FotoPerfil { get; set; }
        public bool Procesando { get; set; } = false;
        public bool Agregado { get; set; } = false;
    }

    private string textoBusquedaAtleta = "";
    private List<AtletaBusquedaDto> todosLosAtletas = new();

    private IEnumerable<AtletaBusquedaDto> AtletasBusquedaFiltrados => todosLosAtletas
        .Where(a => 
            (string.IsNullOrWhiteSpace(textoBusquedaAtleta) || a.NombreCompleto.Contains(textoBusquedaAtleta, StringComparison.OrdinalIgnoreCase))
            && !usuariosLobby.Any(lobbyUser => lobbyUser.UsuarioId == a.Id)
        );

    private async Task CargarWodsDelDia() 
    { 
        try 
        { 
            wodsDelDia = await Http.GetFromJsonAsync<List<WodGeneralDto>>($"api/wod/{gymCode}/dia/{DateTime.UtcNow:yyyy-MM-dd}") ?? new(); 
            if (wodsDelDia.Any()) 
            { 
                wodSeleccionadoId = wodsDelDia.First().Id; 
                CargarWodSeleccionado(); 
            } 
        } catch { } 
    }

    private void CargarWodSeleccionado() 
    { 
        wodActivo = wodsDelDia.FirstOrDefault(w => w.Id == wodSeleccionadoId); 
        seccionVisibleIndex = -1; 
    }

    private async Task CargarUsuariosLobby() { try { usuariosLobby = await Http.GetFromJsonAsync<List<UsuarioLobbyDto>>($"api/lobby/{gymCode}/sesion/{HorarioId}/usuarios") ?? new(); } catch { } }
    private string ObtenerColorMetodo(string metodo) => metodo switch { "App" => "#33b5e5", "Codigo" => "#00C851", "Manual" => "#ffbb33", _ => "#aaa" };
    

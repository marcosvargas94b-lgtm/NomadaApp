    .timer-fase { font-size: clamp(1.5rem, 5cqi, 4rem); font-weight: 900; text-transform: uppercase; text-shadow: 0 0 15px rgba(255,255,255,0.1); letter-spacing: 3px; }

    .pulse-anim { animation: pulse 0.5s infinite alternate; }
    @@keyframes pulse { 0% { transform: scale(1); } 100% { transform: scale(1.08); } }
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @@keyframes fadeIn { 0% { opacity: 0; transform: translateY(5px); } 100% { opacity: 1; transform: translateY(0); } }

    .btn-block { flex: 1; border: none; border-radius: 12px; padding: 18px 10px; font-size: 1.1rem; font-weight: 900; color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: transform 0.1s, filter 0.2s; letter-spacing: 1px; font-family: 'Montserrat', sans-serif; }
    .btn-block:active { transform: scale(0.96); }
    .bg-green { background: linear-gradient(135deg, #00C851, #007E33); box-shadow: 0 5px 15px rgba(0,200,81,0.3); }
    .bg-yellow { background: linear-gradient(135deg, #ffbb33, #ff8800); color: #111; box-shadow: 0 5px 15px rgba(255,187,51,0.3); }
    .bg-red { background: linear-gradient(135deg, #ff4444, #cc0000); box-shadow: 0 5px 15px rgba(255,68,68,0.3); }
    .bg-blue { background: linear-gradient(135deg, #33b5e5, #0099CC); box-shadow: 0 5px 15px rgba(51,181,229,0.3); }
    .bg-dark-ghost { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); }

    /* MODALES */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.9); z-index: 3000; display: flex; align-items: center; justify-content: center; }
    .modal-content { background: #111; padding: 30px; border-radius: 20px; width: 90%; max-width: 500px; border: 1px solid rgba(255,255,255,0.1); }
    .mode-tab { flex: 1; padding: 10px 5px; background: transparent; border: none; color: #888; font-weight: 800; font-size: 0.75rem; border-radius: 8px; cursor: pointer; transition: all 0.2s; }
    .mode-tab.active-tab { background: #333; color: white; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .config-row { background: rgba(0,0,0,0.3); padding: 12px 15px; border-radius: 10px; display: flex; flex-direction: column; gap: 8px; }
    .config-row label { color: #ddd; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; }
    .ink-input-small { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); color: white; padding: 8px 12px; border-radius: 8px; font-weight: 700; width: 60px; text-align: center; }
    .ink-input-small:focus { outline: none; border-color: #33b5e5; }
    .spin-anim { animation: spin 1s linear infinite; }
    @@keyframes spin { 100% { transform: rotate(360deg); } }
    /* SWITCH MODO JUEZ */
    .switch-juez { position: relative; display: inline-block; width: 42px; height: 22px; } 
    .switch-juez input { opacity: 0; width: 0; height: 0; }
    .slider-juez { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(255,255,255,0.1); transition: .4s; border: 1px solid rgba(255,255,255,0.2); } 
    .slider-juez:before { position: absolute; content: ""; height: 16px; width: 16px; left: 2px; bottom: 2px; background-color: #888; transition: .4s; }
    input:checked + .slider-juez { background-color: rgba(0, 200, 81, 0.2); border-color: #00C851; } 

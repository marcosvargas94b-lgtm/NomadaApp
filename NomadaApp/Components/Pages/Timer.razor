    private bool modoJuezHabilitado = false;
    
    private Dictionary<Guid, string> tiemposCapturados = new();

    private void CapturarTiempoAtleta(Guid usuarioId)
    {
        if (!modoJuezHabilitado) return;
        if (tiemposCapturados.ContainsKey(usuarioId)) return;

        int segundosTranscurridos = 0;

        if (FaseActual == "READY")
        {
            segundosTranscurridos = 0; 
        }
        else if (configTimer.Modo == "For Time")
        {
            segundosTranscurridos = tiempoEnPantalla;
        }
        else
        {
            segundosTranscurridos = configTimer.TiempoTrabajoSegundos - tiempoEnPantalla;
            if (segundosTranscurridos < 0) segundosTranscurridos = 0; 
        }

        tiemposCapturados.Add(usuarioId, FormatearTiempo(segundosTranscurridos));
    }

    private bool mostrarModalEliminar = false;
    private bool isEliminandoAtleta = false;
    private UsuarioLobbyDto? atletaAEliminar = null;

    private void SolicitarEliminarAtleta(UsuarioLobbyDto atleta)
    {
        atletaAEliminar = atleta;
        mostrarModalEliminar = true;
    }

    private async Task ConfirmarEliminarAtleta()
    {
        if (atletaAEliminar == null) return;

        isEliminandoAtleta = true;
        StateHasChanged();

        try
        {
            string urlDelete = $"api/reservas/{gymCode}/admin/reservas/{atletaAEliminar.ReservaId}";
            Console.WriteLine($"Intentando eliminar reserva con URL: {urlDelete}"); 

            var response = await Http.DeleteAsync(urlDelete);
            
            if (response.IsSuccessStatusCode)
            {
                usuariosLobby.RemoveAll(u => u.UsuarioId == atletaAEliminar.UsuarioId);
                tiemposCapturados.Remove(atletaAEliminar.UsuarioId); 
                
                Console.WriteLine("Atleta eliminado correctamente de la BD.");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                usuariosLobby.RemoveAll(u => u.UsuarioId == atletaAEliminar.UsuarioId);
                tiemposCapturados.Remove(atletaAEliminar.UsuarioId);
                
                Console.WriteLine("La reserva ya no existía en la BD, se limpió de la UI.");
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error", $"No se pudo eliminar: {error}", "OK");
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error de Red", ex.Message, "OK");
        }
        finally
        {
            isEliminandoAtleta = false;
            mostrarModalEliminar = false;
            atletaAEliminar = null;
            StateHasChanged();
        }
    }

    private void IniciarTimer()
    {
        try { JSRuntime.InvokeVoidAsync("unlockAudio"); } catch { }

        isTimerRunning = true;

        if (FaseActual == "PAUSA")
        {
            FaseActual = ObtenerFaseAnteriorColorYNombre(ColorTimer);
            
            if (configTimer.Modo == "For Time" && FaseActual == "WORK")
            {
                 horaInicioForTime = DateTime.UtcNow.AddSeconds(-tiempoEnPantalla);
            }
            else
            {
                 horaObjetivoFase = DateTime.UtcNow.AddSeconds(segundosRestantesAntesDePausa);
            }
        }
        else
        {
            if (FaseActual == "READY")
            {
                horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.CuentaRegresivaInicial);
            }
        }

        engineReloj.Start();
    }

    private void PausarTimer()
    {
        isTimerRunning = false;
        engineReloj.Stop();

        horaInicioPausa = DateTime.UtcNow;
        segundosRestantesAntesDePausa = FaseActual == "READY" || configTimer.Modo != "For Time" 
                                        ? (int)(horaObjetivoFase - DateTime.UtcNow).TotalSeconds 
                                        : tiempoEnPantalla;

        FaseActual = "PAUSA";
        ColorTimer = "#ffbb33";
    }

    private void DetenerYResetear()
    {
        isTimerRunning = false;
        engineReloj.Stop();
        tiempoEnPantalla = configTimer.CuentaRegresivaInicial;
        rondaActual = 1;
        bloqueActual = 1;
        ColorTimer = "#ffffff";
        FaseActual = "READY";
        AnimarReloj = false;
        horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.CuentaRegresivaInicial);
    }

    private void FinalizarTimer()
    {
        isTimerRunning = false;
        engineReloj.Stop();
        ColorTimer = "#ffffff";
        tiempoEnPantalla = 0;
        AnimarReloj = false;
    }

    private void TicTacReloj(object sender, System.Timers.ElapsedEventArgs e)
    {
        if (!isTimerRunning) return;

        int segundosCalculados;

        if (configTimer.Modo == "For Time" && FaseActual == "WORK")
        {
            segundosCalculados = (int)(DateTime.UtcNow - horaInicioForTime).TotalSeconds;
        }
        else
        {
            segundosCalculados = (int)(horaObjetivoFase - DateTime.UtcNow).TotalSeconds;
            if (segundosCalculados < 0) segundosCalculados = 0;
        }

        if (tiempoEnPantalla != segundosCalculados)
        {
            tiempoEnPantalla = segundosCalculados;

            if (FaseActual == "READY" || configTimer.Modo != "For Time")
            {
                if (tiempoEnPantalla == 3 || tiempoEnPantalla == 2 || tiempoEnPantalla == 1)
                {
                    Sonar("beep"); AnimarReloj = true;
                }
                else { AnimarReloj = false; }
            }

            if (FaseActual == "WORK" && configTimer.TiempoTrabajoSegundos >= 10 && tiempoEnPantalla == (configTimer.TiempoTrabajoSegundos / 2))
            {
                Sonar("medio");
            }

            if (configTimer.Modo == "For Time" && FaseActual == "WORK" && configTimer.TiempoTrabajoSegundos > 0)
            {
                if (tiempoEnPantalla >= configTimer.TiempoTrabajoSegundos)
                {
                    Sonar("go"); FaseActual = "DONE"; FinalizarTimer();
                    InvokeAsync(StateHasChanged);
                    return;
                }
            }

            if (tiempoEnPantalla <= 0 && FaseActual != "DONE" && (FaseActual == "READY" || configTimer.Modo != "For Time"))
            {
                Sonar("go"); AvanzarFase();
            }

            InvokeAsync(StateHasChanged);
        }
    }

    private void AvanzarFase()
    {
        if (FaseActual == "READY")
        {
            FaseActual = "WORK"; ColorTimer = "#00C851";

            if (configTimer.Modo == "For Time")
            {
                tiempoEnPantalla = 0;
                horaInicioForTime = DateTime.UtcNow;
            }
            else
            {
                horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.TiempoTrabajoSegundos);
            }
        }
        else if (FaseActual == "WORK")
        {
            if (configTimer.Modo == "AMRAP") { FaseActual = "DONE"; FinalizarTimer(); return; }

            if (rondaActual < configTimer.Rondas)
            {
                if (configTimer.Modo == "EMOM")
                {
                    rondaActual++;
                    horaObjetivoFase = horaObjetivoFase.AddSeconds(configTimer.TiempoTrabajoSegundos);
                }
                else
                {
                    FaseActual = "REST"; ColorTimer = "#ff4444";
                    horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.TiempoDescansoSegundos);
                }
            }
            else if (bloqueActual < configTimer.Bloques)
            {
                FaseActual = "REST BLOCK"; ColorTimer = "#ffbb33";
                horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.DescansoEntreBloquesSegundos);
            }
            else { FaseActual = "DONE"; FinalizarTimer(); }
        }
        else if (FaseActual == "REST" || FaseActual == "REST BLOCK")
        {
            if (FaseActual == "REST BLOCK") { bloqueActual++; rondaActual = 1; }
            else { rondaActual++; }

            FaseActual = "WORK"; ColorTimer = "#00C851";
            horaObjetivoFase = DateTime.UtcNow.AddSeconds(configTimer.TiempoTrabajoSegundos);
        }
    }

    private string ObtenerFaseAnteriorColorYNombre(string color)
    {
        if (color == "#ffbb33" && configTimer.Bloques > 1 && bloqueActual < configTimer.Bloques) return "REST BLOCK";
        if (color == "#ff4444") return "REST";
        if (tiempoEnPantalla <= configTimer.CuentaRegresivaInicial && rondaActual == 1 && bloqueActual == 1) return "READY";
        return "WORK";
    }

    private string FormatearTiempo(int totalSegundos) { int min = totalSegundos / 60; int sec = totalSegundos % 60; return $"{min:D2}:{sec:D2}"; }

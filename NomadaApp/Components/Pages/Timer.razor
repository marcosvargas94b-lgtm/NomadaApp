    private int tempMinTrabajo = 0, tempSegTrabajo = 30;
    private int tempMinDescanso = 0, tempSegDescanso = 20;
    private int tempRondas = 5;
    private int tempBloques = 1;
    private int tempMinDescansoBloque = 1, tempSegDescansoBloque = 0;
    private int tempTimeCapMin = 0, tempTimeCapSeg = 0;
    private int tempCuentaRegresiva = 7;

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        DeviceDisplay.Current.KeepScreenOn = true;

        try
        {
            playerBeep = AudioManager.CreatePlayer(await FileSystem.OpenAppPackageFileAsync("wwwroot/sonidos/beep.mp3"));
            playerGo = AudioManager.CreatePlayer(await FileSystem.OpenAppPackageFileAsync("wwwroot/sonidos/go.mp3"));
            playerMedio = AudioManager.CreatePlayer(await FileSystem.OpenAppPackageFileAsync("wwwroot/sonidos/medio.mp3"));

#if IOS
            var session = AVFoundation.AVAudioSession.SharedInstance();
            session.SetCategory(AVFoundation.AVAudioSessionCategory.Playback, AVFoundation.AVAudioSessionCategoryOptions.MixWithOthers);
            session.SetActive(true);
#endif
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error Audio: " + ex.Message);
        }

        tiempoEnPantalla = configTimer.CuentaRegresivaInicial;
        ColorTimer = "#ffffff";

        engineReloj = new System.Timers.Timer(100);
        engineReloj.Elapsed += TicTacReloj;

        await CargarWodsDelDia();
        await CargarUsuariosLobby();
    }

    private void Sonar(string tipo)
    {
        try
        {
            if (tipo == "beep" && playerBeep != null) { playerBeep.Stop(); playerBeep.Play(); }
            else if (tipo == "go" && playerGo != null) { playerGo.Stop(); playerGo.Play(); }
            else if (tipo == "medio" && playerMedio != null) { playerMedio.Stop(); playerMedio.Play(); }
        }
        catch { }
    }

    private void TogglePanel(int panel)
    {
        if (panel == 1) ColapsadoIzquierda = !ColapsadoIzquierda;
        if (panel == 2) ColapsadoCentro = !ColapsadoCentro;
        if (panel == 3) ColapsadoDerecha = !ColapsadoDerecha;
    }

    public class SeccionEdicionViewModel
    {
        public string Subtitulo { get; set; } = string.Empty;
        public string Contenido { get; set; } = string.Empty;
    }

    private bool cargandoOperacionWod = false;
    private string tituloEdicion = string.Empty;
    private List<SeccionEdicionViewModel> listaSeccionesEdicion = new();

    private async Task AbrirModalEdicionWod()
    {
        if (wodActivo == null) return;

        requiereVertical = true;
        mostrarModalEdicionWod = true;
        try { await JSRuntime.InvokeVoidAsync("setOrientation", "portrait"); } catch { }

        tituloEdicion = wodActivo.Titulo;
        listaSeccionesEdicion.Clear();

        foreach (var seccionDb in wodActivo.Secciones)
        {
            listaSeccionesEdicion.Add(new SeccionEdicionViewModel
            {
                Subtitulo = seccionDb.Subtitulo,
                Contenido = seccionDb.Contenido 
            });
        }

        if (!listaSeccionesEdicion.Any()) AgregarSeccionEdicion();
    }

    private void AgregarSeccionEdicion() => listaSeccionesEdicion.Add(new SeccionEdicionViewModel());
    private void EliminarSeccionEdicion(SeccionEdicionViewModel s) => listaSeccionesEdicion.Remove(s);

    private async Task GuardarWodEditado()
    {
        if (string.IsNullOrWhiteSpace(tituloEdicion))
        {
            Console.WriteLine("El WOD debe tener un título.");
            return;
        }

        cargandoOperacionWod = true;
        StateHasChanged();

        try
        {
            var updateRequest = new ActualizarWodRequest
            {
                Titulo = tituloEdicion,
                Fecha = wodActivo.Fecha, 
                Secciones = new List<WodSeccionDto>(),
                EjerciciosIds = wodActivo.Ejercicios?.Select(e => e.Id).ToList() ?? new List<int>()
            };

            int orden = 1;
            foreach (var secEdit in listaSeccionesEdicion)
            {
                if (string.IsNullOrWhiteSpace(secEdit.Contenido)) continue; 

                updateRequest.Secciones.Add(new WodSeccionDto
                {
                    Subtitulo = secEdit.Subtitulo ?? "",
                    Contenido = secEdit.Contenido.Trim(),
                    Orden = orden++
                });
            }

            var response = await Http.PutAsJsonAsync($"api/wod/{wodActivo.Id}", updateRequest);

            if (response.IsSuccessStatusCode)
            {
                await CargarWodsDelDia(); 
                wodSeleccionadoId = wodActivo.Id; 
                CargarWodSeleccionado(); 

                await CerrarModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al guardar: " + ex.Message);
        }
        finally
        {
            cargandoOperacionWod = false;
            StateHasChanged();
        }
    }

    private async Task AbrirConfiguracionTimer()
    {
        requiereVertical = true;
        mostrarModalConfigTimer = true;
        try { await JSRuntime.InvokeVoidAsync("setOrientation", "portrait"); } catch { }
    }

    private async Task GuardarConfiguracionTimer()
    {
        configTimer.Modo = tempModo;
        configTimer.CuentaRegresivaInicial = tempCuentaRegresiva;
        configTimer.Rondas = tempRondas;
        configTimer.Bloques = tempBloques;

        if (tempModo == "For Time" || tempModo == "AMRAP")
        {
            configTimer.TiempoTrabajoSegundos = (tempTimeCapMin * 60) + tempTimeCapSeg;
            configTimer.Rondas = 1; configTimer.Bloques = 1;
        }
        else if (tempModo == "EMOM")
        {
            configTimer.TiempoTrabajoSegundos = (tempMinTrabajo * 60) + tempSegTrabajo;
            configTimer.Bloques = 1; 
        }
        else if (tempModo == "Intervalos")
        {
            configTimer.TiempoTrabajoSegundos = (tempMinTrabajo * 60) + tempSegTrabajo;
            configTimer.TiempoDescansoSegundos = (tempMinDescanso * 60) + tempSegDescanso;
            configTimer.DescansoEntreBloquesSegundos = (tempMinDescansoBloque * 60) + tempSegDescansoBloque;
        }

        DetenerYResetear();
        await CerrarModal();
    }


@page "/comunidad"

<div class="app-container">
    <div class="feed-content">

        <div class="top-bar" style="margin-bottom: 30px;">
            <h1 class="greeting-title" style="margin: 0; font-size: 1.6rem; text-shadow: 0 0 15px rgba(255,255,255,0.2);">COMUNIDAD</h1>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;">Conecta con tus compañeros.</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">

            <!-- TARJETA RANKING LIKES (Amarillo) -->
            <a href="/comunidad/ranking" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; cursor: pointer; text-decoration: none;">
                <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="#ffbb33" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                <h3 style="color: var(--text-main); font-size: 0.95rem; font-weight: 800; margin-bottom: 5px;">RANKING LIKES</h3>
                <span style="color: #ffbb33; font-weight: 900; font-size: 1.1rem;">@DateTime.Now.Year</span>
            </a>

            <!-- TARJETA LEADERBOARD WOD (Azul) -->
            <a href="/comunidad/rankingwod" class="modern-row" style="flex-direction: column; justify-content: center; text-align: center; padding: 25px 15px; margin: 0; cursor: pointer; text-decoration: none;">
                <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="#33b5e5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px;"><path d="M8 21h8"></path><path d="M12 17v4"></path><path d="M7 4h10"></path><path d="M5 4h14v7a7 7 0 0 1-14 0V4z"></path></svg>
                <h3 style="color: var(--text-main); font-size: 0.95rem; font-weight: 800; margin-bottom: 5px;">LEADERBOARD</h3>
                <span style="color: #33b5e5; font-weight: 900; font-size: 0.8rem; text-transform: uppercase;">Resultados de Hoy</span>
            </a>

            <!-- TARJETA ASISTENCIAS (Verde) - OCUPA LAS DOS COLUMNAS -->
            <a href="/comunidad/ranking-asistencias" class="modern-row" style="grid-column: span 2; flex-direction: column; justify-content: center; text-align: center; padding: 20px 15px; margin: 0; cursor: pointer; text-decoration: none;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><polyline points="9 15 11 17 15 12"></polyline></svg>
                <h3 style="color: var(--text-main); font-size: 0.95rem; font-weight: 800; margin-bottom: 5px;">TOP ASISTENCIAS</h3>
                <span style="color: #00C851; font-weight: 900; font-size: 0.8rem; text-transform: uppercase;">Los más disciplinados</span>
            </a>

        </div>
    </div>

    <!-- Menú Inferior -->
    <nav class="bottom-nav">
        <a href="/inicio" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><span class="nav-text">Inicio</span></a>
        <a href="/acciones" class="nav-item"><img src="images/logo-nomada.png" alt="Nómada" class="nav-logo" /><span class="nav-text">Box</span></a>
        <a href="/comunidad" class="nav-item active"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="nav-text">Comunidad</span></a>
        <a href="/perfil" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="nav-text">Perfil</span></a>
    </nav>
</div>
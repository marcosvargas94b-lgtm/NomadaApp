@page "/"
@using Nomada.Shared.Models
@using System.Net.Http.Json
@using Microsoft.Maui.Storage
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="login-container">
    <div class="login-card" style="border-radius: 20px; padding: 40px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.3); border: 1px solid rgba(128,128,128,0.2);">
        
        <div class="logo-container">
            <img src="images/logo-nomada.png" alt="Nómada Logo" class="logo-img" />
        </div>

        <h2 class="title" style="font-size: 1.4rem; letter-spacing: 3px; margin-bottom: 35px;">INICIAR SESIÓN</h2>

        <!-- Input Correo con SVG interno -->
        <div class="input-group modern-input" style="position: relative; margin-bottom: 25px;">
            <label>Correo Electrónico</label>
            <span style="position: absolute; left: 15px; top: 39px; color: var(--text-muted);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <input type="email" @bind="modelo.Correo" placeholder="atleta@nomada.com" class="search-input" style="padding-left: 45px; border-radius: 12px; margin-top: 5px; box-sizing: border-box;" />
        </div>

        <!-- Input Contraseña con SVG interno -->
        <div class="input-group modern-input" style="position: relative; margin-bottom: 25px;">
            <label>Contraseña</label>
            <span style="position: absolute; left: 15px; top: 39px; color: var(--text-muted);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" @bind="modelo.Password" placeholder="••••••••" class="search-input" style="padding-left: 45px; border-radius: 12px; margin-top: 5px; box-sizing: border-box;" />
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div style="color: #ff4444; font-size: 0.9rem; text-align: center; margin-bottom: 15px; font-weight: bold;">
                @mensajeError
            </div>
        }

        <button class="ink-btn glow-btn" disabled="@isLoading" @onclick="IniciarSesion" style="margin-top: 10px; border-radius: 12px;">
            @if (isLoading)
            {
                <span class="spinner"></span> <span>ENTRANDO...</span>
            }
            else
            {
                <span>EN MOVIMIENTO</span>
            }
        </button>

        <div class="links" style="margin-top: 30px;">
            <a href="/recuperar" style="font-size: 0.85rem;">¿Olvidaste tu contraseña?</a>
            <div class="divider" style="margin: 20px auto;"></div>
            <p class="register-text" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">¿No tienes cuenta?</p>
            <a href="/registro" class="register-link" style="font-size: 0.95rem !important;">CREAR NUEVO USUARIO</a>
        </div>
    </div>
</div>

@code {
    // ESTA ES LA VARIABLE MAESTRA QUE DEFINE PARA QUÉ GIMNASIO ESTÁ COMPILADA ESTA APP
    private readonly string APP_GYM_CODE = "NOMADA"; 

    private LoginRequest modelo = new LoginRequest();
    private bool isLoading = false;
    private string mensajeError = string.Empty;

    protected override void OnInitialized()
    {
        if (Preferences.ContainsKey("userId"))
        {
            NavManager.NavigateTo("/inicio");
        }
    }

    private async Task IniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(modelo.Correo) || string.IsNullOrWhiteSpace(modelo.Password))
        {
            mensajeError = "Ingresa tu correo y contraseña.";
            return;
        }

        // Le inyectamos el código del gimnasio a la petición antes de enviarla
        modelo.GymCode = APP_GYM_CODE;

        isLoading = true;
        mensajeError = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", modelo);
            
            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<LoginResponse>();
                
                if (resultado != null)
                {
                    Preferences.Set("userId", resultado.Id.ToString());
                    Preferences.Set("nombreUsuario", resultado.Nombre);
                    Preferences.Set("rolId", resultado.RolId);
                    
                    // Guardamos el GymCode en memoria para que las demás vistas lo usen
                    Preferences.Set("gymCode", resultado.GymCode); 

                    NavManager.NavigateTo("/inicio");
                }
            }
            else
            {
                mensajeError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginResponse
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; }
        public int RolId { get; set; }
        public string GymCode { get; set; } // Añadimos esto para recibirlo del backend
    }
}
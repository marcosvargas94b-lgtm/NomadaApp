<style>
    .muscle-map-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: visible;
    }

    .muscle-svg {
        width: 100%;
        height: auto;
        max-height: 440px;
        filter: drop-shadow(0 15px 25px rgba(0,0,0,0.5));
    }

        .muscle-svg path {
            transition: fill 0.8s ease, filter 0.8s ease;
        }

    /* Animación de Parpadeo cuando falta el RPE */
    .blinking-map .muscle-svg path {
        animation: pulseMap 1.5s infinite alternate;
    }

    @@keyframes pulseMap {
        0% {
            opacity: 1;
        }

        100% {
            opacity: 0.4;
        }
    }
</style>

@code {
    [Parameter] public string Sexo { get; set; } = "M"; // Recibe 'M' o 'F'
    [Parameter] public bool Parpadear { get; set; } = false; // El padre le dice si debe parpadear
    [Parameter] public List<MusculoRecuperacionDto> Datos { get; set; } = new();

    private string GetColor(string musculo)
    {
        var d = Datos?.FirstOrDefault(m => m.Nombre == musculo);

        if (d == null || d.Porcentaje == 100) return "#969696"; // Gris Carbón (Limpio)
        int p = d.Porcentaje;

        // La matemática inversa: Si la recuperación es 100%, es gris.
        // Si la recuperación es 0%, está destruido (Rojo).
        // 0% a 40% Recuperado (Muy fatigado): Rojo a Naranja
        if (p <= 40) return InterpolateColor(255, 59, 48, 255, 149, 0, p / 40.0);

        // 41% a 80% Recuperado: Naranja a Amarillo
        if (p <= 80) return InterpolateColor(255, 149, 0, 255, 204, 0, (p - 40) / 40.0);

        // 81% a 99% Recuperado: Amarillo a Teal (Casi listo)
        return InterpolateColor(255, 204, 0, 0, 195, 165, (p - 80) / 19.0);
    }

    private string InterpolateColor(int r1, int g1, int b1, int r2, int g2, int b2, double fraction)
    {
        int r = (int)(r1 + (r2 - r1) * fraction);
        int g = (int)(g1 + (g2 - g1) * fraction);
        int b = (int)(b1 + (b2 - b1) * fraction);
        return $"rgb({r}, {g}, {b})";
    }

    private string GetFilter(string musculo)
    {
        var d = Datos?.FirstOrDefault(m => m.Nombre == musculo);
        return (d != null && d.Porcentaje < 100) ? "url(#glow)" : "none";
    }
}
@page "/comunidad/ranking-asistencias"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content">

        <!-- HEADER CON SELECTOR DE AÑO -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px;">
            <div style="display: flex; align-items: center;">
                <button class="back-btn" @onclick='() => NavManager.NavigateTo("/comunidad")' style="background: none; border: none; color: var(--text-main); margin-right: 15px; cursor: pointer; padding: 0;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                </button>
                <h2 class="greeting-title" style="margin: 0; font-size: 1.4rem;">Constancia</h2>
            </div>

            <!-- EL SELECT DE HISTORIAL -->
            <select class="search-input" style="font-weight: 900; color: #00C851; border-color: #00C851; font-size: 0.95rem; width: auto; padding: 5px 10px;" @bind="anioSeleccionado" @bind:after="CargarRanking">
                @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 4; year--)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else if (!ranking.Any())
        {
            <div style="text-align: center; padding: 50px 20px;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><polyline points="9 15 11 17 15 12"></polyline></svg>
                <p style="color: var(--text-muted); font-weight: bold;">No hay asistencias registradas para el año @anioSeleccionado.</p>
            </div>
        }
        else
        {
            <!-- ================= TOP 3 (Podium Estilizado) ================= -->
            <div class="podium-container" style="display: flex; justify-content: center; align-items: flex-end; gap: 10px; margin-bottom: 40px; margin-top: 20px;">

                <!-- PLATA (Posición 2) -->
                @if (ranking.Count > 1)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 30%;">
                        <div class="user-avatar" style="width: 50px; height: 50px; margin: 0 0 10px 0; border: 3px solid #C0C0C0; box-shadow: 0 0 15px rgba(192, 192, 192, 0.5); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #222;">
                            @if (!string.IsNullOrEmpty(ranking[1].FotoPerfil))
                            {
                                <img src="@ranking[1].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {

                                <span style="font-weight: 800; font-size: 1rem; color: #fff;">@ranking[1].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.75rem; font-weight: 800; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[1].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 0.8rem; font-weight: 900;">@ranking[1].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.65rem; font-weight: 800;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #e0e0e0, #a0a0a0); width: 100%; height: 60px; border-top-left-radius: 8px; border-top-right-radius: 8px; display: flex; justify-content: center; align-items: flex-start; padding-top: 10px;">
                            <span style="color: black; font-weight: 900; font-size: 1.2rem;">2</span>
                        </div>
                    </div>
                }

                <!-- ORO (Posición 1) -->
                @if (ranking.Count > 0)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 34%; z-index: 10;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFD700" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 5px; filter: drop-shadow(0 0 8px rgba(255,215,0,0.8));"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>

                        <div class="user-avatar" style="width: 65px; height: 65px; margin: 0 0 10px 0; border: 4px solid #FFD700; box-shadow: 0 0 20px rgba(255, 215, 0, 0.6); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #222;">
                            @if (!string.IsNullOrEmpty(ranking[0].FotoPerfil))
                            {
                                <img src="@ranking[0].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {

                                <span style="font-weight: 900; font-size: 1.2rem; color: #fff;">@ranking[0].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.85rem; font-weight: 900; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[0].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 0.9rem; font-weight: 900;">@ranking[0].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.7rem; font-weight: 800;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #ffe066, #ffb300); width: 100%; height: 90px; border-top-left-radius: 8px; border-top-right-radius: 8px; display: flex; justify-content: center; align-items: flex-start; padding-top: 10px; box-shadow: 0 -5px 15px rgba(255, 215, 0, 0.3);">
                            <span style="color: black; font-weight: 900; font-size: 1.5rem;">1</span>
                        </div>
                    </div>
                }

                <!-- BRONCE (Posición 3) -->
                @if (ranking.Count > 2)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 30%;">
                        <div class="user-avatar" style="width: 45px; height: 45px; margin: 0 0 10px 0; border: 3px solid #CD7F32; box-shadow: 0 0 15px rgba(205, 127, 50, 0.5); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #222;">
                            @if (!string.IsNullOrEmpty(ranking[2].FotoPerfil))
                            {
                                <img src="@ranking[2].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {

                                <span style="font-weight: 800; font-size: 0.9rem; color: #fff;">@ranking[2].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.75rem; font-weight: 800; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[2].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 0.8rem; font-weight: 900;">@ranking[2].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.65rem; font-weight: 800;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #e6a87c, #b36b39); width: 100%; height: 45px; border-top-left-radius: 8px; border-top-right-radius: 8px; display: flex; justify-content: center; align-items: flex-start; padding-top: 10px;">
                            <span style="color: black; font-weight: 900; font-size: 1rem;">3</span>
                        </div>
                    </div>
                }
            </div>

            <!-- ================= RESTO DE USUARIOS (Del 4 en adelante) ================= -->
            @if (ranking.Count > 3)
            {
                <div class="user-list">
                    @for (int i = 3; i < ranking.Count; i++)
                    {
                        var user = ranking[i];
                        <div class="modern-row" style="padding: 12px 20px; margin-bottom: 12px; display: flex; align-items: center;">
                            <span style="font-weight: 900; color: var(--text-muted); width: 25px; text-align: center; flex-shrink: 0;">@user.Posicion</span>

                            <div class="user-avatar" style="width: 35px; height: 35px; border-radius: 50%; margin: 0 15px; background: rgba(128,128,128,0.1); border: 1px solid rgba(128,128,128,0.2); overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(user.FotoPerfil))
                                {
                                    <img src="@user.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {

                                    <span style="font-size: 0.75rem; font-weight: bold; color: white;">@user.Iniciales</span>
                                }
                            </div>

                            <span class="user-name" style="flex: 1; font-size: 0.95rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Nombre @user.ApellidoPaterno</span>

                            <div style="display: flex; align-items: center; gap: 5px; flex-shrink: 0; margin-left: 10px;">
                                <span style="font-weight: 900; color: #00C851; font-size: 1rem;">@user.TotalAsistencias</span>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Frase Motivacional -->
            <div style="text-align: center; margin-top: 40px; padding: 20px; border-top: 1px solid rgba(128,128,128,0.2);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><polyline points="9 15 11 17 15 12"></polyline></svg>
                <p style="color: var(--text-main); font-weight: 800; font-size: 0.95rem; margin-bottom: 5px;">La constancia es la clave</p>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5;">El resultado se construye día con día. ¡Sigue viniendo a entrenar y asegura tu lugar en el top!</p>
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&family=Orbitron:wght@700;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }
</style>

@code {
    private string gymCode = "NOMADA";

    private bool isPageLoading = true;
    private int anioSeleccionado = DateTime.Now.Year;
    private List<RankingAsistenciaDto> ranking = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarRanking();
    }

    private async Task CargarRanking()
    {
        isPageLoading = true;
        try
        {
            ranking = await Http.GetFromJsonAsync<List<RankingAsistenciaDto>>($"api/comunidad/{gymCode}/ranking-asistencias/{anioSeleccionado}") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }
}
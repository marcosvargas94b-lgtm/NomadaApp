@page "/comunidad/ranking-asistencias"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/comunidad")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">CONSTANCIA</h2>
        </div>

        <!-- EL SELECT DE HISTORIAL -->
        <div class="fade-in-up" style="display: flex; justify-content: center; margin-bottom: 30px;">
            <select class="search-input" style="font-weight: 900; color: #00C851; background: rgba(0, 200, 81, 0.05); border-color: rgba(0, 200, 81, 0.3); font-size: 1rem; width: auto; padding: 8px 20px; border-radius: 12px; outline: none; box-shadow: 0 4px 15px rgba(0,200,81,0.1);" @bind="anioSeleccionado" @bind:after="CargarRanking">
                @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 4; year--)
                {
                    <option value="@year" style="color: black;">Ranking @year</option>
                }
            </select>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #00C851;"></span></div>
        }
        else if (!ranking.Any())
        {
            <div class="fade-in-up" style="text-align: center; padding: 50px 20px; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2); margin: 0 15px;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><polyline points="9 15 11 17 15 12"></polyline></svg>
                <p style="color: var(--text-muted); font-weight: 800; margin: 0; font-size: 0.95rem;">No hay asistencias registradas para el año @anioSeleccionado.</p>
            </div>
        }
        else
        {
            <!-- ================= TOP 3 (Podium Estilizado) ================= -->
            <div class="podium-container fade-in-up" style="display: flex; justify-content: center; align-items: flex-end; gap: 12px; margin-bottom: 45px; margin-top: 25px;">

                <!-- PLATA (Posición 2) -->
                @if (ranking.Count > 1)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 30%;">
                        <div class="user-avatar" style="width: 50px; height: 50px; margin: 0 0 10px 0; border: 3px solid #C0C0C0; box-shadow: 0 0 15px rgba(192, 192, 192, 0.4); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--card-bg);">
                            @if (!string.IsNullOrEmpty(ranking[1].FotoPerfil))
                            {
                                <img src="@ranking[1].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-weight: 900; font-size: 1rem; color: var(--text-muted);">@ranking[1].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.8rem; font-weight: 900; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[1].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 0.9rem; font-weight: 900;">@ranking[1].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.65rem; font-weight: 800; text-transform: uppercase;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #e0e0e0, #a0a0a0); width: 100%; height: 65px; border-radius: 12px 12px 0 0; display: flex; justify-content: center; align-items: flex-start; padding-top: 12px; box-shadow: inset 0 2px 5px rgba(255,255,255,0.5);">
                            <span style="color: #333; font-weight: 900; font-size: 1.3rem;">2</span>
                        </div>
                    </div>
                }

                <!-- ORO (Posición 1) -->
                @if (ranking.Count > 0)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 34%; z-index: 10;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFD700" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px; filter: drop-shadow(0 0 10px rgba(255,215,0,0.6));"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>

                        <div class="user-avatar" style="width: 70px; height: 70px; margin: 0 0 10px 0; border: 4px solid #FFD700; box-shadow: 0 0 25px rgba(255, 215, 0, 0.5); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--card-bg);">
                            @if (!string.IsNullOrEmpty(ranking[0].FotoPerfil))
                            {
                                <img src="@ranking[0].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-weight: 900; font-size: 1.3rem; color: var(--text-muted);">@ranking[0].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.9rem; font-weight: 900; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[0].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 1rem; font-weight: 900;">@ranking[0].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.7rem; font-weight: 800; text-transform: uppercase;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #ffe066, #ffb300); width: 100%; height: 100px; border-radius: 12px 12px 0 0; display: flex; justify-content: center; align-items: flex-start; padding-top: 15px; box-shadow: inset 0 2px 5px rgba(255,255,255,0.6), 0 -5px 20px rgba(255, 215, 0, 0.2);">
                            <span style="color: #333; font-weight: 900; font-size: 1.6rem;">1</span>
                        </div>
                    </div>
                }

                <!-- BRONCE (Posición 3) -->
                @if (ranking.Count > 2)
                {
                    <div class="podium-step" style="display: flex; flex-direction: column; align-items: center; width: 30%;">
                        <div class="user-avatar" style="width: 45px; height: 45px; margin: 0 0 10px 0; border: 3px solid #CD7F32; box-shadow: 0 0 15px rgba(205, 127, 50, 0.4); border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--card-bg);">
                            @if (!string.IsNullOrEmpty(ranking[2].FotoPerfil))
                            {
                                <img src="@ranking[2].FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-weight: 900; font-size: 0.9rem; color: var(--text-muted);">@ranking[2].Iniciales</span>
                            }
                        </div>
                        <span style="color: var(--text-main); font-size: 0.75rem; font-weight: 900; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;">@ranking[2].Nombre</span>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
                            <span style="color: #00C851; font-size: 0.85rem; font-weight: 900;">@ranking[2].TotalAsistencias</span>
                            <span style="color: var(--text-muted); font-size: 0.65rem; font-weight: 800; text-transform: uppercase;">Clases</span>
                        </div>
                        <div style="background: linear-gradient(180deg, #e6a87c, #b36b39); width: 100%; height: 50px; border-radius: 12px 12px 0 0; display: flex; justify-content: center; align-items: flex-start; padding-top: 10px; box-shadow: inset 0 2px 5px rgba(255,255,255,0.4);">
                            <span style="color: #333; font-weight: 900; font-size: 1.1rem;">3</span>
                        </div>
                    </div>
                }
            </div>

            <!-- ================= RESTO DE USUARIOS (Del 4 en adelante) ================= -->
            @if (ranking.Count > 3)
            {
                <div class="user-list fade-in-up" style="animation-delay: 0.2s; padding: 0 15px;">
                    @for (int i = 3; i < ranking.Count; i++)
                    {
                        var user = ranking[i];
                        <div class="modern-row" style="padding: 12px 20px; margin-bottom: 12px; display: flex; align-items: center; background: var(--card-bg); border: 1px solid rgba(128,128,128,0.15);">
                            <span style="font-weight: 900; color: var(--text-muted); width: 25px; text-align: center; flex-shrink: 0;">@user.Posicion</span>

                            <div class="user-avatar" style="width: 35px; height: 35px; border-radius: 50%; margin: 0 15px; background: rgba(128,128,128,0.1); border: 1px solid rgba(128,128,128,0.2); overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(user.FotoPerfil))
                                {
                                    <img src="@user.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span style="font-size: 0.75rem; font-weight: 900; color: var(--text-muted);">@user.Iniciales</span>
                                }
                            </div>

                            <span class="user-name" style="flex: 1; font-size: 0.95rem; font-weight: 800; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Nombre @user.ApellidoPaterno</span>

                            <div style="display: flex; align-items: center; gap: 5px; flex-shrink: 0; margin-left: 10px;">
                                <span style="font-weight: 900; color: #00C851; font-size: 1.05rem;">@user.TotalAsistencias</span>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Frase Motivacional -->
            <div class="fade-in-up" style="text-align: center; margin-top: 40px; padding: 25px 20px; border-top: 1px dashed rgba(128,128,128,0.2); animation-delay: 0.3s;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><polyline points="9 15 11 17 15 12"></polyline></svg>
                <p style="color: var(--text-main); font-weight: 900; font-size: 1rem; margin-bottom: 8px; text-transform: uppercase;">La constancia es la clave</p>
                <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; font-weight: 600; max-width: 300px; margin: 0 auto;">El resultado se construye día con día. ¡Sigue viniendo a entrenar y asegura tu lugar en el top!</p>
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";

    private bool isPageLoading = true;
    private int anioSeleccionado = DateTime.Now.Year;
    private List<RankingAsistenciaDto> ranking = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarRanking();
    }

    private async Task CargarRanking()
    {
        isPageLoading = true;
        try
        {
            ranking = await Http.GetFromJsonAsync<List<RankingAsistenciaDto>>($"api/comunidad/{gymCode}/ranking-asistencias/{anioSeleccionado}") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }
}
@page "/admin/personalizado/{AtletaId:guid}"
@using Nomada.Shared.Entities
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ENCABEZADO -->
        <div style="display: flex; align-items: center; margin-bottom: 25px;">
            <a href="/admin/tribu" style="color: var(--text-main); margin-right: 15px; display: flex; align-items: center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </a>
            <div>
                <h2 class="greeting-title" style="margin: 0; font-size: 1.4rem;">PROGRAMACIÓN PRO</h2>
                <span style="color: #33b5e5; font-size: 0.85rem; font-weight: 800; text-transform: uppercase;">ATLETA: @nombreAtleta</span>
            </div>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else
        {
            <!-- ================= FORMULARIO CREADOR ================= -->
            <div class="fade-in-up">
                
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div style="background: rgba(255,68,68,0.1); border: 1px solid rgba(255,68,68,0.3); color: #ff4444; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-size: 0.85rem; font-weight: 800; text-align: center;">
                        @mensajeError
                    </div>
                }

                <input type="text" @bind="request.Titulo" placeholder="Título de la rutina (Ej. Fuerza de Pierna + Cardio)" class="search-input" style="font-size: 1.1rem; font-weight: 900; margin-bottom: 20px; border-color: #33b5e5;" />

                <!-- SECCIONES DINÁMICAS -->
                @foreach (var seccion in request.Secciones)
                {
                    <div class="modern-row" style="flex-direction: column; padding: 15px; margin-bottom: 15px; border-left: 4px solid #33b5e5;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 10px;">
                            <input type="text" @bind="seccion.Subtitulo" placeholder="Subtítulo (Ej. WARMUP)"
                                   class="search-input" style="flex: 1; padding: 10px 15px; margin: 0; font-size: 0.95rem; font-weight: 800; color: #33b5e5;" />

                            <button style="background: none; border: none; color: #ff4444; padding: 10px; cursor: pointer; flex-shrink: 0;" @onclick="() => RemoverSeccion(seccion)">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                        <textarea @bind="seccion.Contenido" placeholder="Ej.10 DU;3 Rondas x 5 Pull-ups ;10 Squats x 3 ;15 Push-ups" class="search-input" style="min-height: 100px; resize: none; font-size: 0.95rem; line-height: 1.5; font-weight: 600;"></textarea>
                    </div>
                }

                <button class="ink-btn-outline" style="border-style: dashed; border-color: var(--text-muted); color: var(--text-main); margin-bottom: 25px;" @onclick="AgregarSeccion">
                    + AGREGAR SECCIÓN
                </button>

                <!-- CATÁLOGO DE VIDEOS -->
                <div class="modern-row" style="flex-direction: column; padding: 20px; margin-bottom: 25px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">Movimientos (@request.EjerciciosIds.Count)</span>
                        <button class="ink-btn glow-btn" style="margin: 0; margin-left:10px; padding: 5px 15px; font-size: 0.75rem; width: auto; background-color: #333;" @onclick="AbrirCatalogo">CATÁLOGO</button>
                    </div>
                    @if (request.EjerciciosIds.Any())
                    {
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                            @foreach (var id in request.EjerciciosIds)
                            {
                                var ej = catalogo.FirstOrDefault(c => c.Id == id);
                                if (ej != null)
                                {
                                    <span style="background: rgba(51,181,229,0.1); color: #33b5e5; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700;">@ej.Nombre</span>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 700;">No has anexado referencias a esta rutina.</span>
                    }
                </div>

              <div style="display: flex; gap: 10px; margin-bottom: 40px;">
                    @if (modoEdicion)
                    {
                        <button class="ink-btn-outline" style="flex: 1; border-color: var(--text-muted); color: var(--text-main);" @onclick="CancelarEdicion" disabled="@isSaving">
                            CANCELAR
                        </button>
                    }
                    
                    <button class="ink-btn glow-btn" @onclick="GuardarRutina" disabled="@isSaving" style="flex: 1; background: linear-gradient(135deg, #33b5e5, #0099CC);">
                        @if (isSaving)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <span>@(modoEdicion ? "ACTUALIZAR RUTINA" : "ASIGNAR ENTRENAMIENTO")</span>
                        }
                    </button>
                </div>

                <!-- ================= HISTORIAL DEL ATLETA ================= -->
                <div>
                    <h4 style="color: white; font-weight: 900; font-size: 1rem; margin-bottom: 15px; text-transform: uppercase; border-left: 4px solid #00C851; padding-left: 10px;">
                        HISTORIAL DE RUTINAS
                    </h4>

                    @if (!historial.Any())
                    {
                        <div style="text-align: center; padding: 30px; opacity: 0.5;">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <p>No hay rutinas previas para este atleta.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var rutina in historial)
                        {
                            <div class="modern-row" style="display: flex; align-items: center; justify-content: space-between; padding: 15px; margin-bottom: 10px;">
                                <div style="flex: 1; overflow: hidden; margin-right: 10px;">
                                    <h4 style="color: white; font-weight: 800; font-size: 0.95rem; margin: 0 0 5px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@rutina.Titulo</h4>
                                    <span style="color: var(--text-muted); font-size: 0.75rem;">Creado: @rutina.FechaCreacion.ToString("dd MMM yyyy")</span>
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center; flex-shrink: 0;">
                                    @if (rutina.RealizadoHoy)
                                    {
                                        <span style="background: rgba(0, 200, 81, 0.1); color: #00C851; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 800; border: 1px solid rgba(0,200,81,0.3);">COMPLETADO</span>
                                    }
                                    else
                                    {
                                        <span style="background: rgba(255, 255, 255, 0.05); color: #aaa; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 800;">PENDIENTE</span>
                                    }

                                    <!-- Botones de Acción -->
                                    <button style="background: rgba(51,181,229,0.1); border: none; color: #33b5e5; padding: 8px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center;" @onclick="() => CargarParaEdicion(rutina.Id)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button style="background: rgba(255,68,68,0.1); border: none; color: #ff4444; padding: 8px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center;" @onclick="() => EliminarRutina(rutina.Id)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <!-- ====================================================================== -->
    <!-- MODAL: CATÁLOGO DE EJERCICIOS (CON AZURE BLOB STORAGE)                 -->
    <!-- ====================================================================== -->
    @if (mostrarModalCatalogo)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; display: flex; justify-content: center; align-items: center; padding: 20px;">
            <div class="fade-in-up" style="width: 100%; max-width: 500px; max-height: 85vh; border-radius: 20px; padding: 25px 20px; flex-direction: column; overflow-y: auto; background-color: #1a1a1a; box-shadow: 0 10px 40px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1);">

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 style="color: white; font-size: 1.2rem; font-weight: 900; margin: 0;">Catálogo de Movimientos</h3>
                    <button style="background: none; border: none; color: #aaa; padding: 5px; cursor: pointer;" @onclick="() => mostrarModalCatalogo = false">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>

                <!-- SUBIDA DE ARCHIVO A AZURE -->
                <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px; margin-bottom: 20px; border: 1px dashed rgba(255,255,255,0.2);">
                    <input type="text" @bind="nuevoEjNombre" placeholder="Nombre (Ej. Bar Muscle Up)" class="search-input" style="margin-bottom: 10px; font-size: 0.9rem; background-color: rgba(0,0,0,0.2); color: white;" />
                    
                    <label class="ink-btn-outline" style="margin: 0 0 10px 0; border-color: rgba(255,255,255,0.5); color: white; display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer;">
                        <InputFile OnChange="SeleccionarVideo" accept="video/*" style="display: none;" />
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        SELECCIONAR VIDEO
                    </label>

                    @if (!string.IsNullOrEmpty(nombreVideoSeleccionado))
                    {
                        <span style="color: #00C851; font-size: 0.75rem; display: block; margin-bottom: 10px; text-align: center;">Archivo: @nombreVideoSeleccionado</span>
                    }

                    <button class="ink-btn glow-btn" style="margin: 0; padding: 10px; background: #33b5e5; font-size: 0.8rem;" @onclick="SubirVideoAzure" disabled="@isUploadingVideo">
                        @if (isUploadingVideo)
                        {
                            <span class="spinner" style="width: 14px; height: 14px;"></span> <span> SUBIENDO A LA NUBE...</span>
                        }
                        else
                        {
                            <span>GUARDAR EN CATÁLOGO</span>
                        }
                    </button>
                </div>

                @if (catalogo.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var ej in catalogo)
                        {
                            bool estaSeleccionado = request.EjerciciosIds.Contains(ej.Id);
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-radius: 12px; border: 1px solid @(estaSeleccionado ? "#00C851" : "rgba(255,255,255,0.1)"); background: @(estaSeleccionado ? "rgba(0,200,81,0.1)" : "transparent");">
                                <div style="flex: 1; cursor: pointer;" @onclick="() => ToggleSeleccionEjercicio(ej.Id)">
                                    <span style="color: white; font-weight: 800; font-size: 0.9rem; display: block;">@ej.Nombre</span>
                                </div>
                                <div style="display: flex; gap: 10px;">
                                    <button style="background: none; border: none; color: #ff4444; cursor: pointer; padding: 5px;" @onclick="() => EliminarDelCatalogo(ej.Id)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid AtletaId { get; set; }

    private string gymCode = "NOMADA";
    private Guid coachId;
    private string nombreAtleta = "Cargando...";
    private string mensajeError = "";
    private bool isPageLoading = true;
    private bool isSaving = false;

    // Modelos limpios
    private CrearWodPersonalizadoRequest request = new();
    private List<EjercicioDto> catalogo = new();
    private List<RutinaAtletaResumenDto> historial = new();

    // Catálogo Variables
    private bool mostrarModalCatalogo = false;
    private string nuevoEjNombre = "";
    private IBrowserFile? videoSeleccionado;
    private string nombreVideoSeleccionado = "";
    private bool isUploadingVideo = false;
    // --- VARIABLES DE EDICIÓN ---
    private bool modoEdicion = false;
    private int rutinaEditandoId = 0;

    // --- CLASE TEMPORAL PARA DESERIALIZAR DETALLE ---
    private class DetalleRutinaDto
    {
        public string Titulo { get; set; } = string.Empty;
        public List<WodSeccionDto> Secciones { get; set; } = new();
        public List<EjercicioDto> Ejercicios { get; set; } = new();
    }

    private async Task CargarParaEdicion(int id)
    {
        try
        {
            // Usamos el mismo endpoint que consume el atleta para ver sus detalles
            var detalle = await Http.GetFromJsonAsync<DetalleRutinaDto>($"api/personalizados/detalle/{id}");
            if (detalle != null)
            {
                modoEdicion = true;
                rutinaEditandoId = id;
                request.Titulo = detalle.Titulo;
                
                request.Secciones = detalle.Secciones.Select(s => new WodSeccionDto 
                { 
                    Subtitulo = s.Subtitulo, Contenido = s.Contenido, Orden = s.Orden 
                }).ToList();
                
                request.EjerciciosIds = detalle.Ejercicios.Select(e => e.Id).ToList();
                
                // Desplazamos la vista hacia arriba
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al cargar la rutina: " + ex.Message;
        }
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        rutinaEditandoId = 0;
        request.Titulo = "";
        request.Secciones.Clear();
        request.EjerciciosIds.Clear();
        AgregarSeccion();
    }

    private async Task EliminarRutina(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/personalizados/{id}");
            if (res.IsSuccessStatusCode)
            {
                await CargarHistorial();
            }
        }
        catch { }
    }

    // ================= GUARDADO FINAL (CREAR Y ACTUALIZAR) =================
    private async Task GuardarRutina()
    {
        mensajeError = "";

        if (string.IsNullOrWhiteSpace(request.Titulo))
        {
            mensajeError = "Por favor, ponle un título a la rutina.";
            return;
        }

        if (!request.Secciones.Any(s => !string.IsNullOrWhiteSpace(s.Contenido)))
        {
            mensajeError = "La rutina debe tener al menos una sección con contenido.";
            return;
        }

        isSaving = true;

        try
        {
            HttpResponseMessage res;

            if (modoEdicion)
            {
                var updateRequest = new ActualizarWodPersonalizadoRequest
                {
                    Titulo = request.Titulo,
                    Secciones = request.Secciones.Where(s => !string.IsNullOrWhiteSpace(s.Contenido)).ToList(),
                    EjerciciosIds = request.EjerciciosIds
                };
                res = await Http.PutAsJsonAsync($"api/personalizados/{rutinaEditandoId}", updateRequest);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/personalizados", request);
            }
            
            if (res.IsSuccessStatusCode)
            {
                CancelarEdicion(); // Limpia todo el form
                await CargarHistorial();
            }
            else
            {
                mensajeError = $"Error del servidor: {await res.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de red: " + ex.Message;
        }
        finally 
        { 
            isSaving = false; 
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);
        Guid.TryParse(userIdStr, out coachId);

        // Preparamos el Request
        request.GymCode = gymCode;
        request.CoachId = coachId;
        request.AtletaId = AtletaId;

        // Agregamos una sección por defecto
        AgregarSeccion();

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isPageLoading = true;

        // ==============================================================
        // 1. OBTENER NOMBRE (Aislado para que no rompa lo demás si falla)
        // ==============================================================
        try
        {
            var perfil = await Http.GetFromJsonAsync<Usuario>($"api/personalizados/{gymCode}/usuario/{AtletaId}");
            if (perfil != null) 
            {
                nombreAtleta = $"{perfil.Nombre} {perfil.ApellidoPaterno}".Trim();
            }
        }
        catch
        {
            // Si la ruta del usuario falla, le ponemos un nombre por defecto
            nombreAtleta = "ATLETA SELECCIONADO";
        }

        // ==============================================================
        // 2. OBTENER CATÁLOGO E HISTORIAL (Tienen sus propios try-catch)
        // ==============================================================
        await CargarCatalogo();
        await CargarHistorial();

        isPageLoading = false;
        StateHasChanged();
    }

    private async Task CargarCatalogo()
    {
        try 
        { 
            catalogo = await Http.GetFromJsonAsync<List<EjercicioDto>>($"api/wod/{gymCode}/catalogo") ?? new(); 
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar catálogo: " + ex.Message);
        }
    }

    private async Task CargarHistorial()
    {
        try
        {
            historial = await Http.GetFromJsonAsync<List<RutinaAtletaResumenDto>>($"api/personalizados/{gymCode}/atleta/{AtletaId}") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar historial: " + ex.Message);
        }
    }

    private void AgregarSeccion()
    {
        request.Secciones.Add(new WodSeccionDto { Orden = request.Secciones.Count + 1 });
    }

    private void RemoverSeccion(WodSeccionDto s)
    {
        request.Secciones.Remove(s);
        // Reordenar
        for (int i = 0; i < request.Secciones.Count; i++)
        {
            request.Secciones[i].Orden = i + 1;
        }
    }

    // ================= MÉTODOS DEL CATÁLOGO =================
    private void AbrirCatalogo()
    {
        mostrarModalCatalogo = true;
    }

    private void ToggleSeleccionEjercicio(int id)
    {
        if (request.EjerciciosIds.Contains(id)) request.EjerciciosIds.Remove(id);
        else request.EjerciciosIds.Add(id);
    }

    private void SeleccionarVideo(InputFileChangeEventArgs e)
    {
        videoSeleccionado = e.File;
        nombreVideoSeleccionado = e.File.Name;
    }

    private async Task SubirVideoAzure()
    {
        if (string.IsNullOrWhiteSpace(nuevoEjNombre) || videoSeleccionado == null) return;
        
        isUploadingVideo = true;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(gymCode), "gymCode");
            content.Add(new StringContent(nuevoEjNombre), "nombre");

            long maxAllowedSize = 500L * 1024 * 1024;
            using var stream = videoSeleccionado.OpenReadStream(maxAllowedSize);
            
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(videoSeleccionado.ContentType);
            
            content.Add(fileContent, "video", videoSeleccionado.Name);

            var res = await Http.PostAsync("api/wod/catalogo/subir-video", content);
            
            if (res.IsSuccessStatusCode)
            {
                nuevoEjNombre = "";
                videoSeleccionado = null;
                nombreVideoSeleccionado = "";
                await CargarCatalogo();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al subir video: " + ex.Message);
        }
        finally
        {
            isUploadingVideo = false;
        }
    }

    private async Task EliminarDelCatalogo(int id)
    {
        try
        {
            await Http.DeleteAsync($"api/wod/catalogo/{id}");
            request.EjerciciosIds.Remove(id);
            await CargarCatalogo();
        }
        catch { }
    }

   
}
@page "/resumen-clase"
@using Nomada.Shared.Models
@using Nomada.Shared.Entities
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

@if (!mostrarPodium)
{
    <div class="resumen-container font-modern">
        <!-- HEADER -->
        <div class="resumen-header">
            <button class="back-btn" @onclick="VolverAlTimer">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 style="margin: 0; font-weight: 900; color: white; font-size: 1.2rem; letter-spacing: 1px;">RESUMEN DE CLASE</h2>
            <div style="width: 24px;"></div>
        </div>

        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px;"></span>
                <p style="margin-top: 20px; color: #888; font-weight: 800;">PROCESANDO DATOS...</p>
            </div>
        }
        else
        {
            <!-- TABS DE MODOS (Sin emojis) -->
            <div class="tabs-container">
                <button class="tab-btn @(tabActiva == "Asistencia" ? "active" : "")" @onclick='() => tabActiva = "Asistencia"'>ASIST</button>
                <button class="tab-btn @(tabActiva == "Tiempo" ? "active" : "")" @onclick='() => tabActiva = "Tiempo"'>TIEMPO</button>
                <button class="tab-btn @(tabActiva == "Rondas" ? "active" : "")" @onclick='() => tabActiva = "Rondas"'>RONDAS</button>
                <button class="tab-btn @(tabActiva == "Reps" ? "active" : "")" @onclick='() => tabActiva = "Reps"'>REPS</button>
            </div>

            @if (tabActiva != "Asistencia")
            {
                <!-- SWITCH CATEGORÍAS -->
                <div class="config-row-switch">
                    <div>
                        <span style="display: block; font-weight: 800; color: white; font-size: 0.9rem;">ESPECIFICAR CATEGORÍAS</span>
                        <span style="display: block; color: #888; font-size: 0.75rem;">Permitir asignar Rx, Avanzado, etc.</span>
                    </div>
                    <label class="switch-juez">
                        <input type="checkbox" @bind="habilitarCategorias">
                        <span class="slider-juez round"></span>
                    </label>
                </div>

                <!-- SWITCH CAPTURA MANUAL -->
                <div class="config-row-switch" style="border-top: 1px solid rgba(255,255,255,0.02);">
                    <div>
                        <span style="display: block; font-weight: 800; color: #00C851; font-size: 0.9rem;">CAPTURA MANUAL</span>
                        <span style="display: block; color: #888; font-size: 0.75rem;">Los atletas subirán su score en la app</span>
                    </div>
                    <label class="switch-juez">
                        <input type="checkbox" @bind="capturaManualGlobal">
                        <span class="slider-juez round" style="background-color: @(capturaManualGlobal ? "#00C851" : "rgba(255,255,255,0.1)");"></span>
                    </label>
                </div>
            }

            <!-- LISTA DE ATLETAS -->
            <div class="atletas-list scroll-custom">
                @if (atletas.Any())
                {
                    @foreach (var atleta in atletas)
                    {
                        <div class="atleta-score-card">
                            <div class="atleta-info-area">
                                <div class="avatar-sm">
                                    @if (!string.IsNullOrEmpty(atleta.FotoPerfil))
                                    {
                                        <img src="@atleta.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {

                                        <span style="font-size: 1.2rem; color: #888;">👤</span>
                                    }
                                </div>
                                <div class="name-area">
                                    <span class="name">@atleta.Nombre</span>
                                    <span class="surname">@atleta.ApellidoPaterno</span>

                                    @if (tabActiva != "Asistencia" && habilitarCategorias)
                                    {
                                        <div style="margin-top: 5px;">
                                            <select class="cat-select" @bind="atleta.CategoriaSeleccionada">
                                                <option value="General">+ Categoría</option>
                                                <option value="Rx" style="color: #ffbb33; font-weight: bold;">🔥 Rx</option>
                                                <option value="Avanzado">Avanzado</option>
                                                <option value="Intermedio">Intermedio</option>
                                                <option value="Principiante">Principiante</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="score-input-area">
                                @if (tabActiva == "Asistencia")
                                {
                                    <span style="color: #00C851; font-weight: 900; font-size: 0.9rem;">PRESENTE</span>
                                }
                                else if (capturaManualGlobal)
                                {
                                    <span style="color: #33b5e5; font-weight: 800; font-size: 0.75rem; text-align: right;">Pendiente<br />de captura</span>
                                }
                                else if (tabActiva == "Tiempo")
                                {
                                    <input type="text" @bind="atleta.TiempoFinal" class="ink-input-score font-digital" placeholder="00:00" />
                                }
                                else if (tabActiva == "Rondas")
                                {
                                    <div style="display: flex; align-items: center; gap: 5px;">
                                        <input type="number" @bind="atleta.Rondas" class="ink-input-score" placeholder="Rnds" style="width: 55px;" min="0" />
                                        <span style="color: #888; font-weight: bold;">+</span>
                                        <input type="number" @bind="atleta.Reps" class="ink-input-score" placeholder="Reps" style="width: 55px;" min="0" />
                                    </div>
                                }
                                else if (tabActiva == "Reps")
                                {
                                    <input type="number" @bind="atleta.RepsTotales" class="ink-input-score" placeholder="Total Reps" style="width: 80px;" min="0" />
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: #888;">No hay atletas en esta clase.</div>
                }
            </div>

            <!-- BOTÓN INFERIOR (Simple o Hold-to-process) -->
            <div class="bottom-action-area">
                @if (tabActiva == "Asistencia" || capturaManualGlobal)
                {
                    <!-- Botón normal de guardado rápido -->
                    <button class="ink-btn bg-blue" style="width: 100%; padding: 18px; font-weight: 900; font-size: 1.1rem; letter-spacing: 1px;" @onclick="ProcesarClaseSimple" disabled="@isProcesando">
                        @if (isProcesando)
                        {
                            <span class="spinner" style="width: 20px; height: 20px; border-width: 3px;"></span>
                        }
                        else
                        {

                            <span>FINALIZAR CLASE</span>
                        }
                    </button>
                }
                else
                {
                    <!-- Botón de Mantener Presionado -->
                    <button class="hold-to-process-btn @(isHolding ? "holding" : "")"
                            oncontextmenu="return false;"
                            @onmousedown="StartHold" @onmouseup="EndHold" @onmouseleave="EndHold"
                            @ontouchstart="StartHold" @ontouchend="EndHold"
                            disabled="@isProcesando">
                        @if (isProcesando)
                        {
                            <span class="spinner" style="width: 20px; height: 20px; border-width: 3px; position: relative; z-index: 2;"></span>
                        }
                        else
                        {
                            <span style="position: relative; z-index: 2;">MANTÉN PRESIONADO PARA CLASIFICAR</span>
                        }
                        <div class="hold-progress"></div>
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    <!-- ================= PANTALLA DE PODIUM (MODO HORIZONTAL) ================= -->
    <div class="orientation-prompt need-portrait">
        <div class="phone-icon-anim-landscape">
            <div class="phone-body"></div>
        </div>
        <h2 style="font-weight: 900; letter-spacing: 1px; text-transform: uppercase;">GIRA EL TELÉFONO</h2>
        <p style="color: #aaa; text-align: center; max-width: 80%;">Los resultados se revelarán en modo horizontal.</p>
    </div>

    <div class="podium-master-container font-modern">
        @if (enCountdown)
        {
            <div class="countdown-overlay font-digital">
                <span class="count-number">@countdownNumber</span>
            </div>
        }
        else
        {
            <!-- RESULTADOS Y PODIUM -->
            <div style="display: flex; flex-direction: column; height: 100%; width: 100%;">

                <!-- HEADER DEL PODIUM -->
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; background: rgba(0,0,0,0.5); border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <h2 style="margin: 0; color: #ffeb3b; font-weight: 900; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 2px;">
                        LEADERBOARD
                    </h2>

                    <!-- PESTAÑAS DE CATEGORÍA -->
                    @if (categoriasDisponibles.Count > 1)
                    {
                        <div style="display: flex; gap: 10px;">
                            @foreach (var cat in categoriasDisponibles)
                            {
                                <button class="cat-tab-btn @(categoriaActivaPodium == cat ? "active" : "")" @onclick="() => categoriaActivaPodium = cat">
                                    @(cat == "Rx" ? "🔥 Rx" : cat)
                                </button>
                            }
                        </div>
                    }

                    <button class="btn-exit-podium" @onclick='() => NavManager.NavigateTo("/acciones")'>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        SALIR AL LOBBY
                    </button>
                </div>

                <!-- ESCENARIO DEL PODIUM -->
                <div class="podium-stage">
                    @{
                        var topAtletas = GetAtletasOrdenados(categoriaActivaPodium);
                    }

                    @if (topAtletas.Count > 1)
                    {
                        <!-- PLATA (2do) -->
                        <div class="podium-spot silver-spot fade-in-up" style="animation-delay: 0.4s;">
                            <div class="podium-avatar">
                                @if (!string.IsNullOrEmpty(topAtletas[1].FotoPerfil))
                                {
                                    <img src="@topAtletas[1].FotoPerfil" />
                                }
                                else
                                {

                                    <span>👤</span>
                                }
                            </div>
                            <span class="podium-name">@topAtletas[1].Nombre</span>
                            <span class="podium-score">@GenerarTextoScore(topAtletas[1])</span>
                            <div class="podium-block silver-block">2</div>
                        </div>
                    }

                    @if (topAtletas.Count > 0)
                    {
                        <!-- ORO (1ero) -->
                        <div class="podium-spot gold-spot fade-in-up" style="animation-delay: 0.8s;">
                            <div class="podium-avatar gold-avatar">
                                @if (!string.IsNullOrEmpty(topAtletas[0].FotoPerfil))
                                {
                                    <img src="@topAtletas[0].FotoPerfil" />
                                }
                                else
                                {

                                    <span>👤</span>
                                }
                            </div>
                            <span class="podium-name" style="color: #FFD700; font-size: 1.2rem;">@topAtletas[0].Nombre</span>
                            <span class="podium-score" style="color: #FFD700;">@GenerarTextoScore(topAtletas[0])</span>
                            <div class="podium-block gold-block">1</div>
                        </div>
                    }

                    @if (topAtletas.Count > 2)
                    {
                        <!-- BRONCE (3ero) -->
                        <div class="podium-spot bronze-spot fade-in-up" style="animation-delay: 0.2s;">
                            <div class="podium-avatar">
                                @if (!string.IsNullOrEmpty(topAtletas[2].FotoPerfil))
                                {
                                    <img src="@topAtletas[2].FotoPerfil" />
                                }
                                else
                                {

                                    <span>👤</span>
                                }
                            </div>
                            <span class="podium-name">@topAtletas[2].Nombre</span>
                            <span class="podium-score">@GenerarTextoScore(topAtletas[2])</span>
                            <div class="podium-block bronze-block">3</div>
                        </div>
                    }
                </div>

                <!-- RESTO DE LOS ATLETAS (4to en adelante) -->
                @if (topAtletas.Count > 3)
                {
                    <div class="rest-athletes-scroller fade-in-up" style="animation-delay: 1s;">
                        @for (int i = 3; i < topAtletas.Count; i++)
                        {
                            <div class="rest-card">
                                <span style="font-weight: 900; color: #888; font-size: 1.1rem; width: 25px;">@(i + 1)</span>
                                <div class="avatar-sm" style="width: 35px; height: 35px; margin: 0 10px;">
                                    @if (!string.IsNullOrEmpty(topAtletas[i].FotoPerfil))
                                    {
                                        <img src="@topAtletas[i].FotoPerfil" />
                                    }
                                    else
                                    {
                                        <span>👤</span>
                                    }
                                </div>
                                <span style="color: white; font-weight: 700; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@topAtletas[i].Nombre</span>

                                <!-- AQUI AGREGAMOS EL MARGIN-LEFT -->
                                <span style="color: #33b5e5; font-weight: 900; font-family: 'Orbitron', monospace; margin-left: 15px;">@GenerarTextoScore(topAtletas[i])</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&family=Orbitron:wght@700;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .font-digital {
        font-family: 'Orbitron', monospace;
    }

    /* CONTENEDOR PRINCIPAL */
    .resumen-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #050505;
    }

    .resumen-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        background: rgba(255,255,255,0.03);
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .back-btn {
        background: transparent;
        border: none;
        color: #aaa;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .back-btn:hover {
            color: white;
        }

    /* TABS */
    .tabs-container {
        display: flex;
        gap: 5px;
        padding: 15px 15px;
        background: #0a0a0a;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .tab-btn {
        flex: 1;
        padding: 10px 2px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #888;
        font-weight: 800;
        font-size: 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }

        .tab-btn.active {
            background: #33b5e5;
            color: #000;
            border-color: #33b5e5;
            box-shadow: 0 4px 15px rgba(51,181,229,0.3);
        }

    .config-row-switch {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: #111;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    /* LISTA VERTICAL */
    .atletas-list {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
    }

    .atleta-score-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 14px;
        padding: 15px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .atleta-info-area {
        display: flex;
        align-items: center;
        gap: 15px;
        flex: 1;
        overflow: hidden;
    }

    .avatar-sm {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #222;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(255,255,255,0.1);
    }

        .avatar-sm img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .name-area {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .name-area .name {
            color: white;
            font-weight: 800;
            font-size: 1rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .name-area .surname {
            color: #888;
            font-weight: 600;
            font-size: 0.8rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .cat-select {
        background: transparent;
        color: #33b5e5;
        border: 1px dashed rgba(51,181,229,0.5);
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 800;
        padding: 4px 6px;
        outline: none;
        cursor: pointer;
    }

        .cat-select option {
            background: #111;
            color: white;
        }

    .score-input-area {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .ink-input-score {
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        padding: 10px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 1.1rem;
        text-align: center;
        width: 85px;
        outline: none;
        transition: 0.2s;
    }

        .ink-input-score:focus {
            border-color: #33b5e5;
            background: rgba(51,181,229,0.1);
        }

    .bottom-action-area {
        padding: 20px;
        background: #0a0a0a;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    /* BOTÓN HOLD-TO-PROCESS */
    .hold-to-process-btn {
        position: relative;
        width: 100%;
        padding: 18px;
        background: #222;
        border: 1px solid #444;
        color: #aaa;
        border-radius: 12px;
        font-weight: 900;
        font-size: 1.1rem;
        letter-spacing: 1px;
        cursor: pointer;
        overflow: hidden;
        outline: none;
        transition: 0.2s;
        font-family: 'Montserrat', sans-serif;
    }

        .hold-to-process-btn.holding {
            color: white;
            border-color: #33b5e5;
            transform: scale(0.98);
        }

    .hold-progress {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #0099CC, #33b5e5);
        z-index: 1;
        transition: width 0.1s linear;
    }

    .holding .hold-progress {
        width: 100%;
        transition: width 1.5s linear;
    }

    .bg-blue {
        background: linear-gradient(135deg, #33b5e5, #0099CC);
        border: none;
        color: white;
        border-radius: 12px;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(51,181,229,0.3);
        transition: transform 0.1s;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .bg-blue:active {
            transform: scale(0.98);
        }

    /* BOTON ELEGANTE SALIR LOBBY (PODIUM) */
    .btn-exit-podium {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.9rem;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        width: auto;
        font-family: 'Montserrat', sans-serif;
    }

        .btn-exit-podium:hover {
            background: rgba(255,255,255,0.2);
        }

    /* SWITCH ESTILOS */
    .switch-juez {
        position: relative;
        display: inline-block;
        width: 42px;
        height: 22px;
    }

        .switch-juez input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider-juez {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.1);
        transition: .4s;
        border: 1px solid rgba(255,255,255,0.2);
    }

        .slider-juez:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 2px;
            bottom: 2px;
            background-color: #888;
            transition: .4s;
        }

    input:checked + .slider-juez {
        background-color: rgba(51, 181, 229, 0.2);
        border-color: #33b5e5;
    }

        input:checked + .slider-juez:before {
            transform: translateX(20px);
            background-color: #33b5e5;
        }

    .slider-juez.round {
        border-radius: 34px;
    }

        .slider-juez.round:before {
            border-radius: 50%;
        }

    /* ============================== PODIUM CSS ============================== */
    .podium-master-container {
        background: radial-gradient(circle at center, #1a1a1a 0%, #000 100%);
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .countdown-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.9);
        z-index: 5000;
    }

    .count-number {
        font-size: 15rem;
        color: #ffeb3b;
        text-shadow: 0 0 50px rgba(255,235,59,0.5);
        animation: popIn 1s infinite;
    }

    @@keyframes popIn {
        0% {
            transform: scale(0.5);
            opacity: 0;
        }

        50% {
            transform: scale(1.2);
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 0;
        }
    }

    .podium-stage {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 20px;
        padding-bottom: 20px;
    }

    .podium-spot {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 120px;
    }

    .podium-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        overflow: hidden;
        border: 3px solid white;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
    }

        .podium-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .gold-avatar {
        width: 90px;
        height: 90px;

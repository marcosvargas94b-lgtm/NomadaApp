@code {
    private string gymCode = "NOMADA";
    private bool isLoading = true;
    private bool isProcesando = false;

    private string tabActiva = "Asistencia";
    private bool habilitarCategorias = false;
    private bool capturaManualGlobal = false;

    private int horarioIdOriginal = 0;
    private int wodIdOriginal = 0; // Guardamos el WodId que viene del Timer

    // --- VARIABLES PODIUM ---
    private bool mostrarPodium = false;
    private bool requiereVertical = false;
    private bool enCountdown = false;
    private int countdownNumber = 3;
    private string categoriaActivaPodium = "General";
    private List<string> categoriasDisponibles = new();

    // --- LOGICA HOLD BUTTON ---
    private bool isHolding = false;
    private CancellationTokenSource? holdCts;

    public class AtletaScoreDto
    {
        public Guid UsuarioId { get; set; }
        public string Nombre { get; set; } = "";
        public string ApellidoPaterno { get; set; } = "";
        public string? FotoPerfil { get; set; }
        public string MetodoIngreso { get; set; } = "App";

        public string TiempoFinal { get; set; } = "";
        public int? Rondas { get; set; }
        public int? Reps { get; set; }
        public int? RepsTotales { get; set; }

        public string CategoriaSeleccionada { get; set; } = "General";
    }

    private List<AtletaScoreDto> atletas = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        try { await JSRuntime.InvokeVoidAsync("setOrientation", "portrait"); } catch { }
        await CargarDatosMemoria();
    }

    private async Task CargarDatosMemoria()
    {
        try
        {
            string json = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "ResumenClaseData");
            if (!string.IsNullOrEmpty(json))
            {
                using JsonDocument doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                horarioIdOriginal = root.GetProperty("HorarioId").GetInt32();
                wodIdOriginal = root.GetProperty("WodId").GetInt32(); // <--- LEEMOS EL ID EXACTO

                bool modoJuez = root.GetProperty("ModoJuez").GetBoolean();

                var dictTiempos = new Dictionary<Guid, string>();
                if (root.TryGetProperty("TiemposCapturados", out JsonElement tiemposElement))
                {
                    foreach (JsonProperty prop in tiemposElement.EnumerateObject())
                    {
                        if (Guid.TryParse(prop.Name, out Guid id))
                        {
                            dictTiempos[id] = prop.Value.GetString() ?? "";
                        }
                    }
                }

                if (root.TryGetProperty("Atletas", out JsonElement atletasElement))
                {
                    foreach (JsonElement a in atletasElement.EnumerateArray())
                    {
                        var uId = a.GetProperty("UsuarioId").GetGuid();
                        string tiempo = dictTiempos.ContainsKey(uId) ? dictTiempos[uId] : "";

                        atletas.Add(new AtletaScoreDto
                        {
                            UsuarioId = uId,
                            Nombre = a.GetProperty("Nombre").GetString() ?? "",
                            ApellidoPaterno = a.GetProperty("ApellidoPaterno").GetString() ?? "",
                            FotoPerfil = a.GetProperty("FotoPerfil").GetString(),
                            MetodoIngreso = a.GetProperty("MetodoIngreso").GetString() ?? "App",
                            TiempoFinal = tiempo
                        });
                    }
                }

                if (modoJuez && atletas.Any(a => !string.IsNullOrEmpty(a.TiempoFinal)))
                {
                    tabActiva = "Tiempo";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error leyendo SessionStorage: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void VolverAlTimer()
    {
        NavManager.NavigateTo($"/admin/timer/{horarioIdOriginal}");
    }

    // --- HOLD TO PROCESS LOGIC ---
    private async Task StartHold()
    {
        if (isProcesando) return;
        isHolding = true;
        holdCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(1500, holdCts.Token);
            await ProcesarClaseYMostrarPodium();
        }
        catch (TaskCanceledException) { }
    }

    private void EndHold()
    {
        if (isHolding)
        {
            isHolding = false;
            holdCts?.Cancel();
        }
    }

    private async Task ProcesarClaseSimple()
    {
        await ProcesarDatosBackend();
        NavManager.NavigateTo("/acciones");
    }

    private async Task ProcesarClaseYMostrarPodium()
    {
        isHolding = false;
        bool exito = await ProcesarDatosBackend();

        if (exito)
        {
            mostrarPodium = true;
            try { await JSRuntime.InvokeVoidAsync("setOrientation", "landscape"); } catch { }

            if (habilitarCategorias)
            {
                categoriasDisponibles = atletas.Select(a => a.CategoriaSeleccionada).Distinct().ToList();
                if (categoriasDisponibles.Contains("Rx")) categoriaActivaPodium = "Rx";
                else categoriaActivaPodium = categoriasDisponibles.FirstOrDefault() ?? "General";
            }
            else
            {
                categoriasDisponibles = new List<string> { "General" };
                categoriaActivaPodium = "General";
            }

            enCountdown = true;
            for (int i = 3; i > 0; i--)
            {
                countdownNumber = i;
                StateHasChanged();
                await Task.Delay(1000);
            }
            enCountdown = false;
            StateHasChanged();
        }
    }

    private async Task<bool> ProcesarDatosBackend()
    {
        isProcesando = true;
        StateHasChanged();

        try
        {
            var payload = new
            {
                GymCode = gymCode,
                HorarioId = horarioIdOriginal,
                WodGeneralId = wodIdOriginal, // <--- ENVIAMOS EL ID EXACTO Y SEGURO AL BACKEND
                TipoScoreGlobal = tabActiva,
                CapturaManualGlobal = capturaManualGlobal,
                Scores = atletas.Select(a => new
                {
                    UsuarioId = a.UsuarioId,
                    MetodoIngreso = a.MetodoIngreso,
                    Categoria = habilitarCategorias ? a.CategoriaSeleccionada : "General",
                    TiempoFormato = a.TiempoFinal,
                    Rondas = a.Rondas,
                    Repeticiones = (tabActiva == "Rondas") ? a.Reps : a.RepsTotales
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync($"api/lobby/{gymCode}/procesar-clase", payload);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "ResumenClaseData");
                return true;
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                await App.Current.MainPage.DisplayAlert("Error", $"Hubo un problema: {error}", "OK");
                return false;
            }
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Error de Red", ex.Message, "OK");
            return false;
        }
        finally
        {
            isProcesando = false;
            StateHasChanged();
        }
    }

    // --- LOGICA DE ORDENAMIENTO DE PODIUM ---
    private List<AtletaScoreDto> GetAtletasOrdenados(string categoria)
    {
        var filtrados = atletas.Where(a => a.CategoriaSeleccionada == categoria).ToList();

        if (tabActiva == "Tiempo")
        {
            // Ordenar de menor a mayor (El más rápido gana)
            return filtrados.OrderBy(a => ConvertirASegundos(a.TiempoFinal)).ToList();
        }
        else if (tabActiva == "Rondas")
        {
            // Mayor rondas, luego mayor reps
            return filtrados.OrderByDescending(a => a.Rondas ?? 0).ThenByDescending(a => a.Reps ?? 0).ToList();
        }
        else if (tabActiva == "Reps")
        {
            // Mayor reps totales
            return filtrados.OrderByDescending(a => a.RepsTotales ?? 0).ToList();
        }

        return filtrados;
    }

    private string GenerarTextoScore(AtletaScoreDto a)
    {
        if (tabActiva == "Tiempo") return string.IsNullOrEmpty(a.TiempoFinal) ? "--" : a.TiempoFinal;
        if (tabActiva == "Rondas") return $"{a.Rondas ?? 0}R + {a.Reps ?? 0}";
        if (tabActiva == "Reps") return $"{a.RepsTotales ?? 0} Reps";
        return "";
    }

    private int ConvertirASegundos(string? formato)
    {
        if (string.IsNullOrWhiteSpace(formato)) return 999999; // Si no tiene tiempo, se va al fondo
        var parts = formato.Split(':');
        if (parts.Length == 2 && int.TryParse(parts[0], out int m) && int.TryParse(parts[1], out int s))
            return (m * 60) + s;
        return 999999;
    }
}
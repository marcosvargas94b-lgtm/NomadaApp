@page "/admin/lobby"
@using Nomada.Shared.Models
@using Nomada.Shared.Entities
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= TOP BAR PREMIUM ================= -->
        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 20px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">LOBBY DE CLASE</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #ff4444;"></span></div>
        }
        else
        {
            <!-- ================= SELECTOR DE HORARIO ================= -->
            <div class="fade-in-up">
                <div class="modern-row" style="flex-direction: column; padding: 25px 20px; margin-bottom: 25px; border-left: 4px solid #ff4444; background: var(--card-bg);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <label style="color: var(--text-main); font-size: 0.9rem; font-weight: 900; text-transform: uppercase; margin: 0; letter-spacing: 1px;">Selecciona el Horario a Iniciar</label>
                    </div>

                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <select class="search-input" style="flex: 1; min-width: 200px; margin: 0; font-weight: 800; font-size: 1rem; border-color: rgba(255,68,68,0.3); background: rgba(128,128,128,0.05); color: var(--text-main);" @bind="horarioSeleccionadoId">
                            <option value="0" style="color: black;">Elige un horario...</option>
                            @foreach (var horario in horariosDisponibles)
                            {
                                <option value="@horario.Id" style="color: black;">@horario.HoraTexto</option>
                            }
                        </select>

                        <button class="ink-btn glow-btn" style="margin: 0; flex-shrink: 0; width: auto; padding: 12px 25px; font-size: 0.85rem; background: linear-gradient(135deg, #ff4444, #cc0000); color: white; border: none; box-shadow: 0 4px 15px rgba(255,68,68,0.3);" @onclick="AbrirSesion" disabled="@(horarioSeleccionadoId == 0 || isProcessing)">
                            @if (isProcessing)
                            {
                                <span class="spinner" style="width: 14px; height: 14px; border-top-color: white;"></span>
                            }
                            else
                            {
                                <span>ABRIR CLASE</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            <!-- ================= TABLERO PRINCIPAL (SESIÓN ACTIVA) ================= -->
            @if (sesionActiva != null)
            {
                <div class="fade-in-up" style="animation-delay: 0.1s;">
                    <!-- Banner de Código de Clase -->
                    <div style="background: rgba(0, 200, 81, 0.05); border: 1px dashed rgba(0,200,81,0.3); border-radius: 16px; padding: 25px 20px; text-align: center; margin-bottom: 30px;">
                        <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 900; text-transform: uppercase; display: block; margin-bottom: 8px; letter-spacing: 1px;">CÓDIGO DE ACCESO (Válido Hoy)</span>
                        <h1 class="font-digital" style="color: #00C851; font-size: 3.5rem; font-weight: 900; letter-spacing: 8px; margin: 0; text-shadow: 0 0 20px rgba(0,200,81,0.4);">@sesionActiva.CodigoAcceso</h1>
                    </div>

                    <!-- Header de Atletas en Lobby -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                        <div style="display: flex; align-items: center;">
                            <div style="width: 5px; height: 22px; background: #33b5e5; border-radius: 5px; margin-right: 12px; box-shadow: 0 0 10px rgba(51, 181, 229, 0.5);"></div>
                            <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1.5px; margin: 0;">Atletas Listos (@usuariosLobby.Count)</h3>
                        </div>
                        <button class="icon-btn" style="background: rgba(51,181,229,0.1); color: #33b5e5; border-color: rgba(51,181,229,0.3); padding: 6px 15px; font-size: 0.75rem; font-weight: 900;" @onclick="AbrirModalAgregar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> AGREGAR
                        </button>
                    </div>

                    <!-- CSS GRID DE ATLETAS RESPONSIVE -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; margin-bottom: 30px;">
                        @foreach (var user in usuariosLobby)
                        {
                            <div class="modern-row" style="padding: 12px 15px; margin: 0; display: flex; align-items: center; gap: 15px; background: var(--card-bg); border: 1px solid rgba(128,128,128,0.15);">
                                <!-- Foto Circular con Borde de Color -->
                                <div style="width: 45px; height: 45px; border-radius: 50%; background: rgba(128,128,128,0.1); overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2px solid @(ObtenerColorMetodo(user.MetodoIngreso)); box-shadow: 0 0 8px @(ObtenerFondoMetodo(user.MetodoIngreso));">
                                    @if (!string.IsNullOrEmpty(user.FotoPerfil))
                                    {
                                        <img src="@user.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    }
                                </div>

                                <div style="flex: 1; overflow: hidden;">
                                    <h4 style="color: var(--text-main); margin: 0 0 4px 0; font-size: 0.95rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.Nombre @user.ApellidoPaterno</h4>
                                    <!-- Insignia del Método de Ingreso -->
                                    <span style="background: @(ObtenerFondoMetodo(user.MetodoIngreso)); color: @(ObtenerColorMetodo(user.MetodoIngreso)); padding: 3px 8px; border-radius: 6px; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px;">
                                        @user.MetodoIngreso
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    <button class="ink-btn glow-btn" style="width: 100%; font-size: 1.1rem; padding: 18px; background: linear-gradient(135deg, #ff4444, #cc0000); color: white; border: none; box-shadow: 0 5px 20px rgba(255,68,68,0.4); display: flex; justify-content: center; align-items: center; gap: 10px;" @onclick="IrAlCronometro">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        IR AL TIMER GLOBAL
                    </button>
                </div>
            }
        }
    </div>

    <!-- ================= MODAL BUSCADOR MANUAL ================= -->
    @if (mostrarModal)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(5px); z-index: 2000; display: flex; justify-content: center; align-items: flex-end; padding: 0;">
            <div class="fade-in-up" style="background: var(--card-bg); width: 100%; max-width: 500px; height: 80vh; border-radius: 25px 25px 0 0; display: flex; flex-direction: column; border-top: 1px solid rgba(128,128,128,0.2); box-shadow: 0 -10px 40px rgba(0,0,0,0.5);">

                <div style="padding: 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(128,128,128,0.1); background: rgba(128,128,128,0.05); border-radius: 25px 25px 0 0;">
                    <h3 style="color: var(--text-main); margin: 0; font-weight: 900; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px;">AGREGAR ATLETA</h3>
                    <button style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 5px;" @onclick="CerrarModal">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>

                <div style="padding: 20px; flex: 1; overflow-y: auto;">
                    <!-- Buscador en tiempo real -->
                    <div class="search-wrapper" style="margin-bottom: 20px;">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" @bind="textoBusquedaAtleta" @bind:event="oninput" placeholder="Buscar por nombre..." class="search-input" style="background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); font-weight: 700; color: var(--text-main);" />
                    </div>

                    <!-- Lista de Resultados (Filtrada) -->
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @if (!AtletasBusquedaFiltrados.Any())
                        {
                            <div style="text-align: center; padding: 30px 10px; border: 1px dashed rgba(128,128,128,0.3); border-radius: 12px; background: rgba(128,128,128,0.02);">
                                <p style="color: var(--text-muted); font-size: 0.85rem; font-weight: 700; margin: 0;">No hay resultados o el atleta ya está en la clase.</p>
                            </div>
                        }

                        @foreach (var atleta in AtletasBusquedaFiltrados)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(128,128,128,0.05); border: 1px solid rgba(128,128,128,0.1); padding: 12px 15px; border-radius: 12px; transition: all 0.2s;">
                                <div style="display: flex; align-items: center; gap: 12px; flex: 1; overflow: hidden;">
                                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--text-muted), var(--text-main)); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                                        @if (!string.IsNullOrEmpty(atleta.FotoPerfil))
                                        {
                                            <img src="@atleta.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span style="color: var(--card-bg); font-size: 0.9rem; font-weight: 900;">@atleta.Iniciales</span>
                                        }
                                    </div>
                                    <span style="color: var(--text-main); font-size: 0.95rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@atleta.NombreCompleto</span>
                                </div>

                                <!-- BOTÓN INTERACTIVO -->
                                <button class="ink-btn glow-btn" style="margin: 0; padding: 8px 15px; font-size: 0.75rem; width: auto; background: @(atleta.Agregado ? "#00C851" : "#33b5e5"); border: none; color: white; box-shadow: @(atleta.Agregado ? "none" : "0 2px 8px rgba(51,181,229,0.3)");"
                                        @onclick="() => AgregarAtletaManual(atleta)" disabled="@(atleta.Procesando || atleta.Agregado)">
                                    @if (atleta.Procesando)
                                    {
                                        <span class="spinner" style="width: 14px; height: 14px; border-width: 2px; border-top-color: white;"></span>
                                    }
                                    else if (atleta.Agregado)
                                    {
                                        <div style="display: flex; align-items: center; gap: 5px;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            <span>LISTO</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>AGREGAR</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&family=Orbitron:wght@700;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .font-digital {
        font-family: 'Orbitron', monospace;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private Guid coachId;

    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool isAddingManual = false;

    // Lista de Horarios Reales
    private List<HorarioClase> horariosDisponibles = new();

    // Sesión Actual
    private int horarioSeleccionadoId = 0;
    private SesionLobbyDto? sesionActiva;
    private List<UsuarioLobbyDto> usuariosLobby = new();

    // Modal de Búsqueda Manual
    private bool mostrarModal = false;
    private string textoBusquedaAtleta = "";
    private List<AtletaBusquedaDto> todosLosAtletas = new();

    // Control de Polling (Tiempo Real)
    private bool isPolling = false;

    // Clase DTO Ampliada con variables para la UI
    public class AtletaBusquedaDto
    {
        public Guid Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
        public string Iniciales { get; set; } = string.Empty;
        public string? FotoPerfil { get; set; }
        public bool Procesando { get; set; } = false;
        public bool Agregado { get; set; } = false;
    }

    private IEnumerable<AtletaBusquedaDto> AtletasBusquedaFiltrados => todosLosAtletas
        .Where(a =>
            (string.IsNullOrWhiteSpace(textoBusquedaAtleta) || a.NombreCompleto.Contains(textoBusquedaAtleta, StringComparison.OrdinalIgnoreCase))
            && !usuariosLobby.Any(lobbyUser => lobbyUser.UsuarioId == a.Id)
        );

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        var userIdStr = Preferences.Get("userId", string.Empty);
        if (Guid.TryParse(userIdStr, out Guid parsedId))
        {
            coachId = parsedId;
        }

        await CargarHorariosDelGym();
    }

    private async Task CargarHorariosDelGym()
    {
        try
        {
            horariosDisponibles = await Http.GetFromJsonAsync<List<HorarioClase>>($"api/reservas/{gymCode}/admin/horarios") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task AbrirSesion()
    {
        isProcessing = true;
        try
        {
            var req = new { horarioId = horarioSeleccionadoId, coachId = coachId };
            sesionActiva = await Http.PostAsJsonAsync($"api/lobby/{gymCode}/iniciar-sesion", req)
                                     .Result.Content.ReadFromJsonAsync<SesionLobbyDto>();

            isPolling = true;
            _ = IniciarPollingLobby();
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task IniciarPollingLobby()
    {
        while (isPolling)
        {
            try
            {
                var usuariosRefresh = await Http.GetFromJsonAsync<List<UsuarioLobbyDto>>($"api/lobby/{gymCode}/sesion/{horarioSeleccionadoId}/usuarios");
                if (usuariosRefresh != null)
                {
                    usuariosLobby = usuariosRefresh;
                    StateHasChanged();
                }
            }
            catch { }

            await Task.Delay(3000);
        }
    }

    private async Task AbrirModalAgregar()
    {
        mostrarModal = true;
        textoBusquedaAtleta = "";

        try
        {
            var listaUsuariosAdmin = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado");

            if (listaUsuariosAdmin != null)
            {
                todosLosAtletas = listaUsuariosAdmin.Select(u => new AtletaBusquedaDto
                {
                    Id = u.Id,
                    NombreCompleto = $"{u.Nombre} {u.ApellidoPaterno}",
                    Iniciales = (u.Nombre?.FirstOrDefault().ToString() + u.ApellidoPaterno?.FirstOrDefault().ToString()).ToUpper(),
                    FotoPerfil = null
                }).ToList();
            }
        }
        catch { }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task AgregarAtletaManual(AtletaBusquedaDto atleta)
    {
        atleta.Procesando = true;
        StateHasChanged();

        try
        {
            var req = new { usuarioId = atleta.Id, horarioId = horarioSeleccionadoId };
            var res = await Http.PostAsJsonAsync($"api/lobby/{gymCode}/agregar-manual", req);

            if (res.IsSuccessStatusCode)
            {
                atleta.Agregado = true;
            }
        }
        catch { }
        finally
        {
            atleta.Procesando = false;
            StateHasChanged();
        }
    }

    private void IrAlCronometro()
    {
        if (sesionActiva != null)
        {
            NavManager.NavigateTo($"/admin/timer/{sesionActiva.HorarioId}");
        }
    }

    // Funciones de Diseño UI adaptadas al esquema
    private string ObtenerColorMetodo(string metodo) => metodo switch
    {
        "App" => "#33b5e5",
        "Codigo" => "#00C851",
        "Manual" => "#ffbb33",
        _ => "var(--text-muted)"
    };

    private string ObtenerFondoMetodo(string metodo) => metodo switch
    {
        "App" => "rgba(51,181,229,0.1)",
        "Codigo" => "rgba(0,200,81,0.1)",
        "Manual" => "rgba(255,187,51,0.1)",
        _ => "rgba(128,128,128,0.1)"
    };

    public void Dispose()
    {
        isPolling = false;
    }
}
@page "/inicio"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject NavigationManager NavManager
@inject HttpClient Http

<div class="app-container">
    
    @if (isPageLoading)
    {
        <!-- Loader a pantalla completa para evitar el parpadeo blanco -->
        <div style="height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <span class="spinner" style="width: 60px; height: 60px; border-width: 5px; border-top-color: var(--text-main);"></span>
            <p style="margin-top: 20px; color: var(--text-muted); font-weight: 800; letter-spacing: 2px;">CARGANDO COMUNIDAD...</p>
        </div>
    }
    else
    {
        <div class="feed-content">

            <!-- ================= TOP BAR ================= -->
            <div class="top-bar" style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <h1 class="greeting-title" style="margin: 0; font-size: 1.4rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 10px;">
                    ¡Bienvenido, @nombreUsuario!
                </h1>

                <div style="display: flex; align-items: center; gap: 15px; position: relative;">

                    <!-- NOTIFICACIONES (Campana flotante) -->
                    <div style="position: relative;">
                        <button type="button" class="bell-btn @(hayNotificacionesNuevas ? "wiggle" : "")" @onclick="ToggleNotificaciones" @onclick:stopPropagation="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                            @if (hayNotificacionesNuevas)
                            {
                                <span class="red-dot"></span>
                            }
                        </button>

                        @if (mostrarNotificaciones)
                        {
                            <div class="admin-dropdown glass-dropdown" style="top: 45px; right: -50px; position: absolute; z-index: 2000; min-width: 250px;">
                                <h4 style="color: var(--text-main); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; margin: 0; padding: 15px 20px; border-bottom: 1px solid rgba(128,128,128,0.2);">Tus Avisos</h4>

                                @if (notificaciones.Any())
                                {
                                    @foreach (var noti in notificaciones)
                                    {
                                        <button type="button" class="dropdown-item" style="flex-direction: column; align-items: flex-start; gap: 5px; opacity: @(noti.Leida ? "0.6" : "1"); background: transparent; border: none; width: 100%; text-align: left; cursor: pointer;" @onclick="() => ProcesarClickNotificacion(noti)">
                                            <span style="font-weight: 800; font-size: 0.9rem; display: flex; align-items: flex-start; gap: 8px; line-height: 1.3;">
                                                @if (noti.Tipo == "AlertaPago" || noti.Tipo == "Baja")
                                                {
                                                    <!-- SVG de Advertencia Financiera -->
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffbb33" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                                }
                                                else
                                                {
                                                    <!-- SVG de Like de Comunidad -->
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#ff4444" stroke="#ff4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                                }
                                                @noti.Mensaje
                                            </span>
                                            <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 26px;">@noti.TiempoTranscurrido</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">No tienes avisos nuevos.</div>
                                }
                            </div>
                        }
                    </div>

                    <!-- MENÚ HAMBURGUESA ADMIN -->
                    <div class="admin-menu-container" style="position: relative; flex-shrink: 0;">
                        <button type="button" class="hamburger-btn" @onclick="ToggleMenuAdmin" @onclick:stopPropagation="true">
                            <span class="hamburger-icon">
                                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="10" y1="18" x2="21" y2="18"></line></svg>
                            </span>
                        </button>

                        @if (mostrarMenuAdmin)
                        {
                            <div class="admin-dropdown glass-dropdown" style="top: 45px; right: 0; position: absolute; z-index: 2000;">
                                @if (esSuperAdmin || misPermisos.Contains("Gestionar Usuarios"))
                                {
                                    <a href="/admin/usuarios" class="dropdown-item"><span class="dd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span> Gestión de Usuarios</a>
                                     <a href="/admin/tribu" class="dropdown-item">
                                    <span class="dd-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                                    </span>
                                    Tribu Nómada
                                    </a>
                                }
                                @if (esSuperAdmin)
                                {
                                    <a href="/admin/staff" class="dropdown-item"><span class="dd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span> Staff y Roles</a>
                                }
                                <div class="divider" style="width: 80%; margin: 5px auto; background-color: rgba(128,128,128,0.2);"></div>
                                <button type="button" class="dropdown-item" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; color: #ff4444 !important;" @onclick="CerrarSesion">
                                    <span class="dd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg></span> Cerrar Sesión
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ================= CREADOR O AVISO DE PUBLICADO ================= -->
            <!-- BANNER DE VENCIMIENTO -->
            @if (alertaBanner != null && alertaBanner.Mostrar)
            {
                string borderColor = alertaBanner.NivelRiesgo == "Danger" ? "#ff4444" : "#ffbb33";
                string bgColor = alertaBanner.NivelRiesgo == "Danger" ? "rgba(255, 68, 68, 0.1)" : "rgba(255, 187, 51, 0.1)";

                <div class="modern-row fade-in-up" style="flex-direction: row; align-items: center; justify-content: space-between; padding: 15px 20px; margin-top: 15px; border-left: 4px solid @borderColor; background-color: @bgColor; box-shadow: none;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="@borderColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <div>
                            <span style="color: var(--text-main); font-size: 0.85rem; font-weight: 800; display: block; text-transform: uppercase;">AVISO DE SUSCRIPCIÓN</span>
                            <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 700;">@alertaBanner.Mensaje</span>
                        </div>
                    </div>
                </div>
            }
            @if (!yaPublicoHoy)
            {
                <!-- Creador de Post -->
                <div class="modern-row" style="flex-direction: column; align-items: stretch; padding: 20px; margin-top: 15px;">
                    <textarea @bind="nuevoTexto" placeholder="¿Qué entrenamiento rompiste hoy?..." class="search-input" style="border-radius: 12px; min-height: 80px; margin-bottom: 15px; resize: none; width: 100%; box-sizing: border-box; padding: 15px;"></textarea>

                    @if (mediaSeleccionada != null)
                    {
                        <div class="media-preview">
                            @if (esVideoSeleccionado)
                            {
                                <video src="@mediaSeleccionada" autoplay muted loop playsinline></video>
                            }
                            else
                            {
                                <img src="@mediaSeleccionada" alt="Preview" />
                            }
                            <button class="remove-media" @onclick="RemoverMedia">✖</button>
                        </div>
                    }

                    <div class="post-actions" style="display: flex; justify-content: space-between; align-items: center;">
                        <div class="media-buttons" style="display: flex; gap: 10px;">
                            <!-- Botón Foto (Abre galería) -->
                            <label class="icon-btn" style="cursor: pointer; margin: 0;">
                                <InputFile OnChange="@(e => CargarArchivoLocal(e, false))" accept="image/*" style="display: none;" />
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg> Foto
                            </label>
                            <!-- Botón Video (Abre galería) -->
                            <label class="icon-btn" style="cursor: pointer; margin: 0;">
                                <InputFile OnChange="@(e => CargarArchivoLocal(e, true))" accept="video/*" style="display: none;" />
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg> Video
                            </label>
                        </div>
                        <button class="ink-btn glow-btn" style="width: auto; margin-top: 0; padding: 10px 25px;" disabled="@isPublishing" @onclick="PublicarPost">
                            @if (isPublishing)
                            {
                                <span class="spinner" style="width:14px;height:14px;"></span>
                            }
                            else
                            {
                                <span>PUBLICAR</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Aviso de Post Ya Publicado -->
                <div class="modern-row" style="flex-direction: column; padding: 25px; margin-top: 15px; text-align: center; border-color: #00C851;">
                    <span style="display: flex; justify-content: center; margin-bottom: 15px;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </span>
                    <h3 style="color: var(--text-main); margin-bottom: 5px; font-weight: 800; font-size: 1.1rem;">¡PUBLICADO!</h3>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Ya compartiste tu logro de hoy. Podrás publicar de nuevo mañana.</p>
                    <button class="ink-btn-outline" style="border-color: #ff4444; color: #ff4444; margin: 0 auto; padding: 8px 20px; display: flex; align-items: center; gap: 8px;" @onclick="() => showModalBorrar = true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        BORRAR MI POST
                    </button>
                </div>
            }

            <!-- ================= FEED DE LA COMUNIDAD ================= -->
            <div class="feed-list" style="margin-top: 30px;">
                @if (feed.Any())
                {
                    @foreach (var post in feed)
                    {
                        <div class="modern-row post-card">
                            <div class="post-header">
                                <div class="user-avatar" style="width: 35px; height: 35px; font-size: 0.8rem; margin-right: 10px;">@post.Iniciales</div>
                                <div>
                                    <span class="user-name" style="display:block; font-size: 0.9rem;">@post.NombreAutor</span>
                                    <span style="color: var(--text-muted); font-size: 0.7rem;">@post.TiempoTranscurrido</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.Texto))
                            {
                                <p style="margin: 15px 15px 5px 15px; font-size: 0.95rem;">@post.Texto</p>
                            }

                            @if (!string.IsNullOrEmpty(post.MediaUrl))
                            {
                                <div class="media-container" style="margin-top: 10px;">
                                    @if (post.EsVideo)
                                    {
                                        <video src="@post.MediaUrl" autoplay muted loop playsinline></video>
                                    }
                                    else
                                    {
                                        <img src="@post.MediaUrl" />
                                    }
                                </div>
                            }

                            <div class="post-footer">
                                <button class="like-btn @(post.YoLeDiLike ? "liked" : "")" disabled="@post.YoLeDiLike" @onclick="() => DarLike(post)">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="@(post.YoLeDiLike ? "#ff4444" : "none")" stroke="@(post.YoLeDiLike ? "#ff4444" : "currentColor")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                    <span style="color: @(post.YoLeDiLike ? "#ff4444" : "var(--text-main)")">@post.CantidadLikes Likes</span>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px; opacity: 0.5;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        <p>Aún no hay publicaciones hoy.<br>¡Sé el primero!</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Menú de Navegación Inferior (Siempre visible) -->
    <nav class="bottom-nav">
        <a href="/inicio" class="nav-item active"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><span class="nav-text">Inicio</span></a>
        <a href="/acciones" class="nav-item"><img src="images/logo-nomada.png" alt="Nómada" class="nav-logo" /><span class="nav-text">Box</span></a>
        <a href="/comunidad" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="nav-text">Comunidad</span></a>
        <a href="/perfil" class="nav-item"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="nav-text">Perfil</span></a>
    </nav>
</div>

<!-- MODAL DE ADVERTENCIA: BORRAR POST -->
@if (showModalBorrar)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #ff4444; font-size: 1.1rem;">¿BORRAR PUBLICACIÓN?</h3>
            <p style="text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 25px;">
                Si eliminas tu publicación actual, <strong style="color: var(--text-main);">perderás todos los likes acumulados</strong> en ella. ¿Estás seguro?
            </p>
            <div class="modal-actions">
                <button class="ink-btn-outline" @onclick="() => showModalBorrar = false">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background-color: #ff4444; color: white;" @onclick="BorrarMiPost">SÍ, BORRAR</button>
            </div>
        </div>
    </div>
}

@code {
    private string nombreUsuario = "Atleta";
    private Guid currentUserId;
    private bool esSuperAdmin = false;
    private List<string> misPermisos = new();

    private bool isPageLoading = true;
    private bool isPublishing = false;

    // Listas HTTP
    private List<PostFeedDto> feed = new();
    private List<NotificacionDto> notificaciones = new();

    // Controles UI
    private bool mostrarMenuAdmin = false;
    private bool mostrarNotificaciones = false;
    private bool hayNotificacionesNuevas = false;

    // Post state
    private bool yaPublicoHoy = false;
    private string nuevoTexto = "";
    private string? mediaSeleccionada = null;
    private bool esVideoSeleccionado = false;
    private bool showModalBorrar = false;

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = Preferences.Get("nombreUsuario", "Atleta");
        int rolId = Preferences.Get("rolId", 3);
        esSuperAdmin = (rolId == 1);

        var userIdStr = Preferences.Get("userId", string.Empty);
        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            await CargarDatosIniciales();
        }
    }

    private AlertaSuscripcionDto alertaBanner = new();
    private async Task CargarDatosIniciales()
    {
        isPageLoading = true;
        try
        {
            // 1. VERIFICACIÓN DE EXPULSIÓN AUTOMÁTICA
            var validacion = await Http.GetFromJsonAsync<EstatusResponse>($"api/auth/estatus/{currentUserId}");

            if (validacion != null && (validacion.Estatus == "Baja Temporal" || validacion.Estatus == "Baja" || validacion.Estatus == "Rechazado"))
            {
                Preferences.Clear();

                // Puedes mostrar una alerta nativa del sistema antes de expulsarlo
                await App.Current.MainPage.DisplayAlert(
                    "Servicio Suspendido",
                    "Tu cuenta ha sido suspendida temporalmente por falta de pago. Acércate a recepción para reactivar tu acceso.",
                    "Entendido"
                );

                NavManager.NavigateTo("/");
                return; // Detenemos la carga
            }

            misPermisos = await Http.GetFromJsonAsync<List<string>>($"api/admin/mis-permisos/{currentUserId}") ?? new();
            yaPublicoHoy = await Http.GetFromJsonAsync<bool>($"api/comunidad/ya-publico-hoy/{currentUserId}");
            feed = await Http.GetFromJsonAsync<List<PostFeedDto>>($"api/comunidad/feed/{currentUserId}") ?? new();
            notificaciones = await Http.GetFromJsonAsync<List<NotificacionDto>>($"api/comunidad/notificaciones/{currentUserId}") ?? new();

            hayNotificacionesNuevas = notificaciones.Any(n => !n.Leida);
            alertaBanner = await Http.GetFromJsonAsync<AlertaSuscripcionDto>($"api/box/alerta-suscripcion/{currentUserId}") ?? new();
        }
        catch (Exception) { /* Ignorar errores de red temporales */ }
        finally { isPageLoading = false; }
    }
    public class EstatusResponse { public string Estatus { get; set; } = ""; }

    private void ToggleMenuAdmin() { mostrarMenuAdmin = !mostrarMenuAdmin; mostrarNotificaciones = false; }
    private void ToggleNotificaciones() { mostrarNotificaciones = !mostrarNotificaciones; mostrarMenuAdmin = false; hayNotificacionesNuevas = false; }

    private async Task CargarArchivoLocal(InputFileChangeEventArgs e, bool esVideo)
    {
        var file = e.File;
        if (file == null) return;

        esVideoSeleccionado = esVideo;
        // Permitimos un máximo de 15MB para el archivo (Configurable)
        long maxAllowedSize = 15 * 1024 * 1024;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            var mimeType = esVideo ? "video/mp4" : "image/jpeg"; // Aproximación

            mediaSeleccionada = $"data:{mimeType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el archivo: {ex.Message}");
        }
    }

    private void RemoverMedia() { mediaSeleccionada = null; esVideoSeleccionado = false; }

    private async Task PublicarPost()
    {
        if (string.IsNullOrWhiteSpace(nuevoTexto) && mediaSeleccionada == null) return;

        isPublishing = true;
        try
        {
            var req = new CrearPostRequest
            {
                UsuarioId = currentUserId,
                Texto = nuevoTexto,
                EsVideo = esVideoSeleccionado,
                MediaBase64 = mediaSeleccionada
            };

            var res = await Http.PostAsJsonAsync("api/comunidad/publicar", req);
            if (res.IsSuccessStatusCode)
            {
                yaPublicoHoy = true;
                nuevoTexto = "";
                RemoverMedia();
                await CargarDatosIniciales(); // Recargar feed
            }
        }
        finally { isPublishing = false; }
    }

    private async Task DarLike(PostFeedDto post)
    {
        if (post.YoLeDiLike) return; // Si ya dio like, salir

        post.YoLeDiLike = true;
        post.CantidadLikes++; // Optimistic UI update

        try { await Http.PostAsync($"api/comunidad/like/{post.Id}/{currentUserId}", null); }
        catch { post.YoLeDiLike = false; post.CantidadLikes--; } // Revertir si falla
    }

    private async Task BorrarMiPost()
    {
        showModalBorrar = false;
        var miPost = feed.FirstOrDefault(p => p.EsMio);
        if (miPost != null)
        {
            try
            {
                await Http.DeleteAsync($"api/comunidad/borrar/{miPost.Id}");
                yaPublicoHoy = false;
                await CargarDatosIniciales();
            }
            catch (Exception) { }
        }
    }


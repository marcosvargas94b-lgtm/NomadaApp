@page "/admin/avisos"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= TOP BAR ================= -->
        <div style="display: flex; align-items: center; margin-bottom: 20px;">
            <a href="/acciones" style="color: var(--text-main); margin-right: 15px; display: flex; align-items: center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
            <h2 class="greeting-title" style="margin: 0; font-size: 1.4rem; text-transform: uppercase;">Gestor de Avisos</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else
        {
            <!-- ================= FORMULARIO PARA NUEVO AVISO ================= -->
            <div class="modern-row fade-in-up" style="flex-direction: column; padding: 25px 20px; margin-bottom: 30px; border-top: 4px solid #ffbb33;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                    <!-- SVG Campana de Alerta -->
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffbb33" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase;">Escribir en el Pizarrón</h3>
                </div>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Título del Aviso</label>
                    <input type="text" @bind="nuevoTitulo" placeholder="Ej. ¡Horario Festivo!" class="search-input" style="font-size: 1.05rem; font-weight: 800; border-color: rgba(255,187,51,0.3);" maxlength="50" />
                </div>

                <div class="input-group modern-input" style="margin-bottom: 15px;">
                    <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Mensaje</label>
                    <textarea @bind="nuevoMensaje" placeholder="Escribe el mensaje para la tribu..." class="search-input" style="min-height: 120px; resize: none; font-size: 0.95rem; line-height: 1.5; font-weight: 600; border-color: rgba(255,187,51,0.3);"></textarea>
                </div>

                <div class="input-group modern-input" style="margin-bottom: 25px;">
                    <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Tiempo de Vida en Pizarrón</label>
                    <select class="search-input" style="font-size: 0.95rem; font-weight: 700; border-color: rgba(255,187,51,0.3);" @bind="diasVigencia">
                        <option value="1">1 Día (Solo hoy)</option>
                        <option value="3">3 Días</option>
                        <option value="7">1 Semana</option>
                        <option value="15">15 Días</option>
                        <option value="30">1 Mes</option>
                    </select>
                </div>

                <button class="ink-btn glow-btn" style="background: linear-gradient(135deg, #ffbb33, #ff8800); color: #111; font-weight: 900;" @onclick="CrearAviso" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner" style="border-top-color: #111;"></span>
                    }
                    else
                    {
                        <span>PUBLICAR AVISO</span>
                    }
                </button>

                @if (mostrarErrorFormulario)
                {
                    <span style="color: #ff4444; font-size: 0.8rem; font-weight: 700; text-align: center; display: block; margin-top: 15px;">Por favor, llena el título y el mensaje.</span>
                }
            </div>

            <!-- ================= HISTORIAL DE AVISOS ================= -->
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; padding: 0 5px;">
                <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 800; text-transform: uppercase;">Avisos Registrados</span>
                <span style="background: rgba(128,128,128,0.1); color: var(--text-muted); padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 800;">
                    @historialAvisos.Count Total
                </span>
            </div>

            @if (historialAvisos.Any())
            {
                <div class="user-list">
                    @foreach (var aviso in historialAvisos)
                    {
                        bool estaVencido = aviso.FechaVencimiento < DateTime.UtcNow;

                        <div class="modern-row" style="flex-direction: column; padding: 0; margin-bottom: 15px; border: 1px solid @(estaVencido ? "rgba(128,128,128,0.2)" : "rgba(255,187,51,0.3)"); opacity: @(estaVencido ? "0.6" : "1"); transition: opacity 0.3s;">

                            <!-- Cabecera del Aviso Histórico -->
                            <div style="background-color: @(estaVencido ? "rgba(128,128,128,0.05)" : "rgba(255,187,51,0.05)"); padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                                <h4 style="color: var(--text-main); margin: 0; font-size: 1rem; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@aviso.Titulo</h4>

                                @if (estaVencido)
                                {
                                    <span style="color: var(--text-muted); font-size: 0.7rem; font-weight: 800; background: rgba(128,128,128,0.1); padding: 3px 8px; border-radius: 8px; text-transform: uppercase;">Vencido</span>
                                }
                                else
                                {
                                    <span style="color: #ffbb33; font-size: 0.7rem; font-weight: 800; background: rgba(255,187,51,0.1); padding: 3px 8px; border-radius: 8px; text-transform: uppercase;">Visible</span>
                                }
                            </div>

                            <!-- Cuerpo y Controles -->
                            <div style="padding: 15px; display: flex; justify-content: space-between; align-items: center;">
                                <div style="flex: 1; padding-right: 15px;">
                                    <span style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-bottom: 8px; line-height: 1.4; max-height: 2.8em; overflow: hidden; text-overflow: ellipsis;">@aviso.Mensaje</span>
                                    <span style="color: var(--text-muted); font-size: 0.7rem; font-weight: 700;">Coach: @aviso.NombreCoach | Vence: @aviso.FechaVencimiento.ToLocalTime().ToString("dd MMM yyyy")</span>
                                </div>

                                <button style="background: rgba(255,68,68,0.1); border: none; color: #ff4444; padding: 10px; border-radius: 8px; cursor: pointer; flex-shrink: 0;" @onclick="() => EliminarAviso(aviso.Id)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 40px 20px; border: 1px dashed rgba(128,128,128,0.3); border-radius: 16px;">
                    <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin: 0;">No hay avisos registrados en el historial.</p>
                </div>
            }
        }
    </div>
</div>

@code {
    private string gymCode = "NOMADA"; // <--- VARIABLE DINÁMICA
    private Guid currentUserId;

    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool mostrarErrorFormulario = false;

    // Formulario
    private string nuevoTitulo = "";
    private string nuevoMensaje = "";
    private int diasVigencia = 3;

    // Historial
    private List<AvisoBoxDto> historialAvisos = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA"); // <--- CARGAMOS DE MEMORIA

        var userIdStr = Preferences.Get("userId", string.Empty);
        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            await CargarHistorial();
        }
    }

    private async Task CargarHistorial()
    {
        isPageLoading = true;
        try
        {
            // INYECTAMOS EL GYMCODE EN LA CONSULTA
            historialAvisos = await Http.GetFromJsonAsync<List<AvisoBoxDto>>($"api/avisos/{gymCode}/historial") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task CrearAviso()
    {
        mostrarErrorFormulario = false;

        if (string.IsNullOrWhiteSpace(nuevoTitulo) || string.IsNullOrWhiteSpace(nuevoMensaje))
        {
            mostrarErrorFormulario = true;
            return;
        }

        isProcessing = true;

        try
        {
            var request = new CrearAvisoRequest
            {
                GymCode = gymCode, // <--- GUARDAMOS EL AVISO EN ESTA SUCURSAL
                CoachId = currentUserId,
                Titulo = nuevoTitulo,
                Mensaje = nuevoMensaje,
                DiasVigencia = diasVigencia
            };

            var res = await Http.PostAsJsonAsync("api/avisos", request);

            if (res.IsSuccessStatusCode)
            {
                // Limpiamos formulario
                nuevoTitulo = "";
                nuevoMensaje = "";
                diasVigencia = 3;

                // Refrescamos lista
                await CargarHistorial();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task EliminarAviso(int id)
    {
        isPageLoading = true;
        try
        {
            await Http.DeleteAsync($"api/avisos/{id}");
            await CargarHistorial();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isPageLoading = false;
        }
    }
}
@page "/admin/avisos"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 20px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">GESTOR DE AVISOS</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #ffbb33;"></span></div>
        }
        else
        {
            <!-- ================= FORMULARIO PARA NUEVO AVISO ================= -->
            <div class="fade-in-up">
                <div class="modern-row" style="flex-direction: column; padding: 25px 20px; margin-bottom: 35px; border-top: 4px solid #ffbb33; background: var(--card-bg);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffbb33" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <h3 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; text-transform: uppercase;">Escribir un Aviso</h3>
                    </div>

                    <div class="input-group modern-input" style="margin-bottom: 20px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Título del Aviso</label>
                        <input type="text" @bind="nuevoTitulo" placeholder="Ej. ¡Horario Festivo!" class="search-input" style="font-size: 1rem; font-weight: 800; border-color: rgba(255,187,51,0.3); background: rgba(128,128,128,0.05);" maxlength="50" />
                    </div>

                    <div class="input-group modern-input" style="margin-bottom: 20px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Mensaje</label>
                        <textarea @bind="nuevoMensaje" placeholder="Escribe el mensaje para la tribu..." class="search-input" style="min-height: 120px; resize: none; font-size: 0.95rem; line-height: 1.5; font-weight: 600; border-color: rgba(255,187,51,0.3); background: rgba(128,128,128,0.05);"></textarea>
                    </div>

                    <div class="input-group modern-input" style="margin-bottom: 25px;">
                        <label style="color: var(--text-muted); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Tiempo de Vida en Pizarrón</label>
                        <select class="search-input" style="font-size: 0.95rem; font-weight: 700; border-color: rgba(255,187,51,0.3); background: rgba(128,128,128,0.05); appearance: none;" @bind="diasVigencia">
                            <option value="1">1 Día (Solo hoy)</option>
                            <option value="3">3 Días</option>
                            <option value="7">1 Semana</option>
                            <option value="15">15 Días</option>
                            <option value="30">1 Mes</option>
                        </select>
                    </div>

                    <button class="ink-btn glow-btn" style="background: linear-gradient(135deg, #ffbb33, #ff8800); color: black; font-weight: 900; border: none; box-shadow: 0 4px 15px rgba(255,187,51,0.3);" @onclick="CrearAviso" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner" style="border-top-color: black;"></span>
                        }
                        else
                        {
                            <span>PUBLICAR AVISO</span>
                        }
                    </button>

                    @if (mostrarErrorFormulario)
                    {
                        <span class="fade-in-up" style="color: #ff4444; font-size: 0.85rem; font-weight: 800; text-align: center; display: flex; align-items: center; justify-content: center; gap: 5px; margin-top: 15px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            Por favor, llena el título y el mensaje.
                        </span>
                    }
                </div>
            </div>

            <!-- ================= HISTORIAL DE AVISOS ================= -->
            <div class="fade-in-up" style="animation-delay: 0.1s;">
                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 22px; background: #ffbb33; border-radius: 5px; margin-right: 12px; box-shadow: 0 0 10px rgba(255, 187, 51, 0.5);"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; text-transform: uppercase; font-weight: 900; letter-spacing: 1.5px; margin: 0; flex: 1;">Avisos Registrados</h3>
                    <span style="background: rgba(255, 187, 51, 0.15); color: #ffbb33; padding: 4px 12px; border-radius: 12px; font-size: 0.8rem; font-weight: 900; border: 1px solid rgba(255,187,51,0.3);">
                        @historialAvisos.Count Total
                    </span>
                </div>

                @if (historialAvisos.Any())
                {
                    <div class="user-list">
                        @foreach (var aviso in historialAvisos)
                        {
                            bool estaVencido = aviso.FechaVencimiento < DateTime.UtcNow;

                            <div class="modern-row" style="flex-direction: column; padding: 0; margin-bottom: 15px; border: 1px solid @(estaVencido ? "rgba(128,128,128,0.2)" : "rgba(255,187,51,0.4)"); background: var(--card-bg); opacity: @(estaVencido ? "0.65" : "1"); transition: all 0.3s; box-shadow: @(estaVencido ? "none" : "0 4px 15px rgba(255,187,51,0.1)");">

                                <!-- Cabecera del Aviso Histórico -->
                                <div style="background-color: @(estaVencido ? "rgba(128,128,128,0.05)" : "rgba(255,187,51,0.05)"); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                                    <h4 style="color: var(--text-main); margin: 0; font-size: 1.1rem; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@aviso.Titulo</h4>

                                    @if (estaVencido)
                                    {
                                        <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; background: rgba(128,128,128,0.1); padding: 4px 10px; border-radius: 8px; text-transform: uppercase;">Vencido</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ffbb33; font-size: 0.75rem; font-weight: 800; background: rgba(255,187,51,0.15); padding: 4px 10px; border-radius: 8px; text-transform: uppercase;">Visible</span>
                                    }
                                </div>

                                <!-- Cuerpo y Controles -->
                                <div style="padding: 20px; display: flex; justify-content: space-between; align-items: center;">
                                    <div style="flex: 1; padding-right: 15px;">
                                        <span style="color: var(--text-muted); font-size: 0.85rem; display: block; margin-bottom: 10px; line-height: 1.5; max-height: 2.8em; overflow: hidden; text-overflow: ellipsis; font-weight: 600;">@aviso.Mensaje</span>
                                        <div style="display: flex; gap: 15px;">
                                            <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700;">Coach: <strong style="color: var(--text-main);">@aviso.NombreCoach</strong></span>
                                            <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700;">Vence: <strong style="color: var(--text-main);">@aviso.FechaVencimiento.ToLocalTime().ToString("dd MMM yyyy")</strong></span>
                                        </div>
                                    </div>

                                    <button class="icon-btn" style="background: rgba(255,68,68,0.05); border-color: rgba(255,68,68,0.3); color: #ff4444; padding: 10px; flex-shrink: 0;" @onclick="() => EliminarAviso(aviso.Id)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 40px 20px; border: 1px dashed rgba(128,128,128,0.3); border-radius: 16px; background: rgba(128,128,128,0.05);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                        <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin: 0;">No hay avisos registrados en el historial.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private Guid currentUserId;

    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool mostrarErrorFormulario = false;

    // Formulario
    private string nuevoTitulo = "";
    private string nuevoMensaje = "";
    private int diasVigencia = 3;

    // Historial
    private List<AvisoBoxDto> historialAvisos = new();

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");

        var userIdStr = Preferences.Get("userId", string.Empty);
        if (Guid.TryParse(userIdStr, out currentUserId))
        {
            await CargarHistorial();
        }
    }

    private async Task CargarHistorial()
    {
        isPageLoading = true;
        try
        {
            historialAvisos = await Http.GetFromJsonAsync<List<AvisoBoxDto>>($"api/avisos/{gymCode}/historial") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task CrearAviso()
    {
        mostrarErrorFormulario = false;

        if (string.IsNullOrWhiteSpace(nuevoTitulo) || string.IsNullOrWhiteSpace(nuevoMensaje))
        {
            mostrarErrorFormulario = true;
            return;
        }

        isProcessing = true;

        try
        {
            var request = new CrearAvisoRequest
            {
                GymCode = gymCode,
                CoachId = currentUserId,
                Titulo = nuevoTitulo,
                Mensaje = nuevoMensaje,
                DiasVigencia = diasVigencia
            };

            var res = await Http.PostAsJsonAsync("api/avisos", request);

            if (res.IsSuccessStatusCode)
            {
                nuevoTitulo = "";
                nuevoMensaje = "";
                diasVigencia = 3;

                await CargarHistorial();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task EliminarAviso(int id)
    {
        isPageLoading = true;
        try
        {
            await Http.DeleteAsync($"api/avisos/{id}");
            await CargarHistorial();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isPageLoading = false;
        }
    }
}
@page "/mis-pagos"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@inject HttpClient Http

<div class="app-container">
    <div class="feed-content" style="padding-top: 10px;">

        <!-- TOP BAR -->
        <div style="display: flex; align-items: center; margin-bottom: 25px;">
            <a href="/acciones" style="color: var(--text-main); margin-right: 15px; display: flex; align-items: center; transition: opacity 0.2s;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
            <h2 class="greeting-title" style="margin: 0; font-size: 1.4rem;">MIS RECIBOS</h2>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner"></span></div>
        }
        else
        {
            <!-- PESTAÑAS (TABS) -->
            <div class="segmented-control" style="margin-bottom: 25px;">
                <div class="segment @(tabActual == "Suscripciones" ? "active" : "")" @onclick="@(() => tabActual = "Suscripciones")">MEMBRESÍAS</div>
                <div class="segment @(tabActual == "Clases" ? "active" : "")" @onclick="@(() => tabActual = "Clases")">CLASES</div>
            </div>

            <!-- LISTA DE TICKETS -->
            <div class="user-list">
                @if (TicketsFiltrados.Any())
                {
                    @foreach (var ticket in TicketsFiltrados)
                    {
                        <!-- Tarjeta estilo Ticket de Compra -->
                        <div class="modern-row" style="flex-direction: column; padding: 0; margin-bottom: 15px; border: 1px solid rgba(128,128,128,0.2); overflow: hidden;">

                            <!-- Encabezado del ticket -->
                            <div style="background-color: rgba(128,128,128,0.05); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed rgba(128,128,128,0.3); gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                    <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Folio #@ticket.Id.ToString("D5")</span>
                                </div>
                                <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; flex-shrink: 0;">@ticket.FechaCobro.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                            </div>

                            <!-- Cuerpo del ticket -->
                            <div style="padding: 20px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5px; gap: 15px;">
                                    <h3 style="color: var(--text-main); margin: 0; font-size: 1.1rem; font-weight: 900; flex: 1; word-wrap: break-word; line-height: 1.2;">@FormatearTipoCobro(ticket.TipoCobro)</h3>
                                    <h3 style="color: #00C851; margin: 0; font-size: 1.2rem; font-weight: 900; flex-shrink: 0;">$@ticket.Monto.ToString("N2")</h3>
                                </div>

                                @if (!string.IsNullOrEmpty(ticket.Descripcion))
                                {
                                    <span style="color: var(--text-muted); font-size: 0.85rem; display: block; margin-bottom: 15px;">@ticket.Descripcion</span>
                                }
                                else
                                {
                                    <div style="height: 15px;"></div>
                                }

                                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px;">
                                    <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; background: rgba(51, 181, 229, 0.1); color: #33b5e5; padding: 4px 10px; border-radius: 12px;">
                                        Atendió: @ticket.Coach
                                    </span>

                                    <div style="display: flex; align-items: center; gap: 5px;">
                                        <span style="color: #00C851; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Pagado</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 50px 20px;">
                        <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; color: var(--text-muted); opacity: 0.5;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin-bottom: 5px;">Sin recibos en esta categoría.</p>
                        <span style="color: var(--text-muted); font-size: 0.8rem; opacity: 0.7;">Tus próximos pagos aparecerán aquí.</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string gymCode = "NOMADA"; // <--- VARIABLE PARA LA SUCURSAL

    private bool isPageLoading = true;
    private string tabActual = "Suscripciones";
    private List<IngresoDto> misPagos = new();

    private IEnumerable<IngresoDto> TicketsFiltrados => misPagos
        .Where(t => tabActual == "Suscripciones"
                    ? (t.TipoCobro == "Mensual" || t.TipoCobro == "Semanal")
                    : (t.TipoCobro == "PaqueteClases" || t.TipoCobro == "Especial"));

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA"); // <--- CARGAMOS SUCURSAL
        var userIdStr = Preferences.Get("userId", string.Empty);

        if (!string.IsNullOrEmpty(userIdStr))
        {
            try
            {
                // INYECTAMOS EL GYMCODE EN LA CONSULTA
                misPagos = await Http.GetFromJsonAsync<List<IngresoDto>>($"api/finanzas/{gymCode}/mis-pagos/{userIdStr}") ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error al cargar historial: " + ex.Message);
            }
            finally
            {
                isPageLoading = false;
            }
        }
    }

    private string FormatearTipoCobro(string tipo)
    {
        return tipo switch
        {
            "Mensual" => "Membresía Mensual",
            "Semanal" => "Membresía Semanal",
            "PaqueteClases" => "Clase(s) / Drop-in",
            "Especial" => "Clase o Evento Especial",
            _ => tipo
        };
    }
}
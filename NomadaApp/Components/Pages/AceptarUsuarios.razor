@page "/admin/usuarios"
@using Nomada.Shared.Models
@using System.Net.Http.Json
@using Microsoft.Maui.Storage
@inject HttpClient Http
@inject NavigationManager NavManager
<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 20px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.5rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">SOLICITUDES</h2>
        </div>

        @if (isPageLoading)
        {
            <!-- Loader a pantalla completa -->
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh;">
                <span class="spinner" style="width: 50px; height: 50px; border-width: 4px; border-top-color: #33b5e5; margin: 0 0 20px 0;"></span>
                <p style="color: var(--text-muted); font-weight: 800; letter-spacing: 2px;">CARGANDO LISTAS...</p>
            </div>
        }
        else
        {
            <!-- ================= SECCIÓN 1: USUARIOS EN ESPERA ================= -->
            <div class="admin-section fade-in-up" style="margin-bottom: 40px;">

                <!-- Subtítulo Moderno con Glow -->
                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 22px; background: #33b5e5; border-radius: 5px; margin-right: 12px; box-shadow: 0 0 10px rgba(51, 181, 229, 0.5);"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; text-transform: uppercase; font-weight: 900; letter-spacing: 1.5px; margin: 0;">EN ESPERA</h3>
                </div>

                @if (usuariosEnEspera.Any())
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding: 0 5px;">
                        <label style="color: var(--text-main); font-size: 0.85rem; display: flex; align-items: center; font-weight: 800; cursor: pointer; text-transform: uppercase;">
                            <input type="checkbox" @bind="SeleccionarTodos" style="margin-right: 10px; width: 18px; height: 18px; accent-color: #33b5e5;" />
                            Seleccionar Todos
                        </label>
                        <button class="ink-btn glow-btn" style="width: auto; padding: 8px 15px; font-size: 0.75rem; margin: 0; background: #33b5e5; color: white; border: none;"
                                disabled="@(!HaySeleccionados || isMassLoading)" @onclick="AceptarMasivo">
                            @if (isMassLoading)
                            {
                                <span class="spinner" style="width: 14px; height: 14px; border-width: 2px; border-top-color: white;"></span>
                            }
                            else
                            {
                                <span>ACEPTAR MASIVO</span>
                            }
                        </button>
                    </div>

                    <div class="user-list">
                        @foreach (var user in usuariosEnEspera)
                        {
                            <!-- Tarjeta Premium -->
                            <div class="modern-row" style="padding: 12px 15px; border-left: 3px solid #33b5e5;">
                                <input type="checkbox" @bind="user.Seleccionado" style="margin-right: 15px; width: 20px; height: 20px; accent-color: #33b5e5;" />

                                <div class="user-avatar" style="width: 40px; height: 40px; font-size: 1rem; margin-right: 12px; background: linear-gradient(135deg, #33b5e5, #0099CC); color: white;">
                                    @ObtenerIniciales(user.Nombre, user.ApellidoPaterno)
                                </div>

                                <div class="user-info">
                                    <span class="user-name" style="font-size: 0.95rem; font-weight: 800;">@user.Nombre @user.ApellidoPaterno</span>
                                    <span class="user-email" style="font-size: 0.75rem; color: var(--text-muted);">@user.Correo</span>
                                </div>

                                <div class="user-actions" style="display: flex; gap: 8px;">
                                    <button type="button" class="icon-btn" style="color: #00C851; border-color: rgba(0,200,81,0.3); background: rgba(0,200,81,0.05); padding: 8px;" disabled="@user.IsLoading" @onclick="() => ProcesarUsuario(user, true)">
                                        @if (user.IsLoading)
                                        {
                                            <span class="spinner" style="width:16px;height:16px; border-top-color: #00C851; margin: 0;"></span>
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        }
                                    </button>
                                    <button type="button" class="icon-btn" style="color: #ff4444; border-color: rgba(255,68,68,0.3); background: rgba(255,68,68,0.05); padding: 8px;" disabled="@user.IsLoading" @onclick="() => ProcesarUsuario(user, false)">
                                        @if (user.IsLoading)
                                        {
                                            <span class="spinner" style="width:16px;height:16px; border-top-color: #ff4444; margin: 0;"></span>
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 30px 0; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00C851" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.8;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 10px; font-weight: 700;">No hay solicitudes pendientes.</p>
                    </div>
                }
            </div>

            <!-- ================= SECCIÓN 2: USUARIOS RECHAZADOS ================= -->
            <div class="admin-section fade-in-up" style="animation-delay: 0.1s;">

                <!-- Subtítulo Moderno con Glow Rojo -->
                <div style="display: flex; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed rgba(128,128,128,0.2);">
                    <div style="width: 5px; height: 22px; background: #ff4444; border-radius: 5px; margin-right: 12px; box-shadow: 0 0 10px rgba(255, 68, 68, 0.5);"></div>
                    <h3 style="color: var(--text-main); font-size: 1.1rem; text-transform: uppercase; font-weight: 900; letter-spacing: 1.5px; margin: 0;">RECHAZADOS</h3>
                </div>

                @if (usuariosRechazados.Any())
                {
                    <div class="user-list">
                        @foreach (var user in usuariosRechazados)
                        {
                            <div class="modern-row" style="padding: 12px 15px; opacity: 0.85; border-left: 3px solid var(--text-muted);">
                                <div class="user-avatar" style="width: 40px; height: 40px; font-size: 1rem; margin-right: 12px; background: rgba(128,128,128,0.2); color: var(--text-muted);">
                                    @ObtenerIniciales(user.Nombre, user.ApellidoPaterno)
                                </div>

                                <div class="user-info">
                                    <span class="user-name" style="text-decoration: line-through; color: var(--text-muted); font-size: 0.95rem; font-weight: 800;">@user.Nombre @user.ApellidoPaterno</span>
                                    <span class="user-email" style="font-size: 0.75rem; color: var(--text-muted);">@user.Correo</span>
                                </div>

                                <div class="user-actions" style="display: flex; gap: 8px;">
                                    <button type="button" class="icon-btn" style="color: #33b5e5; border-color: rgba(51,181,229,0.3); background: rgba(51,181,229,0.05); padding: 8px;" disabled="@user.IsLoading" @onclick="() => ConfirmarRestauracion(user)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><polyline points="3 3 3 8 8 8"></polyline></svg>
                                    </button>
                                    <button type="button" class="icon-btn" style="color: var(--text-muted); border-color: rgba(128,128,128,0.3); background: rgba(128,128,128,0.05); padding: 8px;" disabled="@user.IsLoading" @onclick="() => EliminarDefinitivo(user)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 30px 0; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.6;"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 10px; font-weight: 700;">No hay usuarios rechazados.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal de Confirmación -->
@if (usuarioARestaurar != null)
{
    <div class="modal-overlay glass-overlay">
        <div class="login-card modal-content premium-modal">
            <h3 class="modal-title" style="color: #33b5e5; font-size: 1.2rem; text-shadow: 0 0 10px rgba(51,181,229,0.3);">¿RESTAURAR ATLETA?</h3>
            <p class="modal-subtitle" style="margin-bottom: 25px; color: var(--text-muted);">
                ¿Deseas ingresar a <strong style="color: var(--text-main);">@usuarioARestaurar.Nombre.ToUpper()</strong> como usuario aprobado de la app?
            </p>
            <div class="modal-actions" style="margin-top: 20px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" @onclick="CancelarRestauracion">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #33b5e5; color: white; border: none;" @onclick="EjecutarRestauracion">
                    @if (isModalLoading)
                    {
                        <span class="spinner" style="border-top-color: white;"></span>
                    }
                    else
                    {
                        <span>APROBAR</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string gymCode = "NOMADA";
    private List<UsuarioAdminDto> usuariosEnEspera = new();
    private List<UsuarioAdminDto> usuariosRechazados = new();
    private bool isMassLoading = false;
    private bool isModalLoading = false;
    private bool isPageLoading = true;
    private UsuarioAdminDto usuarioARestaurar = null;

    private bool SeleccionarTodos
    {
        get => usuariosEnEspera.Any() && usuariosEnEspera.All(u => u.Seleccionado);
        set { usuariosEnEspera.ForEach(u => u.Seleccionado = value); }
    }

    private bool HaySeleccionados => usuariosEnEspera.Any(u => u.Seleccionado);

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarListas();
    }

    private async Task CargarListas()
    {
        isPageLoading = true;
        try
        {
            usuariosEnEspera = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/En%20Espera") ?? new();
            usuariosRechazados = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Rechazado") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar usuarios: " + ex.Message);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task ProcesarUsuario(UsuarioAdminDto user, bool aceptar)
    {
        user.IsLoading = true;
        string nuevoEstatus = aceptar ? "Aprobado" : "Rechazado";

        var request = new ActualizarEstatusRequest
        {
            UsuarioIds = new List<Guid> { user.Id },
            NuevoEstatus = nuevoEstatus
        };

        var response = await Http.PutAsJsonAsync("api/admin/usuarios/estatus", request);

        if (response.IsSuccessStatusCode)
        {
            usuariosEnEspera.Remove(user);
            if (!aceptar) usuariosRechazados.Add(user);
        }
        user.IsLoading = false;
    }

    private async Task AceptarMasivo()
    {
        isMassLoading = true;
        var seleccionados = usuariosEnEspera.Where(u => u.Seleccionado).ToList();
        var ids = seleccionados.Select(u => u.Id).ToList();

        var request = new ActualizarEstatusRequest
        {
            UsuarioIds = ids,
            NuevoEstatus = "Aprobado"
        };

        var response = await Http.PutAsJsonAsync("api/admin/usuarios/estatus", request);

        if (response.IsSuccessStatusCode)
        {
            usuariosEnEspera.RemoveAll(u => u.Seleccionado);
        }
        isMassLoading = false;
    }

    private void ConfirmarRestauracion(UsuarioAdminDto user)
    {
        usuarioARestaurar = user;
    }

    private void CancelarRestauracion()
    {
        usuarioARestaurar = null;
    }

    private async Task EjecutarRestauracion()
    {
        isModalLoading = true;

        var request = new ActualizarEstatusRequest
        {
            UsuarioIds = new List<Guid> { usuarioARestaurar.Id },
            NuevoEstatus = "Aprobado"
        };

        var response = await Http.PutAsJsonAsync("api/admin/usuarios/estatus", request);

        if (response.IsSuccessStatusCode)
        {
            usuariosRechazados.Remove(usuarioARestaurar);
        }

        isModalLoading = false;
        usuarioARestaurar = null;
    }

    private async Task EliminarDefinitivo(UsuarioAdminDto user)
    {
        user.IsLoading = true;
        var response = await Http.DeleteAsync($"api/admin/usuarios/{user.Id}");

        if (response.IsSuccessStatusCode)
        {
            usuariosRechazados.Remove(user);
        }
        user.IsLoading = false;
    }

    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini;
    }
}
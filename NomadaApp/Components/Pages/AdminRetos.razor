@code {
    private string gymCode = "NOMADA";
    private bool isPageLoading = true;
    private bool isProcessing = false;
    private bool isModalLoading = false;
    private string tabActual = "Catalogo";

    // CATÁLOGO DE RETOS
    private List<RetoCatalogoDto> catalogoRetos = new();
    private bool mostrarModalCrearReto = false;
    private RetoCatalogo nuevoReto = new();

    // ASIGNACIÓN (ATLETAS)
    private string textoBusquedaAtleta = "";
    private List<UsuarioAdminDto> atletas = new();
    private IEnumerable<UsuarioAdminDto> AtletasFiltrados => atletas
        .Where(a => string.IsNullOrWhiteSpace(textoBusquedaAtleta) || (a.Nombre + " " + a.ApellidoPaterno).Contains(textoBusquedaAtleta, StringComparison.OrdinalIgnoreCase));

    // MODAL DEL ATLETA
    private bool mostrarModalAtleta = false;
    private UsuarioAdminDto? atletaActivo;
    private List<RetoCatalogoDto> albumAtleta = new();
    private int idRetoSeleccionado = 0;
    private string mensajeErrorAsignacion = "";

    protected override async Task OnInitializedAsync()
    {
        gymCode = Preferences.Get("gymCode", "NOMADA");
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        isPageLoading = true;
        try
        {
            catalogoRetos = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/catalogo") ?? new();
            atletas = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>($"api/admin/{gymCode}/usuarios/Aprobado") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isPageLoading = false; }
    }

    // ================= CATÁLOGO =================
    private void AbrirModalCrearReto()
    {
        nuevoReto = new RetoCatalogo { GymCode = gymCode, UrlImagen = "default-medalla.png" };
        mostrarModalCrearReto = true;
    }

    private async Task GuardarRetoCatalogo()
    {
        if (string.IsNullOrWhiteSpace(nuevoReto.Titulo)) return;

        isProcessing = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/retos/catalogo", nuevoReto);
            if (res.IsSuccessStatusCode)
            {
                mostrarModalCrearReto = false;
                catalogoRetos = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/catalogo") ?? new();
            }
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task EliminarRetoCatalogo(int id)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/retos/catalogo/{id}");
            if (res.IsSuccessStatusCode)
            {
                catalogoRetos = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/catalogo") ?? new();
            }
        }
        catch { }
    }

    // ================= ASIGNACIÓN (ATLETA) =================
    private async Task AbrirModalAtleta(UsuarioAdminDto atleta)
    {
        atletaActivo = atleta;
        mostrarModalAtleta = true;
        isModalLoading = true;
        mensajeErrorAsignacion = "";
        idRetoSeleccionado = 0;

        try
        {
            albumAtleta = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/album/{atleta.Id}") ?? new();
        }
        catch { }
        finally { isModalLoading = false; }
    }

    private void CerrarModalAtleta()
    {
        mostrarModalAtleta = false;
        atletaActivo = null;
    }

    private async Task AsignarMedalla(Guid atletaId, int retoId)
    {
        isProcessing = true;
        mensajeErrorAsignacion = "";
        try
        {
            var req = new AsignarRetoRequest { GymCode = gymCode, AtletaId = atletaId, RetoCatalogoId = retoId };
            var res = await Http.PostAsJsonAsync("api/retos/asignar", req);

            if (res.IsSuccessStatusCode)
            {
                idRetoSeleccionado = 0;
                albumAtleta = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/album/{atletaId}") ?? new();
            }
            else
            {
                mensajeErrorAsignacion = await res.Content.ReadAsStringAsync();
            }
        }
        catch { }
        finally { isProcessing = false; }
    }

    private async Task RemoverMedalla(Guid atletaId, int retoId)
    {
        try
        {
            var res = await Http.DeleteAsync($"api/retos/remover/{atletaId}/{retoId}");
            if (res.IsSuccessStatusCode)
            {
                albumAtleta = await Http.GetFromJsonAsync<List<RetoCatalogoDto>>($"api/retos/{gymCode}/album/{atletaId}") ?? new();
            }
        }
        catch { }
    }
    private void AbrirModalAsignarA(RetoCatalogoDto reto)
    {
        // Cambiamos a la pestaña de atletas para asignar la medalla
        tabActual = "Atletas";
        idRetoSeleccionado = reto.Id;
    }

    // Helper
    private string ObtenerIniciales(string n, string a)
    {
        var ini = "";
        if (!string.IsNullOrWhiteSpace(n)) ini += n.Substring(0, 1).ToUpper();
        if (!string.IsNullOrWhiteSpace(a)) ini += a.Substring(0, 1).ToUpper();
        return ini == "" ? "N" : ini;
    }

    // DTOs Auxiliares temporales para Binding
    public class RetoCatalogo { public int Id { get; set; } public string GymCode { get; set; } = ""; public string Titulo { get; set; } = ""; public string Descripcion { get; set; } = ""; public string UrlImagen { get; set; } = ""; public bool EsPremioMaximo { get; set; } }
}
@page "/admin/retos"
@using Nomada.Shared.Models
@using Microsoft.Maui.Storage
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="app-container font-modern">
    <div class="feed-content" style="padding-top: 10px; padding-bottom: 80px;">

        <!-- ================= HEADER PREMIUM ================= -->
        <div class="resumen-header" style="display: flex; justify-content: center; align-items: center; padding: 20px 0; margin-bottom: 25px; position: relative;">
            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/acciones")' style="position: absolute; left: 20px; background: none; border: none; color: var(--text-main); cursor: pointer; padding: 0;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <h2 class="greeting-title adaptive-shadow" style="margin: 0; font-size: 1.4rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-main);">LOGROS Y RETOS</h2>
        </div>

        <!-- ================= PESTAÑAS (TABS) ================= -->
        <div class="segmented-control fade-in-up" style="margin-bottom: 25px; background: rgba(128,128,128,0.1);">
            <div class="segment @(tabActual == "Catalogo" ? "active" : "")" style="@(tabActual == "Catalogo" ? "background: #ff4444; color: white; box-shadow: 0 4px 15px rgba(255,68,68,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabActual = "Catalogo")">CATÁLOGO</div>
            <div class="segment @(tabActual == "Atletas" ? "active" : "")" style="@(tabActual == "Atletas" ? "background: #ff4444; color: white; box-shadow: 0 4px 15px rgba(255,68,68,0.3); border: none;" : "color: var(--text-muted);")" @onclick="@(() => tabActual = "Atletas")">ASIGNACIÓN</div>
        </div>

        @if (isPageLoading)
        {
            <div style="display: flex; justify-content: center; padding: 50px;"><span class="spinner" style="width: 40px; height: 40px; border-width: 4px; border-top-color: #ff4444;"></span></div>
        }
        else
        {
            <!-- ============================================== -->
            <!-- TABS CONTENT: CATÁLOGO DE MEDALLAS             -->
            <!-- ============================================== -->
            @if (tabActual == "Catalogo")
            {
                <div class="fade-in-up">
                    <button class="ink-btn-outline" style="border-style: dashed; border-color: #ff4444; color: #ff4444; width: 100%; margin-bottom: 25px; font-weight: 900;" @onclick="AbrirModalCrearReto">
                        + CREAR NUEVA MEDALLA
                    </button>

                    @if (catalogoRetos.Any())
                    {
                        <div style="display: grid; grid-template-columns: 1fr; gap: 15px;">
                            @foreach (var reto in catalogoRetos)
                            {
                                <div class="modern-row" style="display: flex; flex-direction: column; padding: 0; background: var(--card-bg); border-left: 4px solid @(reto.EsAutomatico ? "#33b5e5" : "#ff4444"); overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">

                                    <div style="display: flex; align-items: center; padding: 15px 20px;">
                                        <!-- Imagen de la medalla -->
                                        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(128,128,128,0.1); border: 2px solid @(reto.EsPremioMaximo ? "#FFD700" : "rgba(128,128,128,0.2)"); display: flex; align-items: center; justify-content: center; margin-right: 15px; overflow: hidden; box-shadow: @(reto.EsPremioMaximo ? "0 0 15px rgba(255,215,0,0.5)" : "none");">
                                            @if (!string.IsNullOrEmpty(reto.UrlImagen))
                                            {
                                                <!-- En el futuro, cambia esto por img src="@reto.UrlImagen" cuando tengas las de Azure -->
                                                <span style="font-size: 1.5rem;">🏅</span>
                                            }
                                            else
                                            {
                                                <span style="font-size: 1.5rem;">🏅</span>
                                            }
                                        </div>

                                        <div style="flex: 1; overflow: hidden;">
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <h4 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@reto.Titulo</h4>
                                                @if (reto.EsPremioMaximo)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFD700" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 5px rgba(255,215,0,0.8));"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                                }
                                            </div>
                                            <span style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; display: block; margin-top: 4px; line-height: 1.4;">@reto.Descripcion</span>
                                        </div>
                                    </div>

                                    <div style="background: rgba(128,128,128,0.05); padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed rgba(128,128,128,0.2);">
                                        <div>
                                            @if (reto.EsAutomatico)
                                            {
                                                <span style="background: rgba(51,181,229,0.1); color: #33b5e5; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 900; border: 1px solid rgba(51,181,229,0.2); display: flex; align-items: center; gap: 4px;">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> SISTEMA
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="background: rgba(255,68,68,0.1); color: #ff4444; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 900; border: 1px solid rgba(255,68,68,0.2); display: flex; align-items: center; gap: 4px;">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path></svg> MANUAL
                                                </span>
                                            }
                                        </div>

                                        <div style="display: flex; gap: 10px;">
                                            @if (!reto.EsAutomatico)
                                            {
                                                <button class="ink-btn glow-btn" style="background: #ff4444; color: white; padding: 6px 15px; font-size: 0.75rem; border: none; box-shadow: 0 2px 10px rgba(255,68,68,0.3); margin: 0;" @onclick="() => AbrirModalAsignarA(reto)">
                                                    OTORGAR
                                                </button>
                                                <button class="icon-btn" style="background: rgba(128,128,128,0.1); border: none; color: var(--text-muted); padding: 8px;" @onclick="() => EliminarRetoCatalogo(reto.Id)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="color: var(--text-muted); font-size: 0.7rem; font-weight: 700; font-style: italic;">No editable</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 20px; background: rgba(128,128,128,0.05); border-radius: 16px; border: 1px dashed rgba(128,128,128,0.2);">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.6;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 16 16 12 12 8"></polyline><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                            <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 700; margin: 0;">No hay medallas registradas.</p>
                        </div>
                    }
                </div>
            }

            <!-- ============================================== -->
            <!-- TABS CONTENT: ASIGNACIÓN A ATLETAS             -->
            <!-- ============================================== -->
            @if (tabActual == "Atletas")
            {
                <div class="fade-in-up">
                    <div class="search-wrapper" style="margin-bottom: 25px;">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" @bind="textoBusquedaAtleta" @bind:event="oninput" placeholder="Buscar atleta por nombre..." class="search-input" style="background: var(--card-bg); font-weight: 700; border-color: rgba(128,128,128,0.2);" />
                    </div>

                    @if (AtletasFiltrados.Any())
                    {
                        <div class="user-list">
                            @foreach (var atleta in AtletasFiltrados)
                            {
                                <div class="modern-row" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; margin-bottom: 12px; background: var(--card-bg); cursor: pointer; transition: transform 0.2s;" @onclick="() => AbrirModalAtleta(atleta)">
                                    <div class="user-avatar" style="width: 45px; height: 45px; font-size: 1.1rem; margin-right: 15px; background: linear-gradient(135deg, var(--text-muted), var(--text-main)); color: var(--card-bg); font-weight: 900;">
                                        @if (!string.IsNullOrEmpty(atleta.FotoPerfil))
                                        {
                                            <img src="@atleta.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {

                                            <span>@ObtenerIniciales(atleta.Nombre, atleta.ApellidoPaterno)</span>
                                        }
                                    </div>
                                    <div class="user-info" style="flex: 1; overflow: hidden;">
                                        <span class="user-name" style="font-size: 1.05rem; font-weight: 800; color: var(--text-main);">@atleta.Nombre @atleta.ApellidoPaterno</span>
                                        <span class="user-email" style="font-size: 0.8rem; color: #ff4444; font-weight: 800; text-transform: uppercase;">Asignar Medalla</span>
                                    </div>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px 0;">
                            <p style="color: var(--text-muted); font-size: 1rem; font-weight: 700;">No se encontraron atletas.</p>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- ================= MODAL: CREAR NUEVA MEDALLA (CATÁLOGO) ================= -->
@if (mostrarModalCrearReto)
{
    <div class="modal-overlay glass-overlay" style="z-index: 2000;">
        <div class="fade-in-up login-card modal-content premium-modal" style="width: 100%; max-width: 500px; background: var(--card-bg);">
            <h3 class="modal-title" style="color: #ff4444; font-size: 1.2rem; text-shadow: 0 0 10px rgba(255,68,68,0.3); margin-bottom: 25px;">NUEVA MEDALLA</h3>

            <div class="input-group modern-input" style="margin-bottom: 15px;">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nombre de la Insignia</label>
                <input type="text" @bind="nuevoReto.Titulo" placeholder="Ej. Atleta del Mes" class="search-input" style="font-weight: 900; font-size: 1.1rem; background: rgba(128,128,128,0.05); border-color: #ff4444; color: var(--text-main);" />
            </div>

            <div class="input-group modern-input" style="margin-bottom: 15px;">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Descripción del Logro</label>
                <textarea @bind="nuevoReto.Descripcion" placeholder="Ej. Otorgada por disciplina, esfuerzo y compromiso constante." class="search-input" rows="3" style="font-weight: 600; font-size: 0.9rem; background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); color: var(--text-main); resize: none;"></textarea>
            </div>

            <!-- Por ahora usamos input texto para el nombre de la imagen que crees en Bing/Dalle -->
            <div class="input-group modern-input" style="margin-bottom: 20px;">
                <label style="color: var(--text-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: block;">Nombre Archivo de Imagen</label>
                <input type="text" @bind="nuevoReto.UrlImagen" placeholder="Ej. medalla-atleta-mes.png" class="search-input" style="font-weight: 700; background: rgba(128,128,128,0.05); border-color: rgba(128,128,128,0.2); color: var(--text-main);" />
            </div>

            <div class="modern-row" style="padding: 15px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.3);">
                <div style="flex: 1; padding-right: 15px;">
                    <h4 style="color: #FFD700; font-size: 1rem; font-weight: 900; margin: 0 0 5px 0;">¿Es Premio Máximo?</h4>
                    <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 600; line-height: 1.4; display: block;">Aparecerá en grande hasta arriba del álbum del atleta.</span>
                </div>
                <label class="switch gold-switch">
                    <input type="checkbox" @bind="nuevoReto.EsPremioMaximo">
                    <span class="slider round"></span>
                </label>
            </div>

            <div class="modal-actions" style="margin-top: 25px;">
                <button class="ink-btn-outline" style="color: var(--text-main); border-color: var(--text-muted);" disabled="@isProcessing" @onclick="() => mostrarModalCrearReto = false">CANCELAR</button>
                <button class="ink-btn glow-btn" style="background: #ff4444; color: white; border: none;" disabled="@isProcessing" @onclick="GuardarRetoCatalogo">
                    @if (isProcessing)
                    {
                        <span class="spinner" style="border-top-color: white;"></span>
                    }
                    else
                    {

                        <span>CREAR MEDALLA</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: ASIGNAR MEDALLA AL ATLETA ================= -->
@if (mostrarModalAtleta && atletaActivo != null)
{
    <div class="modal-overlay glass-overlay" style="z-index: 2000;">
        <div class="fade-in-up login-card modal-content premium-modal" style="width: 100%; max-width: 600px; height: 90vh; border-radius: 25px 25px 0 0; padding: 0; display: flex; flex-direction: column; background: var(--card-bg);">

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px dashed rgba(128,128,128,0.2); background: rgba(128,128,128,0.05); border-radius: 25px 25px 0 0;">
                <div style="flex: 1; overflow: hidden; padding-right: 15px;">
                    <h3 style="color: var(--text-main); font-size: 1.2rem; font-weight: 900; margin: 0 0 5px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@atletaActivo.Nombre @atletaActivo.ApellidoPaterno</h3>
                    <span style="color: #ff4444; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">ÁLBUM DE LOGROS</span>
                </div>
                <button style="background: rgba(128,128,128,0.1); border: none; color: var(--text-muted); padding: 8px; border-radius: 50%; cursor: pointer;" @onclick="CerrarModalAtleta">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <div style="flex: 1; overflow-y: auto; padding: 20px;">
                @if (isModalLoading)
                {
                    <div style="display: flex; justify-content: center; padding: 40px;"><span class="spinner" style="border-top-color: #ff4444;"></span></div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(mensajeErrorAsignacion))
                    {
                        <div style="background: rgba(255,68,68,0.1); border: 1px solid rgba(255,68,68,0.3); color: #ff4444; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 0.85rem; font-weight: 800; text-align: center;">
                            @mensajeErrorAsignacion
                        </div>
                    }

                    <div style="background: rgba(128,128,128,0.05); padding: 20px; border-radius: 12px; border: 1px solid rgba(128,128,128,0.1); margin-bottom: 25px;">
                        <h4 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin-top: 0; margin-bottom: 15px; text-transform: uppercase;">Otorgar Nueva Medalla</h4>
                        <div style="display: flex; gap: 10px;">
                            <select @bind="idRetoSeleccionado" class="search-input" style="flex: 1; font-weight: 800; background: var(--card-bg); border-color: rgba(128,128,128,0.2); color: var(--text-main); appearance: none; margin: 0;">
                                <option value="0" style="color: black;">Seleccione medalla manual...</option>
                                @foreach (var reto in catalogoRetos.Where(r => !r.EsAutomatico))
                                {
                                    <option value="@reto.Id" style="color: black;">@reto.Titulo</option>
                                }
                            </select>
                            <button class="ink-btn glow-btn" style="margin: 0; background: #ff4444; color: white; border: none; padding: 0 20px; width: auto;" @onclick="() => AsignarMedalla(atletaActivo.Id, idRetoSeleccionado)" disabled="@(idRetoSeleccionado == 0 || isProcessing)">
                                @if (isProcessing)
                                {
                                    <span class="spinner" style="width: 14px; height: 14px;"></span>
                                }
                                else
                                {

                                    <span>ASIGNAR</span>
                                }
                            </button>
                        </div>
                    </div>

                    <h4 style="color: var(--text-main); font-size: 1.1rem; font-weight: 900; margin-top: 0; margin-bottom: 15px; text-transform: uppercase;">Medallas Obtenidas</h4>

                    @if (albumAtleta.Any(a => a.Desbloqueado))
                    {
                        <div style="display: grid; grid-template-columns: 1fr; gap: 15px;">
                            @foreach (var logro in albumAtleta.Where(a => a.Desbloqueado))
                            {
                                <div class="modern-row" style="display: flex; align-items: center; padding: 15px; background: rgba(0, 200, 81, 0.05); border-left: 4px solid #00C851;">
                                    <div style="width: 50px; height: 50px; border-radius: 50%; background: rgba(0, 200, 81, 0.1); border: 2px solid #00C851; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                        <span style="font-size: 1.3rem;">🏅</span>
                                    </div>
                                    <div style="flex: 1; overflow: hidden;">
                                        <h4 style="color: var(--text-main); font-size: 1rem; font-weight: 900; margin: 0 0 3px 0;">@logro.Titulo</h4>
                                        <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700;">Desbloqueado: @logro.FechaDesbloqueo?.ToString("dd MMM yyyy")</span>
                                    </div>
                                    @if (!logro.EsAutomatico)
                                    {
                                        <!-- Solo podemos quitar medallas manuales -->
                                        <button class="icon-btn" style="color: #ff4444; border: none; background: transparent; padding: 5px; opacity: 0.7;" @onclick="() => RemoverMedalla(atletaActivo.Id, logro.Id)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 30px 20px;">
                            <p style="color: var(--text-muted); font-size: 0.9rem; font-weight: 700; margin: 0;">No ha desbloqueado ninguna medalla.</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

    .font-modern {
        font-family: 'Montserrat', sans-serif;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }

    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .adaptive-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.15);
    }

    @@media (prefers-color-scheme: dark) {
        .adaptive-shadow {
            text-shadow: 2px 2px 15px rgba(255,255,255,0.2);
        }
    }

    .tab-btn {
        flex: 1;
        padding: 12px 10px;
        background: rgba(128,128,128,0.05);
        border: 1px solid rgba(128,128,128,0.1);
        color: var(--text-muted);
        font-weight: 900;
        font-size: 0.85rem;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        letter-spacing: 1px;
    }

        .tab-btn.active {
            background: #33b5e5;
            color: white;
            border-color: #33b5e5;
            box-shadow: 0 4px 15px rgba(51,181,229,0.3);
        }

    /* Switch estilo iOS */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(128,128,128,0.2);
        transition: .3s;
        border: 1px solid rgba(128,128,128,0.1);
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 2px;
            bottom: 2px;
            background-color: var(--text-muted);
            transition: .3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

    input:checked + .slider {
        background-color: rgba(255,68,68,0.2);
        border-color: rgba(255,68,68,0.5);
    }

        input:checked + .slider:before {
            transform: translateX(22px);
            background-color: #ff4444;
            box-shadow: 0 0 8px rgba(255,68,68,0.6);
        }

    /* Switch Gold para Premio Máximo */
    .gold-switch input:checked + .slider {
        background-color: rgba(255,215,0,0.2);
